@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

fn fib(n: i64) -> i64 {
    if (n < 2) {
        return n;
    };
    return (fib((n - 1)) + fib((n - 2)));
}

fn main() -> i32 {
    let sum = 0;
    let i = 0;
    while (i < 2000000) {
        sum = (sum + i);
        i = (i + 1);
    }
    println("{}", fib(28));
    println("{}", sum);
    return 0;
}

