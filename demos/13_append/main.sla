@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

fn main() -> i32 {
    let s = Vec::new();
    let __t1 = 0;
    while __t1 < 0 {
        s.push(0);
        __t1 = __t1 + 1;
    }
    s.push(10);
    s.push(20);
    println("{}", len(s));
    println("{}", (s[0] + s[1]));
    let i = 0;
    while (i < len(s)) {
        println("{}", s[i]);
        i = i + 1;
    }
    s.push((s[0] + s[1]));
    println("{}", s[2]);
    println("{}", len(s));
    return 0;
}

