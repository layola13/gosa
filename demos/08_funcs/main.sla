@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

fn add(a: i64, b: i64) -> i64 {
    return (a + b);
}

fn printTwice(x: i64) -> void {
    println("{}", x);
    println("{}", (x + 1));
}

fn main() -> i32 {
    let y = add(40, 2);
    println("{}", y);
    println("{}", add(1, 2));
    printTwice(7);
    return 0;
}

