@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

fn main() -> i32 {
    let x = 7;
    if (x > 5) {
        println("{}", 1);
    } else {
        println("{}", 0);
    };
    if (x < 5) {
        println("{}", 1);
    } else {
        println("{}", 0);
    };
    if (x == 7) {
        println("{}", x);
    } else {
        println("{}", (-1));
    };
    if (x != 7) {
        println("{}", 0);
    } else
    if (x >= 7) {
        println("{}", 2);
    } else {
        println("{}", 3);
    };
    return 0;
}

