// ---------- Encoder (stream.go) ----------

// Go's NewEncoder: escapeHTML on, no indent, writing
// into a caller-held builder (the io.Writer model
// at this surface; the actual writer binding is
// frontend work -- seam (b)).
fn go_encoding_json_encoder_new(out: &GosBuilder) -> GoJsonEncoder {
    return GoJsonEncoder {
        out: GosBuilder { buf: out.buf },
        err: go_errors_nil(),
        escape_html: true,
        indent_prefix: Vec::new(),
        indent_value: Vec::new(),
    };
}

// Go's Encoder.SetIndent.
fn go_encoding_json_encoder_set_indent(enc: &GoJsonEncoder, prefix: Vec<u8>, indent: Vec<u8>) -> void {
    enc.indent_prefix = prefix;
    enc.indent_value = indent;
    return;
}

// Go's Encoder.SetEscapeHTML.
fn go_encoding_json_encoder_set_escape_html(enc: &GoJsonEncoder, on: bool) -> void {
    enc.escape_html = on;
    return;
}

// Go's Encoder.Encode, shared tail: terminate the
// value with a newline, indent if set, write to the
// builder. The marshal error (only an invalid
// Number literal can fail here -- unsupported types
// panic 77425) is returned; a builder write cannot
// fail, so enc.err stays nil.
fn __go_json_encoder_write(enc: &GoJsonEncoder, b: Vec<u8>) -> ptr {
    if enc.err != go_errors_nil() {
        return enc.err;
    };
    let out = Vec::new();
    __go_json_append(out, b);
    out.push(10u8);
    if len(enc.indent_prefix) > 0 {
        let ind = Vec::new();
        let err = go_encoding_json_append_indent(ind, out, enc.indent_prefix, enc.indent_value);
        if err != go_errors_nil() {
            return err;
        };
        out = ind;
    } else {
        if len(enc.indent_value) > 0 {
            let ind = Vec::new();
            let err = go_encoding_json_append_indent(ind, out, enc.indent_prefix, enc.indent_value);
            if err != go_errors_nil() {
                return err;
            };
            out = ind;
        };
    };
    let _n = go_strings_builder_write_string(&enc.out, out);
    return go_errors_nil();
}

fn go_encoding_json_encoder_encode_string(enc: &GoJsonEncoder, v: Vec<u8>) -> ptr {
    let b = Vec::new();
    go_encoding_json_marshal_string_value(b, v, enc.escape_html, false);
    return __go_json_encoder_write(enc, b);
}

fn go_encoding_json_encoder_encode_int(enc: &GoJsonEncoder, v: i64) -> ptr {
    let b = Vec::new();
    go_encoding_json_marshal_int_value(b, v, false);
