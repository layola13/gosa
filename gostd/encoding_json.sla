// ---------- loud refusals ----------

// Marshal of an unsupported type (seams (c)/(d)):
// any / interface{} / float / chan / func / complex
// / generic reflection-style encode. The frontend
// refuses these at the call site; this is the loud
// backstop, never a silent null.
fn go_encoding_json_refuse_marshal() -> void {
    panic(77425);
}

// Unmarshal into an unsupported target (seam (c)/(d)):
// any / interface{} / float targets.
fn go_encoding_json_refuse_unmarshal() -> void {
    panic(77426);
}
