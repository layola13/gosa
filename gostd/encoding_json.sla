// checkValid ran -- so the span is the value itself).
// The value is a copy of the input slice.
fn go_encoding_json_unmarshal_raw_message(data: Vec<u8>) -> GoJsonBytesResult {
    let cv = go_encoding_json_check_valid(data);
    if !cv.ok {
        return GoJsonBytesResult { v: Vec::new(), err: cv.err, err_offset: cv.offset, set: false, is_nil: false };
