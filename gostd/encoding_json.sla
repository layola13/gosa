// ---------- error constructors ----------

// Go's SyntaxError as a GosError: message + target id
// 900036. The Offset rides in the caller's result
// struct (see the header sentinel note).
fn go_encoding_json_syntax_error(msg: Vec<u8>, offset: i64) -> ptr {
    let _off = offset;
    return go_errors_new_with_id(msg, GO_JSON_SYNTAX_ERROR_ID);
}

fn go_encoding_json_type_error(msg: Vec<u8>, offset: i64) -> ptr {
    let _off = offset;
    return go_errors_new_with_id(msg, GO_JSON_TYPE_ERROR_ID);
}

// scanner.go quoteChar: '\'' -> `'\''`, '"' -> `'"'`,
// otherwise strconv.Quote of the byte, outer quotes
// stripped, wrapped in single quotes.
fn __go_json_quote_char(c: u8) -> Vec<u8> {
    if c == 39u8 {
        let out = Vec::new();
        out.push(39u8); out.push(92u8); out.push(39u8); out.push(39u8);
        return out;
    };
    if c == 34u8 {
        let out = Vec::new();
        out.push(39u8); out.push(34u8); out.push(39u8);
        return out;
    };
    let one = Vec::new();
    one.push(c);
    let q = go_strconv_quote(one);
    let inner = __go_json_slice(q, 1, len(q) - 1);
    let out = Vec::new();
    out.push(39u8);
    __go_json_append(out, inner);
    out.push(39u8);
    return out;
}

// The scanner's error message: "invalid character " +
// quoteChar(c) + " " + context (Go's scanner.error;
// the trailing space stays when the context is empty).
fn __go_json_scan_error_msg(c: u8, ctx: i64) -> Vec<u8> {
    let m = Vec::new();
    __go_json_msg_invalid_character(m);
    let qc = __go_json_quote_char(c);
    __go_json_append(m, qc);
    m.push(32u8);
    __go_json_append_scan_context(m, ctx);
    return m;
}

// The Token error message: "invalid character " +
// quoteChar(c) + context, where the context carries
// its own leading space (stream.go tokenError).
fn __go_json_token_error_msg(c: u8, ctx: i64) -> Vec<u8> {
    let m = Vec::new();
    __go_json_msg_invalid_character(m);
    let qc = __go_json_quote_char(c);
    __go_json_append(m, qc);
    __go_json_append_scan_context(m, ctx);
    return m;
}

// A SyntaxError for a plain message (Token's expected
// comma / colon / not-at-value errors, eof errors).
fn __go_json_syntax_error_msg(msg: Vec<u8>, offset: i64) -> ptr {
    return go_encoding_json_syntax_error(msg, offset);
}

// ---------- scanner ----------

// Go's scanner.newScanner (bytes zeroed; the pool is
// seam (e) -- no pools in SLA, a fresh value instead).
fn go_encoding_json_scanner_new() -> GoJsonScanner {
    return GoJsonScanner {
        step: GO_JSON_STATE_BEGIN_VALUE,
        end_top: false,
        parse_state: Vec::new(),
        depth: 0,
        err: go_errors_nil(),
        bytes: 0,
    };
}

// Go's scanner.reset. bytes is deliberately NOT reset
// (Go's reset does not touch it either).
fn go_encoding_json_scanner_reset(s: &GoJsonScanner) -> void {
    s.step = GO_JSON_STATE_BEGIN_VALUE;
    s.depth = 0;
    s.err = go_errors_nil();
    s.end_top = false;
    return;
}

// Go's scanner.error: record the SyntaxError (offset
// s.bytes) and move to the error state.
fn __go_json_scan_error(s: &GoJsonScanner, c: u8, ctx: i64) -> i64 {
    s.step = GO_JSON_STATE_ERROR;
    let m = __go_json_scan_error_msg(c, ctx);
    s.err = go_encoding_json_syntax_error(m, s.bytes);
    return GO_JSON_SCAN_ERROR;
}

// Go's scanner.pushParseState. The stack has logical
// length s.depth (no Vec truncate in SLA): push
// overwrites a stale slot past depth or appends.
fn __go_json_scan_push_parse_state(s: &GoJsonScanner, c: u8, new_state: i64, success: i64) -> i64 {
    if s.depth < len(s.parse_state) {
        s.parse_state[s.depth] = new_state;
    } else {
        s.parse_state.push(new_state);
    };
    s.depth = s.depth + 1;
    if s.depth <= GO_JSON_MAX_NESTING_DEPTH {
        return success;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_MAX_DEPTH);
}

// Go's scanner.popParseState. Popping only moves
// depth back; stale entries past depth are ignored.
fn __go_json_scan_pop_parse_state(s: &GoJsonScanner) -> void {
    s.depth = s.depth - 1;
    if s.depth == 0 {
        s.step = GO_JSON_STATE_END_TOP;
        s.end_top = true;
    } else {
        s.step = GO_JSON_STATE_END_VALUE;
    };
    return;
}

// stateBeginValue: the state at the beginning of the input.
fn __go_json_state_begin_value(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_space(c) {
        return GO_JSON_SCAN_SKIP_SPACE;
    };
    let ci = c as i64;
    if ci == 123 {
        s.step = GO_JSON_STATE_BEGIN_STRING_OR_EMPTY;
        return __go_json_scan_push_parse_state(s, c, GO_JSON_PARSE_OBJECT_KEY, GO_JSON_SCAN_BEGIN_OBJECT);
    };
    if ci == 91 {
        s.step = GO_JSON_STATE_BEGIN_VALUE_OR_EMPTY;
        return __go_json_scan_push_parse_state(s, c, GO_JSON_PARSE_ARRAY_VALUE, GO_JSON_SCAN_BEGIN_ARRAY);
    };
    if ci == 34 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_BEGIN_LITERAL;
    };
    if ci == 45 {
        s.step = GO_JSON_STATE_NEG;
        return GO_JSON_SCAN_BEGIN_LITERAL;
    };
    if ci == 48 {
        s.step = GO_JSON_STATE_0;
        return GO_JSON_SCAN_BEGIN_LITERAL;
    };
    if ci == 116 {
        s.step = GO_JSON_STATE_T;
        return GO_JSON_SCAN_BEGIN_LITERAL;
    };
    if ci == 102 {
        s.step = GO_JSON_STATE_F;
        return GO_JSON_SCAN_BEGIN_LITERAL;
    };
    if ci == 110 {
        s.step = GO_JSON_STATE_N;
        return GO_JSON_SCAN_BEGIN_LITERAL;
    };
    if ci >= 49 {
        if ci <= 57 {
            s.step = GO_JSON_STATE_1;
            return GO_JSON_SCAN_BEGIN_LITERAL;
        };
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_BEGIN_VALUE);
}

// stateBeginValueOrEmpty: the state after reading `[`.
fn __go_json_state_begin_value_or_empty(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_space(c) {
        return GO_JSON_SCAN_SKIP_SPACE;
    };
    if c == 93u8 {
        return __go_json_state_end_value(s, c);
    };
    return __go_json_state_begin_value(s, c);
}

// stateBeginStringOrEmpty: the state after reading `{`.
fn __go_json_state_begin_string_or_empty(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_space(c) {
        return GO_JSON_SCAN_SKIP_SPACE;
    };
    if c == 125u8 {
        s.parse_state[s.depth - 1] = GO_JSON_PARSE_OBJECT_VALUE;
        return __go_json_state_end_value(s, c);
    };
    return __go_json_state_begin_string(s, c);
}

// stateBeginString: the state after reading `{"key": value,`.
fn __go_json_state_begin_string(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_space(c) {
        return GO_JSON_SCAN_SKIP_SPACE;
    };
    if c == 34u8 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_BEGIN_LITERAL;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_BEGIN_OBJECT_KEY);
}

// stateEndValue: the state after completing a value.
fn __go_json_state_end_value(s: &GoJsonScanner, c: u8) -> i64 {
    if s.depth == 0 {
        s.step = GO_JSON_STATE_END_TOP;
        s.end_top = true;
        return __go_json_state_end_top(s, c);
    };
    if __go_json_is_space(c) {
        s.step = GO_JSON_STATE_END_VALUE;
        return GO_JSON_SCAN_SKIP_SPACE;
    };
    let ps = s.parse_state[s.depth - 1];
    if ps == GO_JSON_PARSE_OBJECT_KEY {
        if c == 58u8 {
            s.parse_state[s.depth - 1] = GO_JSON_PARSE_OBJECT_VALUE;
            s.step = GO_JSON_STATE_BEGIN_VALUE;
            return GO_JSON_SCAN_OBJECT_KEY;
        };
        return __go_json_scan_error(s, c, GO_JSON_CTX_AFTER_OBJECT_KEY);
    };
    if ps == GO_JSON_PARSE_OBJECT_VALUE {
        if c == 44u8 {
            s.parse_state[s.depth - 1] = GO_JSON_PARSE_OBJECT_KEY;
            s.step = GO_JSON_STATE_BEGIN_STRING;
            return GO_JSON_SCAN_OBJECT_VALUE;
        };
        if c == 125u8 {
            __go_json_scan_pop_parse_state(s);
            return GO_JSON_SCAN_END_OBJECT;
        };
        return __go_json_scan_error(s, c, GO_JSON_CTX_AFTER_OBJECT_KV);
    };
    if ps == GO_JSON_PARSE_ARRAY_VALUE {
        if c == 44u8 {
            s.step = GO_JSON_STATE_BEGIN_VALUE;
            return GO_JSON_SCAN_ARRAY_VALUE;
        };
        if c == 93u8 {
            __go_json_scan_pop_parse_state(s);
            return GO_JSON_SCAN_END_ARRAY;
        };
        return __go_json_scan_error(s, c, GO_JSON_CTX_AFTER_ARRAY_ELEMENT);
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_EMPTY);
}

// stateEndTop: the state after finishing the top-level
// value. A non-space byte records the error (step
// becomes stateError) but this call still returns
// scanEnd; the next call reports scanError. That is
// Go's code verbatim, not a simplification.
fn __go_json_state_end_top(s: &GoJsonScanner, c: u8) -> i64 {
    if !__go_json_is_space(c) {
        let _e = __go_json_scan_error(s, c, GO_JSON_CTX_AFTER_TOP_VALUE);
    };
    return GO_JSON_SCAN_END;
}

// stateInString: the state after reading `"`.
fn __go_json_state_in_string(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 34u8 {
        s.step = GO_JSON_STATE_END_VALUE;
        return GO_JSON_SCAN_CONTINUE;
    };
    if c == 92u8 {
        s.step = GO_JSON_STATE_IN_STRING_ESC;
        return GO_JSON_SCAN_CONTINUE;
    };
    if (c as i64) < 32 {
        return __go_json_scan_error(s, c, GO_JSON_CTX_IN_STRING);
    };
    return GO_JSON_SCAN_CONTINUE;
}

// stateInStringEsc: the state after reading `"\`.
fn __go_json_state_in_string_esc(s: &GoJsonScanner, c: u8) -> i64 {
    let ci = c as i64;
    if ci == 98 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 102 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 110 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 114 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 116 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 92 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 47 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 34 {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 117 {
        s.step = GO_JSON_STATE_IN_STRING_ESC_U;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_IN_STRING_ESC);
}

// stateInStringEscU: after reading `"\u`.
fn __go_json_state_in_string_esc_u(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_hex_digit(c) {
        s.step = GO_JSON_STATE_IN_STRING_ESC_U1;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_IN_U_ESCAPE);
}

// stateInStringEscU1: after reading `"\u1`.
fn __go_json_state_in_string_esc_u1(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_hex_digit(c) {
        s.step = GO_JSON_STATE_IN_STRING_ESC_U12;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_IN_U_ESCAPE);
}

// stateInStringEscU12: after reading `"\u12`.
fn __go_json_state_in_string_esc_u12(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_hex_digit(c) {
        s.step = GO_JSON_STATE_IN_STRING_ESC_U123;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_IN_U_ESCAPE);
}

// stateInStringEscU123: after reading `"\u123`.
fn __go_json_state_in_string_esc_u123(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_hex_digit(c) {
        s.step = GO_JSON_STATE_IN_STRING;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_IN_U_ESCAPE);
}

// stateNeg: the state after reading `-` in a number.
fn __go_json_state_neg(s: &GoJsonScanner, c: u8) -> i64 {
    let ci = c as i64;
    if ci == 48 {
        s.step = GO_JSON_STATE_0;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci >= 49 {
        if ci <= 57 {
            s.step = GO_JSON_STATE_1;
            return GO_JSON_SCAN_CONTINUE;
        };
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_IN_NUMBER);
}

// state1: after a non-zero integer in a number.
fn __go_json_state_1(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_digit(c) {
        s.step = GO_JSON_STATE_1;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_state_0(s, c);
}

// state0: after reading `0` in a number.
fn __go_json_state_0(s: &GoJsonScanner, c: u8) -> i64 {
    let ci = c as i64;
    if ci == 46 {
        s.step = GO_JSON_STATE_DOT;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 101 {
        s.step = GO_JSON_STATE_E;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 69 {
        s.step = GO_JSON_STATE_E;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_state_end_value(s, c);
}

// stateDot: after the decimal point in a number.
fn __go_json_state_dot(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_digit(c) {
        s.step = GO_JSON_STATE_DOT0;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_AFTER_DOT);
}

// stateDot0: after integer, point, and digits.
fn __go_json_state_dot0(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_digit(c) {
        return GO_JSON_SCAN_CONTINUE;
    };
    let ci = c as i64;
    if ci == 101 {
        s.step = GO_JSON_STATE_E;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 69 {
        s.step = GO_JSON_STATE_E;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_state_end_value(s, c);
}

// stateE: after the mantissa and e in a number.
fn __go_json_state_e(s: &GoJsonScanner, c: u8) -> i64 {
    let ci = c as i64;
    if ci == 43 {
        s.step = GO_JSON_STATE_ESIGN;
        return GO_JSON_SCAN_CONTINUE;
    };
    if ci == 45 {
        s.step = GO_JSON_STATE_ESIGN;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_state_esign(s, c);
}

// stateESign: after mantissa, e, and sign.
fn __go_json_state_esign(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_digit(c) {
        s.step = GO_JSON_STATE_E0;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_IN_EXPONENT);
}

// stateE0: after mantissa, e, sign, and exponent digits.
fn __go_json_state_e0(s: &GoJsonScanner, c: u8) -> i64 {
    if __go_json_is_digit(c) {
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_state_end_value(s, c);
}

// stateT: after reading `t`.
fn __go_json_state_t(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 114u8 {
        s.step = GO_JSON_STATE_TR;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_TRUE_R);
}

// stateTr: after reading `tr`.
fn __go_json_state_tr(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 117u8 {
        s.step = GO_JSON_STATE_TRU;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_TRUE_U);
}

// stateTru: after reading `tru`.
fn __go_json_state_tru(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 101u8 {
        s.step = GO_JSON_STATE_END_VALUE;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_TRUE_E);
}

// stateF: after reading `f`.
fn __go_json_state_f(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 97u8 {
        s.step = GO_JSON_STATE_FA;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_FALSE_A);
}

// stateFa: after reading `fa`.
fn __go_json_state_fa(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 108u8 {
        s.step = GO_JSON_STATE_FAL;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_FALSE_L);
}

// stateFal: after reading `fal`.
fn __go_json_state_fal(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 115u8 {
        s.step = GO_JSON_STATE_FALS;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_FALSE_S);
}

// stateFals: after reading `fals`.
fn __go_json_state_fals(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 101u8 {
        s.step = GO_JSON_STATE_END_VALUE;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_FALSE_E);
}

// stateN: after reading `n`.
fn __go_json_state_n(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 117u8 {
        s.step = GO_JSON_STATE_NU;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_NULL_U);
}

// stateNu: after reading `nu`.
fn __go_json_state_nu(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 108u8 {
        s.step = GO_JSON_STATE_NUL;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_NULL_L);
}

// stateNul: after reading `nul`.
fn __go_json_state_nul(s: &GoJsonScanner, c: u8) -> i64 {
    if c == 108u8 {
        s.step = GO_JSON_STATE_END_VALUE;
        return GO_JSON_SCAN_CONTINUE;
    };
    return __go_json_scan_error(s, c, GO_JSON_CTX_NULL_L);
}

// stateError: after a syntax error; every call returns scanError.
fn __go_json_state_error(s: &GoJsonScanner, c: u8) -> i64 {
    let _c = c;
    let _s = s;
    return GO_JSON_SCAN_ERROR;
}

// The step dispatch: Go's scanner.step is a func
// value; here it is the i64 state code (see the
// header divergence note). No closure is involved:
// the dispatch is a plain if-chain over state codes.
fn __go_json_scan_step(s: &GoJsonScanner, c: u8) -> i64 {
    if s.step == GO_JSON_STATE_BEGIN_VALUE {
        return __go_json_state_begin_value(s, c);
    };
    if s.step == GO_JSON_STATE_BEGIN_VALUE_OR_EMPTY {
        return __go_json_state_begin_value_or_empty(s, c);
    };
    if s.step == GO_JSON_STATE_BEGIN_STRING_OR_EMPTY {
        return __go_json_state_begin_string_or_empty(s, c);
    };
    if s.step == GO_JSON_STATE_BEGIN_STRING {
        return __go_json_state_begin_string(s, c);
    };
    if s.step == GO_JSON_STATE_END_VALUE {
        return __go_json_state_end_value(s, c);
    };
    if s.step == GO_JSON_STATE_END_TOP {
        return __go_json_state_end_top(s, c);
    };
    if s.step == GO_JSON_STATE_IN_STRING {
        return __go_json_state_in_string(s, c);
    };
    if s.step == GO_JSON_STATE_IN_STRING_ESC {
        return __go_json_state_in_string_esc(s, c);
    };
    if s.step == GO_JSON_STATE_IN_STRING_ESC_U {
        return __go_json_state_in_string_esc_u(s, c);
    };
    if s.step == GO_JSON_STATE_IN_STRING_ESC_U1 {
        return __go_json_state_in_string_esc_u1(s, c);
    };
    if s.step == GO_JSON_STATE_IN_STRING_ESC_U12 {
        return __go_json_state_in_string_esc_u12(s, c);
    };
    if s.step == GO_JSON_STATE_IN_STRING_ESC_U123 {
        return __go_json_state_in_string_esc_u123(s, c);
    };
    if s.step == GO_JSON_STATE_NEG {
        return __go_json_state_neg(s, c);
    };
    if s.step == GO_JSON_STATE_1 {
        return __go_json_state_1(s, c);
    };
    if s.step == GO_JSON_STATE_0 {
        return __go_json_state_0(s, c);
    };
    if s.step == GO_JSON_STATE_DOT {
        return __go_json_state_dot(s, c);
    };
    if s.step == GO_JSON_STATE_DOT0 {
        return __go_json_state_dot0(s, c);
    };
    if s.step == GO_JSON_STATE_E {
        return __go_json_state_e(s, c);
    };
    if s.step == GO_JSON_STATE_ESIGN {
        return __go_json_state_esign(s, c);
    };
    if s.step == GO_JSON_STATE_E0 {
        return __go_json_state_e0(s, c);
    };
    if s.step == GO_JSON_STATE_T {
        return __go_json_state_t(s, c);
    };
    if s.step == GO_JSON_STATE_TR {
        return __go_json_state_tr(s, c);
    };
    if s.step == GO_JSON_STATE_TRU {
        return __go_json_state_tru(s, c);
    };
    if s.step == GO_JSON_STATE_F {
        return __go_json_state_f(s, c);
    };
    if s.step == GO_JSON_STATE_FA {
        return __go_json_state_fa(s, c);
    };
    if s.step == GO_JSON_STATE_FAL {
        return __go_json_state_fal(s, c);
    };
    if s.step == GO_JSON_STATE_FALS {
        return __go_json_state_fals(s, c);
    };
    if s.step == GO_JSON_STATE_N {
        return __go_json_state_n(s, c);
    };
    if s.step == GO_JSON_STATE_NU {
        return __go_json_state_nu(s, c);
    };
    if s.step == GO_JSON_STATE_NUL {
        return __go_json_state_nul(s, c);
    };
    return __go_json_state_error(s, c);
}

// Public step entry point (the frontend-emitted
// concrete decode calls this, or uses the decode-state
// primitives, which call it internally).
fn go_encoding_json_scan_step(s: &GoJsonScanner, c: u8) -> i64 {
    return __go_json_scan_step(s, c);
}

// Go's scanner.eof.
fn go_encoding_json_scanner_eof(s: &GoJsonScanner) -> i64 {
    if s.err != go_errors_nil() {
        return GO_JSON_SCAN_ERROR;
    };
    if s.end_top {
        return GO_JSON_SCAN_END;
    };
    let _v = __go_json_scan_step(s, 32u8);
    if s.end_top {
        return GO_JSON_SCAN_END;
    };
    if s.err == go_errors_nil() {
        let m = Vec::new();
        __go_json_msg_unexpected_eof(m);
        s.err = go_encoding_json_syntax_error(m, s.bytes);
    };
    return GO_JSON_SCAN_ERROR;
}

// Go's checkValid: step every byte (bytes counted
// before each step, as in Go), then eof.
fn go_encoding_json_check_valid(data: Vec<u8>) -> GoJsonValidResult {
    let scan = go_encoding_json_scanner_new();
    let i = 0;
    while i < len(data) {
        scan.bytes = scan.bytes + 1;
        let op = __go_json_scan_step(&scan, data[i]);
        if op == GO_JSON_SCAN_ERROR {
            return GoJsonValidResult { ok: false, err: scan.err, offset: scan.bytes };
        };
        i = i + 1;
    }
    let e = go_encoding_json_scanner_eof(&scan);
    if e == GO_JSON_SCAN_ERROR {
        return GoJsonValidResult { ok: false, err: scan.err, offset: scan.bytes };
    };
    return GoJsonValidResult { ok: true, err: go_errors_nil(), offset: 0 };
}

// Go's Valid.
fn go_encoding_json_valid(data: Vec<u8>) -> bool {
    let r = go_encoding_json_check_valid(data);
    return r.ok;
}

// ---------- string encoding ----------

// Go's safeSet / htmlSafeSet (tables.go) as a
// predicate: ASCII control chars (0-31), '"' and
// '\\' are never safe; '<', '>' and '&' are unsafe
// only when escape_html is set. 0x7f is safe in both
// tables. Non-ASCII bytes (>= 0x80) are not decided
// here -- append_string decodes them as runes.
fn __go_json_is_safe_byte(b: u8, escape_html: bool) -> bool {
    let v = b as i64;
    if v < 32 {
        return false;
    };
    if v == 34 {
        return false;
    };
    if v == 92 {
        return false;
    };
    if escape_html {
        if v == 60 {
            return false;
        };
        if v == 62 {
            return false;
        };
        if v == 38 {
            return false;
        };
    };
    return true;
}

fn __go_json_append_range(dst: Vec<u8>, src: Vec<u8>, lo: i64, hi: i64) -> void {
    let i = lo;
    while i < hi {
        dst.push(src[i]);
        i = i + 1;
    }
    return;
}

// Go's appendString (encode.go): the quoted, escaped
// JSON string literal for src, appended to dst.
// escape_html selects htmlSafeSet (Marshal / Encoder
// default) vs safeSet (SetEscapeHTML(false)). Invalid
// UTF-8 bytes become \ufffd; U+2028 / U+2029 are
// always escaped (\u2028 / \u2029).
fn go_encoding_json_append_string(dst: Vec<u8>, src: Vec<u8>, escape_html: bool) -> void {
    dst.push(34u8);
    let start = 0;
    let i = 0;
    while i < len(src) {
        let b = src[i];
        if (b as i64) < 128 {
            if __go_json_is_safe_byte(b, escape_html) {
                i = i + 1;
                continue;
            };
            __go_json_append_range(dst, src, start, i);
            if b == 92u8 {
                dst.push(92u8);
                dst.push(92u8);
            } else {
                if b == 34u8 {
                    dst.push(92u8);
                    dst.push(34u8);
                } else {
                    if b == 8u8 {
                        dst.push(92u8);
                        dst.push(98u8);
                    } else {
                        if b == 12u8 {
                            dst.push(92u8);
                            dst.push(102u8);
                        } else {
                            if b == 10u8 {
                                dst.push(92u8);
                                dst.push(110u8);
                            } else {
                                if b == 13u8 {
                                    dst.push(92u8);
                                    dst.push(114u8);
                                } else {
                                    if b == 9u8 {
                                        dst.push(92u8);
                                        dst.push(116u8);
                                    } else {
                                        dst.push(92u8);
                                        dst.push(117u8);
                                        dst.push(48u8);
                                        dst.push(48u8);
                                        dst.push(__go_json_hex_digit((b as i64) >> 4));
                                        dst.push(__go_json_hex_digit((b as i64) & 15));
                                    };
                                };
                            };
                        };
                    };
                };
            };
            i = i + 1;
            start = i;
            continue;
        };
        let d = __go_utf8_decode(src, i);
        if !d.ok {
            __go_json_append_range(dst, src, start, i);
            dst.push(92u8);
            dst.push(117u8);
            dst.push(102u8);
            dst.push(102u8);
            dst.push(102u8);
            dst.push(100u8);
            i = i + 1;
            start = i;
            continue;
        };
        if d.r == 8232 {
            __go_json_append_range(dst, src, start, i);
            dst.push(92u8);
            dst.push(117u8);
            dst.push(50u8);
            dst.push(48u8);
            dst.push(50u8);
            dst.push(56u8);
            i = i + d.size;
            start = i;
            continue;
        };
        if d.r == 8233 {
            __go_json_append_range(dst, src, start, i);
            dst.push(92u8);
            dst.push(117u8);
            dst.push(50u8);
            dst.push(48u8);
            dst.push(50u8);
            dst.push(57u8);
            i = i + d.size;
            start = i;
            continue;
        };
        i = i + d.size;
    }
    __go_json_append_range(dst, src, start, len(src));
    dst.push(34u8);
    return;
}

// The quoted string literal for s, as a fresh value.
fn go_encoding_json_quote_string(s: Vec<u8>, escape_html: bool) -> Vec<u8> {
    let out = Vec::new();
    go_encoding_json_append_string(out, s, escape_html);
    return out;
}

// Go's stringEncoder with the ",string" option: the
// scalar's JSON text is itself encoded as a JSON
// string (double escaping). Used by frontend-emitted
// struct code for `,string` fields.
fn go_encoding_json_append_string_quoted(dst: Vec<u8>, s: Vec<u8>, escape_html: bool) -> void {
    let inner = go_encoding_json_quote_string(s, escape_html);
    go_encoding_json_append_string(dst, inner, false);
    return;
}

// ---------- HTMLEscape / Compact / Indent ----------

// Go's appendHTMLEscape (indent.go): escape <, >,
// & and U+2028 / U+2029 in src, appended to dst.
// Only string-literal bytes can carry these, so the
// scan is byte-at-a-time over the whole input.
fn go_encoding_json_html_escape(dst: Vec<u8>, src: Vec<u8>) -> void {
    let start = 0;
    let i = 0;
    while i < len(src) {
        let c = src[i];
        if c == 60u8 {
            __go_json_append_range(dst, src, start, i);
            dst.push(92u8); dst.push(117u8); dst.push(48u8); dst.push(48u8); dst.push(51u8); dst.push(99u8);
            start = i + 1;
        } else {
            if c == 62u8 {
                __go_json_append_range(dst, src, start, i);
                dst.push(92u8); dst.push(117u8); dst.push(48u8); dst.push(48u8); dst.push(51u8); dst.push(101u8);
                start = i + 1;
            } else {
                if c == 38u8 {
                    __go_json_append_range(dst, src, start, i);
                    dst.push(92u8); dst.push(117u8); dst.push(48u8); dst.push(48u8); dst.push(50u8); dst.push(54u8);
                    start = i + 1;
                } else {
                    if c == 226u8 {
                        if i + 2 < len(src) {
                            if src[i + 1] == 128u8 {
                                let b2 = src[i + 2];
                                if b2 == 168u8 {
                                    __go_json_append_range(dst, src, start, i);
                                    dst.push(92u8); dst.push(117u8); dst.push(50u8); dst.push(48u8); dst.push(50u8); dst.push(56u8);
                                    start = i + 3;
                                    i = i + 3;
                                    continue;
                                } else {
                                    if b2 == 169u8 {
                                        __go_json_append_range(dst, src, start, i);
                                        dst.push(92u8); dst.push(117u8); dst.push(50u8); dst.push(48u8); dst.push(50u8); dst.push(57u8);
                                        start = i + 3;
                                        i = i + 3;
                                        continue;
                                    };
                                };
                            };
                        };
                    };
                };
            };
        };
        i = i + 1;
    }
    __go_json_append_range(dst, src, start, len(src));
    return;
}

// Go's appendCompact (indent.go): src with
// insignificant space elided, appended to dst.
// escape=true also HTML-escapes <, >, & and
// U+2028 / U+2029 (the marshalerEncoder path for
// MarshalJSON output). NOTE: Go's appendCompact does
// NOT count scan.bytes, so a SyntaxError from here
// carries offset 0 -- mirrored here exactly (use
// checkValid for the offset). On error dst is
// untouched (Go returns dst[:origLen]; SLA has no
// Vec truncate, so the work is done in a temp vec
// and appended only on success).
fn go_encoding_json_append_compact(dst: Vec<u8>, src: Vec<u8>, escape: bool) -> ptr {
    let tmp = Vec::new();
    let scan = go_encoding_json_scanner_new();
    let start = 0;
    let i = 0;
    while i < len(src) {
        let c = src[i];
        if escape {
            if c == 60u8 {
                if start < i {
                    __go_json_append_range(tmp, src, start, i);
                };
                tmp.push(92u8); tmp.push(117u8); tmp.push(48u8); tmp.push(48u8); tmp.push(51u8); tmp.push(99u8);
                start = i + 1;
            } else {
                if c == 62u8 {
                    if start < i {
                        __go_json_append_range(tmp, src, start, i);
                    };
                    tmp.push(92u8); tmp.push(117u8); tmp.push(48u8); tmp.push(48u8); tmp.push(51u8); tmp.push(101u8);
                    start = i + 1;
                } else {
                    if c == 38u8 {
                        if start < i {
                            __go_json_append_range(tmp, src, start, i);
                        };
                        tmp.push(92u8); tmp.push(117u8); tmp.push(48u8); tmp.push(48u8); tmp.push(50u8); tmp.push(54u8);
                        start = i + 1;
                    };
                };
            };
        };
        if escape {
            if c == 226u8 {
                if i + 2 < len(src) {
                    if src[i + 1] == 128u8 {
                        let b2 = src[i + 2];
                        if b2 == 168u8 {
                            if start < i {
                                __go_json_append_range(tmp, src, start, i);
                            };
                            tmp.push(92u8); tmp.push(117u8); tmp.push(50u8); tmp.push(48u8); tmp.push(50u8); tmp.push(56u8);
                            start = i + 3;
                        } else {
                            if b2 == 169u8 {
                                if start < i {
                                    __go_json_append_range(tmp, src, start, i);
                                };
                                tmp.push(92u8); tmp.push(117u8); tmp.push(50u8); tmp.push(48u8); tmp.push(50u8); tmp.push(57u8);
                                start = i + 3;
                            };
                        };
                    };
                };
            };
        };
        let v = __go_json_scan_step(&scan, c);
        if v >= GO_JSON_SCAN_SKIP_SPACE {
            if v == GO_JSON_SCAN_ERROR {
                break;
            };
            if start < i {
                __go_json_append_range(tmp, src, start, i);
            };
            start = i + 1;
        };
        i = i + 1;
    }
    let e = go_encoding_json_scanner_eof(&scan);
    if e == GO_JSON_SCAN_ERROR {
        return scan.err;
    };
    if start < len(src) {
        __go_json_append_range(tmp, src, start, len(src));
    };
    __go_json_append(dst, tmp);
    return go_errors_nil();
}

// Go's Compact: appendCompact with escape=false.
fn go_encoding_json_compact(dst: Vec<u8>, src: Vec<u8>) -> ptr {
    return go_encoding_json_append_compact(dst, src, false);
}

// Go's appendNewline (indent.go).
fn __go_json_append_newline(dst: Vec<u8>, prefix: Vec<u8>, indent: Vec<u8>, depth: i64) -> void {
    dst.push(10u8);
    __go_json_append(dst, prefix);
    let i = 0;
    while i < depth {
        __go_json_append(dst, indent);
        i = i + 1;
    }
    return;
}

// Go's appendIndent (indent.go). NOTE: unlike
// appendCompact this one DOES count scan.bytes
// (indent.go line 135), so its SyntaxError offsets
// are exact. On error dst is untouched (same
// temp-vec reason as appendCompact).
fn go_encoding_json_append_indent(dst: Vec<u8>, src: Vec<u8>, prefix: Vec<u8>, indent: Vec<u8>) -> ptr {
    let tmp = Vec::new();
    let scan = go_encoding_json_scanner_new();
    let need_indent = false;
    let depth = 0;
    let i = 0;
    while i < len(src) {
        let c = src[i];
        scan.bytes = scan.bytes + 1;
        let v = __go_json_scan_step(&scan, c);
        if v == GO_JSON_SCAN_SKIP_SPACE {
            i = i + 1;
            continue;
        };
        if v == GO_JSON_SCAN_ERROR {
            break;
        };
        if need_indent {
            if v != GO_JSON_SCAN_END_OBJECT {
                if v != GO_JSON_SCAN_END_ARRAY {
                    need_indent = false;
                    depth = depth + 1;
                    __go_json_append_newline(tmp, prefix, indent, depth);
                };
            };
        };
        if v == GO_JSON_SCAN_CONTINUE {
            tmp.push(c);
            i = i + 1;
            continue;
        };
        if c == 123u8 {
            need_indent = true;
            tmp.push(c);
            i = i + 1;
            continue;
        };
        if c == 91u8 {
            need_indent = true;
            tmp.push(c);
            i = i + 1;
            continue;
        };
        if c == 44u8 {
            tmp.push(c);
            __go_json_append_newline(tmp, prefix, indent, depth);
            i = i + 1;
            continue;
        };
        if c == 58u8 {
            tmp.push(c);
            tmp.push(32u8);
            i = i + 1;
            continue;
        };
        if c == 125u8 {
            if need_indent {
                need_indent = false;
            } else {
                depth = depth - 1;
                __go_json_append_newline(tmp, prefix, indent, depth);
            };
            tmp.push(c);
            i = i + 1;
            continue;
        };
        if c == 93u8 {
            if need_indent {
                need_indent = false;
            } else {
                depth = depth - 1;
                __go_json_append_newline(tmp, prefix, indent, depth);
            };
            tmp.push(c);
            i = i + 1;
            continue;
        };
        tmp.push(c);
        i = i + 1;
    }
    let e = go_encoding_json_scanner_eof(&scan);
    if e == GO_JSON_SCAN_ERROR {
        return scan.err;
    };
    __go_json_append(dst, tmp);
    return go_errors_nil();
}

// Go's Indent: appendIndent with a fresh temp target.
fn go_encoding_json_indent(dst: Vec<u8>, src: Vec<u8>, prefix: Vec<u8>, indent: Vec<u8>) -> ptr {
    return go_encoding_json_append_indent(dst, src, prefix, indent);
}

// ---------- struct field tags (tags.go) ----------

// Go's parseTag: split at the first ',' into name
// and options (without the comma).
fn go_encoding_json_parse_tag(tag: Vec<u8>) -> GoJsonTag {
    let i = 0;
    while i < len(tag) {
        if tag[i] == 44u8 {
            return GoJsonTag { name: __go_json_slice(tag, 0, i), opts: __go_json_slice(tag, i + 1, len(tag)) };
        };
        i = i + 1;
    }
    return GoJsonTag { name: tag, opts: Vec::new() };
}

// Go's tagOptions.Contains: comma-separated exact
// match of one option name.
fn go_encoding_json_tag_contains(opts: Vec<u8>, name: Vec<u8>) -> bool {
    if len(opts) == 0 {
        return false;
    };
    let rest = opts;
    while len(rest) > 0 {
        let i = 0;
        let cut = -1;
        while i < len(rest) {
            if rest[i] == 44u8 {
                cut = i;
                break;
            };
            i = i + 1;
        }
        if cut == -1 {
            return __go_json_bytes_eq(rest, name);
        };
        let part = __go_json_slice(rest, 0, cut);
        if __go_json_bytes_eq(part, name) {
            return true;
        };
        rest = __go_json_slice(rest, cut + 1, len(rest));
    }
    return false;
}

// ---------- foldName (fold.go) ----------

// Go's foldRune: walk SimpleFold until the rune
// stops decreasing (the smallest rune in the fold
// set). __go_str_simple_fold is strings.sla's
// SimpleFold (ASCII + the K / long-s special cases;
// see the manifest note on its coverage).
fn __go_json_fold_rune(r: i64) -> i64 {
    let cur = r;
    while true {
        let r2 = __go_str_simple_fold(cur);
        if r2 <= cur {
            return r2;
        };
        cur = r2;
    }
}

// Go's foldName / appendFoldedName: ASCII a-z fold
// to A-Z; other runes fold via foldRune. foldName(x)
// == foldName(y) is bytes.EqualFold(x, y).
fn go_encoding_json_fold_name(s: Vec<u8>) -> Vec<u8> {
    let out = Vec::new();
    let i = 0;
    while i < len(s) {
        let b = s[i];
        if (b as i64) < 128 {
            let v = b as i64;
            if v >= 97 {
                if v <= 122 {
                    out.push((v - 32) as u8);
                    i = i + 1;
                    continue;
                };
            };
            out.push(b);
            i = i + 1;
            continue;
        };
        let d = __go_utf8_decode(s, i);
        let f = __go_json_fold_rune(d.r);
        __go_utf8_append(out, f);
        i = i + d.size;
    }
    return out;
}

// Go's struct-field lookup: an exact name match
// wins, else a folded (case-insensitive) match.
fn go_encoding_json_field_name_matches(key: Vec<u8>, field_name: Vec<u8>) -> bool {
    if __go_json_bytes_eq(key, field_name) {
        return true;
    };
    let fk = go_encoding_json_fold_name(key);
    let ff = go_encoding_json_fold_name(field_name);
    return __go_json_bytes_eq(fk, ff);
}

// ---------- isValidTag / isValidNumber (encode.go) ----------

// Go's isValidTag punctuation set, as ranges:
// space, '!', '#'-'&', '('-'/', ':'-'@', '['-'^',
// '_', '{'-'~'. ('"' and '\\' are reserved.)
fn __go_json_is_tag_punct(v: i64) -> bool {
    if v == 32 { return true; };
    if v == 33 { return true; };
    if v >= 35 {
        if v <= 38 { return true; };
    };
    if v >= 40 {
        if v <= 47 { return true; };
    };
    if v >= 58 {
        if v <= 64 { return true; };
    };
    if v >= 91 {
        if v <= 94 { return true; };
    };
    if v == 95 { return true; };
    if v >= 123 {
        if v <= 126 { return true; };
    };
    return false;
}

fn __go_json_is_ascii_letter_or_digit(v: i64) -> bool {
    if v >= 48 {
        if v <= 57 { return true; };
    };
    if v >= 65 {
        if v <= 90 { return true; };
    };
    if v >= 97 {
        if v <= 122 { return true; };
    };
    return false;
}

// Go's isValidTag. Non-ASCII runes are treated as
// letters (see the header divergence note -- Go uses
// unicode.IsLetter, which needs unicode tables).
fn go_encoding_json_is_valid_tag(name: Vec<u8>) -> bool {
    if len(name) == 0 {
        return false;
    };
    let i = 0;
    while i < len(name) {
        let b = name[i];
        if (b as i64) < 128 {
            let v = b as i64;
            if __go_json_is_tag_punct(v) {
                i = i + 1;
                continue;
            };
            if __go_json_is_ascii_letter_or_digit(v) {
                i = i + 1;
                continue;
            };
            return false;
        };
        let d = __go_utf8_decode(name, i);
        i = i + d.size;
    }
    return true;
}

// Go's isValidNumber (the JSON numbers grammar).
// && is eager in SLA, so the length guards are
// nested ifs, never && chains -- an index past the
// end would fault instead of short-circuiting.
fn go_encoding_json_is_valid_number(s: Vec<u8>) -> bool {
    if len(s) == 0 {
        return false;
    };
    let i = 0;
    if s[0] == 45u8 {
        i = 1;
        if i >= len(s) {
            return false;
        };
    };
    if s[i] == 48u8 {
        i = i + 1;
    } else {
        if s[i] >= 49u8 {
            if s[i] <= 57u8 {
                i = i + 1;
                while i < len(s) {
                    if s[i] >= 48u8 {
                        if s[i] <= 57u8 {
                            i = i + 1;
                            continue;
                        };
                    };
                    break;
                }
            } else {
                return false;
            };
        } else {
            return false;
        };
    };
    if i + 1 < len(s) {
        if s[i] == 46u8 {
            if s[i + 1] >= 48u8 {
                if s[i + 1] <= 57u8 {
                    i = i + 2;
                    while i < len(s) {
                        if s[i] >= 48u8 {
                            if s[i] <= 57u8 {
                                i = i + 1;
                                continue;
                            };
                        };
                        break;
                    }
                };
            };
        };
    };
    if i + 1 < len(s) {
        if s[i] == 101u8 {
            i = i + 1;
            if s[i] == 43u8 {
                i = i + 1;
                if i >= len(s) {
                    return false;
                };
            } else {
                if s[i] == 45u8 {
                    i = i + 1;
                    if i >= len(s) {
                        return false;
                    };
                };
            };
            while i < len(s) {
                if s[i] >= 48u8 {
                    if s[i] <= 57u8 {
                        i = i + 1;
                        continue;
                    };
                };
                break;
            }
        } else {
            if s[i] == 69u8 {
                i = i + 1;
                if s[i] == 43u8 {
                    i = i + 1;
                    if i >= len(s) {
                        return false;
                    };
                } else {
                    if s[i] == 45u8 {
                        i = i + 1;
                        if i >= len(s) {
                            return false;
                        };
                    };
                };
                while i < len(s) {
                    if s[i] >= 48u8 {
                        if s[i] <= 57u8 {
                            i = i + 1;
                            continue;
                        };
                    };
                    break;
                }
            };
        };
    };
    return i == len(s);
}

// ---------- omitempty / omitzero ----------

// Go's isEmptyValue for the 1b kinds: empty is false,
// 0, or length zero. In this subset omitzero is the
// same test (the zero value is the empty value for
// string / int / uint / bool / slice / map).
fn go_encoding_json_is_empty_string(v: Vec<u8>) -> bool {
    return len(v) == 0;
}

fn go_encoding_json_is_empty_int(v: i64) -> bool {
    return v == 0;
}

fn go_encoding_json_is_empty_uint(v: u64) -> bool {
    return v == 0 as u64;
}

fn go_encoding_json_is_empty_bool(v: bool) -> bool {
    return !v;
}

fn go_encoding_json_is_empty_len(n: i64) -> bool {
    return n == 0;
}

// ---------- marshal framing (layer A) ----------

// Punctuation the frontend-emitted concrete marshal
// writes around the values it encodes. Every helper
// takes dst by value (the shared-buffer handle, as
// in log.sla) and appends exactly Go's bytes.

fn go_encoding_json_marshal_begin_array(dst: Vec<u8>) -> void {
    dst.push(91u8);
    return;
}

fn go_encoding_json_marshal_end_array(dst: Vec<u8>) -> void {
    dst.push(93u8);
    return;
}

fn go_encoding_json_marshal_begin_object(dst: Vec<u8>) -> void {
    dst.push(123u8);
    return;
}

fn go_encoding_json_marshal_end_object(dst: Vec<u8>) -> void {
    dst.push(125u8);
    return;
}

// ',' before every element / field after the first.
fn go_encoding_json_marshal_sep(dst: Vec<u8>, first: bool) -> void {
    if first {
        return;
    };
    dst.push(44u8);
    return;
}

// A struct field: ',' unless first, then the quoted
// name and ':'.
fn go_encoding_json_marshal_field(dst: Vec<u8>, name: Vec<u8>, escape_html: bool, first: bool) -> void {
    go_encoding_json_marshal_sep(dst, first);
    go_encoding_json_append_string(dst, name, escape_html);
    dst.push(58u8);
    return;
}

// A map key uses the same punctuation as a field.
fn go_encoding_json_marshal_map_key(dst: Vec<u8>, key: Vec<u8>, escape_html: bool, first: bool) -> void {
    go_encoding_json_marshal_field(dst, key, escape_html, first);
    return;
}

fn go_encoding_json_marshal_null_value(dst: Vec<u8>) -> void {
    dst.push(110u8);
    dst.push(117u8);
    dst.push(108u8);
    dst.push(108u8);
    return;
}

// Go's boolEncoder; quoted is the ",string" option.
fn go_encoding_json_marshal_bool_value(dst: Vec<u8>, v: bool, quoted: bool) -> void {
    if quoted {
        dst.push(34u8);
    };
    let b = go_strconv_format_bool(v);
    __go_json_append(dst, b);
    if quoted {
        dst.push(34u8);
    };
    return;
}

// Go's intEncoder; quoted is the ",string" option.
fn go_encoding_json_marshal_int_value(dst: Vec<u8>, v: i64, quoted: bool) -> void {
    if quoted {
        dst.push(34u8);
    };
    let b = go_strconv_format_int(v, 10);
    __go_json_append(dst, b);
    if quoted {
        dst.push(34u8);
    };
    return;
}

// Go's uintEncoder; quoted is the ",string" option.
fn go_encoding_json_marshal_uint_value(dst: Vec<u8>, v: u64, quoted: bool) -> void {
    if quoted {
        dst.push(34u8);
    };
    let b = go_strconv_format_uint(v, 10);
    __go_json_append(dst, b);
    if quoted {
        dst.push(34u8);
    };
    return;
}

// Go's stringEncoder; quoted is the ",string" option
// (double encoding -- see append_string_quoted).
fn go_encoding_json_marshal_string_value(dst: Vec<u8>, v: Vec<u8>, escape_html: bool, quoted: bool) -> void {
    if quoted {
        go_encoding_json_append_string_quoted(dst, v, escape_html);
    } else {
        go_encoding_json_append_string(dst, v, escape_html);
    };
    return;
}

// Go's encodeByteSlice: nil -> null, else a
// base64-encoded string (base64 has no escapable
// bytes, so escape_html does not apply).
fn go_encoding_json_marshal_bytes_value(dst: Vec<u8>, v: Vec<u8>, is_nil: bool) -> void {
    if is_nil {
        go_encoding_json_marshal_null_value(dst);
        return;
    };
    let enc = go_base64_std_encoding();
    let b = go_base64_encode(&enc, v);
    go_encoding_json_append_string(dst, b, true);
    return;
}

// ---------- map key sorting ----------

fn __go_json_less_string_entry(a: &GoJsonStringEntry, b: &GoJsonStringEntry) -> bool {
    return go_bytes_compare(a.k, b.k) < 0;
}

fn __go_json_less_int_entry(a: &GoJsonIntEntry, b: &GoJsonIntEntry) -> bool {
    return go_bytes_compare(a.k, b.k) < 0;
}

fn __go_json_less_bool_entry(a: &GoJsonBoolEntry, b: &GoJsonBoolEntry) -> bool {
    return go_bytes_compare(a.k, b.k) < 0;
}

// Go sorts map keys (by the unescaped key string)
// before writing them. These sort the entries vec
// in place; the marshal entry points below call
// them, so callers pass a working copy.
fn go_encoding_json_sort_string_entries(v: &Vec<GoJsonStringEntry>) -> void {
    go_sort_vec(v, __go_json_less_string_entry);
    return;
}

fn go_encoding_json_sort_int_entries(v: &Vec<GoJsonIntEntry>) -> void {
    go_sort_vec(v, __go_json_less_int_entry);
    return;
}

fn go_encoding_json_sort_bool_entries(v: &Vec<GoJsonBoolEntry>) -> void {
    go_sort_vec(v, __go_json_less_bool_entry);
    return;
}

// ---------- Marshal: complete concrete paths (layer B) ----------

// Go's Marshal for a bool: "true" / "false".
fn go_encoding_json_marshal_bool(v: bool) -> GoJsonBytes {
    let b = Vec::new();
    go_encoding_json_marshal_bool_value(b, v, false);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for an int.
fn go_encoding_json_marshal_int(v: i64) -> GoJsonBytes {
    let b = Vec::new();
    go_encoding_json_marshal_int_value(b, v, false);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a uint.
fn go_encoding_json_marshal_uint(v: u64) -> GoJsonBytes {
    let b = Vec::new();
    go_encoding_json_marshal_uint_value(b, v, false);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a string (escapeHTML on, the
// Marshal default).
fn go_encoding_json_marshal_string(v: Vec<u8>) -> GoJsonBytes {
    let b = Vec::new();
    go_encoding_json_marshal_string_value(b, v, true, false);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a string with HTML escaping off
// (the Encoder.SetEscapeHTML(false) shape).
fn go_encoding_json_marshal_string_no_escape_html(v: Vec<u8>) -> GoJsonBytes {
    let b = Vec::new();
    go_encoding_json_marshal_string_value(b, v, false, false);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a []byte (base64 string; nil is
// null -- is_nil is the frontend-held nil-ness).
fn go_encoding_json_marshal_bytes(v: Vec<u8>, is_nil: bool) -> GoJsonBytes {
    let b = Vec::new();
    go_encoding_json_marshal_bytes_value(b, v, is_nil);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// The JSON null literal.
fn go_encoding_json_marshal_null() -> GoJsonBytes {
    let b = Vec::new();
    go_encoding_json_marshal_null_value(b);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a json.Number (a string holding a
// number literal). Empty encodes as "0" (Go's
// compatibility rule); an invalid literal is a
// returned error, not a panic:
// "json: invalid number literal %q".
fn go_encoding_json_marshal_number(v: Vec<u8>) -> GoJsonBytes {
    if len(v) == 0 {
        let b = Vec::new();
        b.push(48u8);
        return GoJsonBytes { b: b, err: go_errors_nil() };
    };
    if !go_encoding_json_is_valid_number(v) {
        let m = Vec::new();
        __go_json_msg_invalid_number(m);
        let q = go_strconv_quote(v);
        __go_json_append(m, q);
        return GoJsonBytes { b: Vec::new(), err: go_errors_new(m) };
    };
    let b = Vec::new();
    __go_json_append(b, v);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a []string (nil slice is null).
fn go_encoding_json_marshal_string_slice(v: Vec<Vec<u8>>, is_nil: bool, escape_html: bool) -> GoJsonBytes {
    let b = Vec::new();
    if is_nil {
        go_encoding_json_marshal_null_value(b);
        return GoJsonBytes { b: b, err: go_errors_nil() };
    };
    go_encoding_json_marshal_begin_array(b);
    let i = 0;
    while i < len(v) {
        go_encoding_json_marshal_sep(b, i == 0);
        go_encoding_json_marshal_string_value(b, v[i], escape_html, false);
        i = i + 1;
    }
    go_encoding_json_marshal_end_array(b);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a []int.
fn go_encoding_json_marshal_int_slice(v: Vec<i64>, is_nil: bool) -> GoJsonBytes {
    let b = Vec::new();
    if is_nil {
        go_encoding_json_marshal_null_value(b);
        return GoJsonBytes { b: b, err: go_errors_nil() };
    };
    go_encoding_json_marshal_begin_array(b);
    let i = 0;
    while i < len(v) {
        go_encoding_json_marshal_sep(b, i == 0);
        go_encoding_json_marshal_int_value(b, v[i], false);
        i = i + 1;
    }
    go_encoding_json_marshal_end_array(b);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a []bool.
fn go_encoding_json_marshal_bool_slice(v: Vec<bool>, is_nil: bool) -> GoJsonBytes {
    let b = Vec::new();
    if is_nil {
        go_encoding_json_marshal_null_value(b);
        return GoJsonBytes { b: b, err: go_errors_nil() };
    };
    go_encoding_json_marshal_begin_array(b);
    let i = 0;
    while i < len(v) {
        go_encoding_json_marshal_sep(b, i == 0);
        go_encoding_json_marshal_bool_value(b, v[i], false);
        i = i + 1;
    }
    go_encoding_json_marshal_end_array(b);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a map[string]string: keys sorted,
// nil map is null. Entries are sorted in place (see
// the sort helpers' note).
fn go_encoding_json_marshal_string_map(v: Vec<GoJsonStringEntry>, is_nil: bool, escape_html: bool) -> GoJsonBytes {
    let b = Vec::new();
    if is_nil {
        go_encoding_json_marshal_null_value(b);
        return GoJsonBytes { b: b, err: go_errors_nil() };
    };
    go_encoding_json_sort_string_entries(&v);
    go_encoding_json_marshal_begin_object(b);
    let i = 0;
    while i < len(v) {
        go_encoding_json_marshal_map_key(b, v[i].k, escape_html, i == 0);
        go_encoding_json_marshal_string_value(b, v[i].v, escape_html, false);
        i = i + 1;
    }
    go_encoding_json_marshal_end_object(b);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a map[string]int.
fn go_encoding_json_marshal_int_map(v: Vec<GoJsonIntEntry>, is_nil: bool, escape_html: bool) -> GoJsonBytes {
    let b = Vec::new();
    if is_nil {
        go_encoding_json_marshal_null_value(b);
        return GoJsonBytes { b: b, err: go_errors_nil() };
    };
    go_encoding_json_sort_int_entries(&v);
    go_encoding_json_marshal_begin_object(b);
    let i = 0;
    while i < len(v) {
        go_encoding_json_marshal_map_key(b, v[i].k, escape_html, i == 0);
        go_encoding_json_marshal_int_value(b, v[i].v, false);
        i = i + 1;
    }
    go_encoding_json_marshal_end_object(b);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a map[string]bool.
fn go_encoding_json_marshal_bool_map(v: Vec<GoJsonBoolEntry>, is_nil: bool, escape_html: bool) -> GoJsonBytes {
    let b = Vec::new();
    if is_nil {
        go_encoding_json_marshal_null_value(b);
        return GoJsonBytes { b: b, err: go_errors_nil() };
    };
    go_encoding_json_sort_bool_entries(&v);
    go_encoding_json_marshal_begin_object(b);
    let i = 0;
    while i < len(v) {
        go_encoding_json_marshal_map_key(b, v[i].k, escape_html, i == 0);
        go_encoding_json_marshal_bool_value(b, v[i].v, false);
        i = i + 1;
    }
    go_encoding_json_marshal_end_object(b);
    return GoJsonBytes { b: b, err: go_errors_nil() };
}

// Go's Marshal for a RawMessage: nil is null, else
// the raw bytes compacted with HTML escaping on
// (the marshalerEncoder path). A syntax error in the
// raw bytes is a returned error.
fn go_encoding_json_marshal_raw_message(v: Vec<u8>, is_nil: bool) -> GoJsonBytes {
    if is_nil {
        return go_encoding_json_marshal_null();
    };
    let b = Vec::new();
    let err = go_encoding_json_append_compact(b, v, true);
    return GoJsonBytes { b: b, err: err };
}

// ---------- MarshalIndent ----------

// Go's MarshalIndent: Marshal, then Indent. One
// entry point per concrete type in the subset (the
// shared core is __go_json_marshal_indent_bytes).
fn __go_json_marshal_indent_bytes(b: Vec<u8>, prefix: Vec<u8>, indent: Vec<u8>) -> GoJsonBytes {
    let out = Vec::new();
    let err = go_encoding_json_append_indent(out, b, prefix, indent);
    return GoJsonBytes { b: out, err: err };
}

fn go_encoding_json_marshal_indent_bool(v: bool, prefix: Vec<u8>, indent: Vec<u8>) -> GoJsonBytes {
    let m = go_encoding_json_marshal_bool(v);
    if m.err != go_errors_nil() {
        return m;
    };
    return __go_json_marshal_indent_bytes(m.b, prefix, indent);
}

