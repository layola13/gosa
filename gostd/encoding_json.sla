// Go's Unmarshal for a string. checkValid first
// (a syntax error returns before any value is
// stored), then the value dispatch. set is true
// only when a value was actually stored: null and
// type errors leave the target untouched (Go does
// not assign on those), so the frontend assigns v
// only when set is true.
fn go_encoding_json_unmarshal_string(data: Vec<u8>) -> GoJsonStringResult {
    let cv = go_encoding_json_check_valid(data);
    if !cv.ok {
        return GoJsonStringResult { v: Vec::new(), err: cv.err, err_offset: cv.offset, set: false };
    };
    let st = go_encoding_json_decode_new(data);
    go_encoding_json_decode_scan_while(&st, GO_JSON_SCAN_SKIP_SPACE);
    let (item, is_lit) = go_encoding_json_decode_read_scalar(&st, GO_JSON_TYPE_STRING);
    if !is_lit {
        return GoJsonStringResult { v: Vec::new(), err: st.saved_err, err_offset: st.saved_offset, set: false };
    };
    let (v, abort) = go_encoding_json_decode_literal_string(&st, item, false);
    if abort != go_errors_nil() {
        return GoJsonStringResult { v: Vec::new(), err: abort, err_offset: __go_json_decode_read_index(&st), set: false };
    };
    let set = st.saved_err == go_errors_nil();
    if len(item) > 0 {
        if item[0] == 110u8 {
            set = false;
        };
    };
    return GoJsonStringResult { v: v, err: st.saved_err, err_offset: st.saved_offset, set: set };
}

