// ---------- unquote (decode.go) ----------

fn __go_json_hex_val(c: u8) -> i64 {
    let v = c as i64;
    if v >= 48 {
        if v <= 57 {
            return v - 48;
        };
    };
    if v >= 97 {
        if v <= 102 {
            return v - 97 + 10;
        };
    };
    if v >= 65 {
        if v <= 70 {
            return v - 65 + 10;
        };
    };
    return -1;
}

// Go's getu4: decode \uXXXX at s[0:], or -1.
fn __go_json_getu4(s: Vec<u8>) -> i64 {
    if len(s) < 6 {
        return -1;
    };
    if s[0] != 92u8 {
        return -1;
    };
    if s[1] != 117u8 {
        return -1;
    };
    let r = 0;
    let i = 2;
    while i < 6 {
        let v = __go_json_hex_val(s[i]);
        if v == -1 {
            return -1;
        };
        r = r * 16 + v;
        i = i + 1;
    }
    return r;
}

// Go's utf16.DecodeRune: a high surrogate + a low
// surrogate combine; anything else is U+FFFD.
fn __go_json_decode_rune_pair(r1: i64, r2: i64) -> i64 {
    if r1 >= 55296 {
        if r1 <= 56319 {
            if r2 >= 56320 {
                if r2 <= 57343 {
                    return 65536 + ((r1 - 55296) << 10) + (r2 - 56320);
                };
            };
        };
    };
    return 65533;
}

// The JSON null / true / false literals, for the
// literal-store comparisons.
fn __go_json_null_literal() -> Vec<u8> {
    let n = Vec::new();
    n.push(110u8); n.push(117u8); n.push(108u8); n.push(108u8);
    return n;
}

fn __go_json_true_literal() -> Vec<u8> {
    let n = Vec::new();
    n.push(116u8); n.push(114u8); n.push(117u8); n.push(101u8);
    return n;
}

fn __go_json_false_literal() -> Vec<u8> {
    let n = Vec::new();
    n.push(102u8); n.push(97u8); n.push(108u8); n.push(115u8); n.push(101u8);
    return n;
}

// Go's unquoteBytes (decode.go): the unquoted form
// of a quoted JSON string literal, and whether the
// literal was valid. The fast path returns the inner
// slice as-is when there is nothing to unquote.
fn go_encoding_json_unquote_bytes(s: Vec<u8>) -> (Vec<u8>, bool) {
    if len(s) < 2 {
        return (Vec::new(), false);
    };
    if s[0] != 34u8 {
        return (Vec::new(), false);
    };
    if s[len(s) - 1] != 34u8 {
        return (Vec::new(), false);
    };
    let inner = __go_json_slice(s, 1, len(s) - 1);
    let r = 0;
    let fast = true;
    while r < len(inner) {
        let c = inner[r];
        if c == 92u8 {
            fast = false;
            break;
        };
        if c == 34u8 {
            fast = false;
            break;
        };
        if (c as i64) < 32 {
            fast = false;
            break;
        };
        let d = __go_utf8_decode(inner, r);
        if !d.ok {
            fast = false;
            break;
        };
        r = r + d.size;
    }
    if fast {
        return (inner, true);
    };
    let b = Vec::new();
    __go_json_append_range(b, inner, 0, r);
    while r < len(inner) {
        let c = inner[r];
        if c == 92u8 {
            r = r + 1;
            if r >= len(inner) {
                return (Vec::new(), false);
            };
            let e = inner[r];
            if e == 34u8 {
                b.push(34u8);
                r = r + 1;
                continue;
            };
            if e == 92u8 {
                b.push(92u8);
                r = r + 1;
                continue;
            };
            if e == 47u8 {
                b.push(47u8);
                r = r + 1;
                continue;
            };
            if e == 39u8 {
                b.push(39u8);
                r = r + 1;
                continue;
            };
            if e == 98u8 {
                b.push(8u8);
                r = r + 1;
                continue;
            };
            if e == 102u8 {
                b.push(12u8);
                r = r + 1;
                continue;
            };
            if e == 110u8 {
                b.push(10u8);
                r = r + 1;
                continue;
            };
            if e == 114u8 {
                b.push(13u8);
                r = r + 1;
                continue;
            };
            if e == 116u8 {
                b.push(9u8);
                r = r + 1;
                continue;
            };
            if e == 117u8 {
                r = r - 1;
                let rest = __go_json_slice(inner, r, len(inner));
                let rr = __go_json_getu4(rest);
                if rr < 0 {
                    return (Vec::new(), false);
                };
                r = r + 6;
                if rr >= 55296 {
                    if rr <= 57343 {
                        let rest2 = __go_json_slice(inner, r, len(inner));
                        let rr1 = __go_json_getu4(rest2);
                        let dec = __go_json_decode_rune_pair(rr, rr1);
                        if dec != 65533 {
                            r = r + 6;
                            __go_utf8_append(b, dec);
                            continue;
                        };
                        rr = 65533;
                    };
                };
                __go_utf8_append(b, rr);
                continue;
            };
            return (Vec::new(), false);
        };
        if c == 34u8 {
            return (Vec::new(), false);
        };
        if (c as i64) < 32 {
            return (Vec::new(), false);
        };
        if (c as i64) < 128 {
            b.push(c);
            r = r + 1;
            continue;
        };
        let d = __go_utf8_decode(inner, r);
        r = r + d.size;
        __go_utf8_append(b, d.r);
    }
    return (b, true);
}

// Go's unquote: the same, as a string (identical
// here -- gostd strings are byte strings).
fn go_encoding_json_unquote(s: Vec<u8>) -> (Vec<u8>, bool) {
    return go_encoding_json_unquote_bytes(s);
}

// ---------- decode state (decode.go) ----------

// Go's decodeState.init: a fresh state over data.
// THE OBJECT-LOOP RECIPE (frontend-emitted struct
// decode -- the frontend knows the Go struct type
// and emits one loop per struct; this file supplies
// the primitives, not the field list -- seam (g)):
//   st = go_encoding_json_decode_new(data)   (after
//     a checkValid that passed)
//   scan_while(st, SCAN_SKIP_SPACE)
//   if st.opcode == SCAN_BEGIN_OBJECT { ... }   (else
//     the object-loop's type error: skip + save)
//   loop {
//     scan_while(st, SCAN_SKIP_SPACE)
//     if st.opcode == SCAN_END_OBJECT { break }
//     if st.opcode != SCAN_BEGIN_LITERAL { panic(77426) }
//     key_item = read_literal(st)
//     (key, ok) = unquote_bytes(key_item)
//     if !ok { panic(77426) }
//     base = st.err_fields_len; saved_struct = st.err_struct
//     field = <the frontend's resolved field for key,
//       exact match first, then folded match; none
//       means unknown>
//     if field found {
//       st.err_struct = <struct type name>
//       push the field path segments onto
//       st.err_fields (err_fields_len++)
//       if st.disallow_unknown_fields is irrelevant
//     } else {
//       if st.disallow_unknown_fields {
//         save_unknown_field(st, key)
//       }
//     }
//     if st.opcode == SCAN_SKIP_SPACE { scan_while(st, SKIP_SPACE) }
//     if st.opcode != SCAN_OBJECT_KEY { panic(77426) }
//     scan_while(st, SCAN_SKIP_SPACE)
//     <decode the value into the field: read_scalar /
//       read_literal + literal store for scalar
//       fields (destring via from_quoted=true for
//       `,string` fields); recurse the array /
//       object loop for slice / map / nested-struct
//       fields; unknown fields: skip(st)>
//     st.err_fields_len = base; st.err_struct = saved_struct
//     if st.opcode == SCAN_SKIP_SPACE { scan_while(st, SKIP_SPACE) }
//     if st.opcode == SCAN_END_OBJECT { break }
//     if st.opcode != SCAN_OBJECT_VALUE { panic(77426) }
//   }
// An abort error returned by a literal store stops
// the whole unmarshal at once (Go's `return err`
// paths); a saved error (st.saved_err) only records
// the first failure and decoding continues.
fn go_encoding_json_decode_new(data: Vec<u8>) -> GoJsonDecodeState {
    return GoJsonDecodeState {
        data: data,
        off: 0,
        opcode: GO_JSON_SCAN_CONTINUE,
        scan: go_encoding_json_scanner_new(),
        saved_err: go_errors_nil(),
        saved_offset: 0,
        use_number: false,
        disallow_unknown_fields: false,
        err_struct: Vec::new(),
        err_fields: Vec::new(),
        err_fields_len: 0,
    };
}

// Go's decodeState.readIndex: the position of the
// last byte read.
fn __go_json_decode_read_index(st: &GoJsonDecodeState) -> i64 {
    return st.off - 1;
}

fn go_encoding_json_decode_read_index(st: &GoJsonDecodeState) -> i64 {
    return __go_json_decode_read_index(st);
}

// Go's decodeState.saveError: keep the first error.
fn __go_json_decode_save_error(st: &GoJsonDecodeState, err: ptr, offset: i64) -> void {
    if st.saved_err != go_errors_nil() {
        return;
    };
    st.saved_err = err;
    st.saved_offset = offset;
    return;
}

// Build an UnmarshalTypeError message for a value
// code + type code, folding in the decode state's
// error context (Go's addErrorContext): with a
// struct/field context the message names the field
// path, otherwise the plain "into Go value" form.
// has_literal appends " <literal>" after the value
// description (the "number <lit>" overflow form).
fn __go_json_type_error_msg(st: &GoJsonDecodeState, value_code: i64, type_code: i64, literal: Vec<u8>, has_literal: bool) -> Vec<u8> {
    let m = Vec::new();
    __go_json_msg_cannot_unmarshal(m);
    __go_json_append_value_desc(m, value_code);
    if has_literal {
        m.push(32u8);
        __go_json_append(m, literal);
    };
    if len(st.err_struct) > 0 {
        __go_json_msg_into_struct_field(m);
        __go_json_append(m, st.err_struct);
        m.push(46u8);
        let i = 0;
        while i < st.err_fields_len {
            if i > 0 {
                m.push(46u8);
            };
            __go_json_append(m, st.err_fields[i]);
            i = i + 1;
        }
        __go_json_msg_of_type(m);
    } else {
        if st.err_fields_len > 0 {
            __go_json_msg_into_struct_field(m);
            let i = 0;
            while i < st.err_fields_len {
                if i > 0 {
                    m.push(46u8);
                };
                __go_json_append(m, st.err_fields[i]);
                i = i + 1;
            }
            __go_json_msg_of_type(m);
        } else {
            __go_json_msg_into_go_value(m);
        };
    };
    __go_json_append_type_name(m, type_code);
    return m;
}

fn __go_json_decode_save_type_error(st: &GoJsonDecodeState, value_code: i64, type_code: i64, offset: i64) -> void {
    let m = __go_json_type_error_msg(st, value_code, type_code, Vec::new(), false);
    let err = go_encoding_json_type_error(m, offset);
    __go_json_decode_save_error(st, err, offset);
    return;
}

// The "number <literal>" overflow form (int / uint
// literalStore failures).
fn __go_json_decode_save_type_error_number(st: &GoJsonDecodeState, type_code: i64, literal: Vec<u8>, offset: i64) -> void {
    let m = __go_json_type_error_msg(st, GO_JSON_VALUE_NUMBER, type_code, literal, true);
    let err = go_encoding_json_type_error(m, offset);
    __go_json_decode_save_error(st, err, offset);
    return;
}

// Go's ",string" error message (a plain error, no
// target id): "json: invalid use of ,string struct
// tag, trying to unmarshal %q into <type>".
fn __go_json_string_tag_error(item: Vec<u8>, type_code: i64) -> ptr {
    let m = Vec::new();
    __go_json_msg_string_tag(m);
    let q = go_strconv_quote(item);
    __go_json_append(m, q);
    __go_json_msg_into(m);
    __go_json_append_type_name(m, type_code);
    return go_errors_new(m);
}

// The same error, saved into the state (Go's
// saveError paths for ,string misuse).
fn __go_json_decode_save_string_tag_error(st: &GoJsonDecodeState, item: Vec<u8>, type_code: i64) -> void {
    let err = __go_json_string_tag_error(item, type_code);
    __go_json_decode_save_error(st, err, __go_json_decode_read_index(st));
    return;
}

// Go's DisallowUnknownFields error: "json: unknown
// field %q", saved into the state.
fn go_encoding_json_decode_save_unknown_field(st: &GoJsonDecodeState, key: Vec<u8>) -> void {
    let m = Vec::new();
    __go_json_msg_unknown_field(m);
    let q = go_strconv_quote(key);
    __go_json_append(m, q);
    let err = go_errors_new(m);
    __go_json_decode_save_error(st, err, __go_json_decode_read_index(st));
    return;
}

// A literal of the wrong kind for a slice / map /
// struct target (Go's literalStore type errors for
// those targets): bool / string / number by the
// literal's first byte. (null is the caller's case:
// nil slice / map / no effect on scalars.)
fn __go_json_decode_save_literal_type_error(st: &GoJsonDecodeState, item: Vec<u8>, type_code: i64) -> void {
    if len(item) == 0 {
        return;
    };
    let c = item[0];
    if c == 116u8 {
        __go_json_decode_save_type_error(st, GO_JSON_VALUE_BOOL, type_code, __go_json_decode_read_index(st));
        return;
    };
    if c == 102u8 {
        __go_json_decode_save_type_error(st, GO_JSON_VALUE_BOOL, type_code, __go_json_decode_read_index(st));
        return;
    };
    if c == 34u8 {
        __go_json_decode_save_type_error(st, GO_JSON_VALUE_STRING, type_code, __go_json_decode_read_index(st));
        return;
    };
    __go_json_decode_save_type_error(st, GO_JSON_VALUE_NUMBER, type_code, __go_json_decode_read_index(st));
    return;
}

// Push one field-path segment onto the decode
// state's error context (the logical-length stack
// rule: overwrite a stale slot past the length, or
// append). The frontend calls this per struct field
// (see the object-loop recipe on decode_new).
fn go_encoding_json_decode_push_field(st: &GoJsonDecodeState, name: Vec<u8>) -> void {
    if st.err_fields_len < len(st.err_fields) {
        st.err_fields[st.err_fields_len] = name;
    } else {
        st.err_fields.push(name);
    };
    st.err_fields_len = st.err_fields_len + 1;
    return;
}

// ---------- decode primitives (decode.go) ----------

// Go's decodeState.scanWhile(op).
fn go_encoding_json_decode_scan_while(st: &GoJsonDecodeState, op: i64) -> void {
    let i = st.off;
    while i < len(st.data) {
        let new_op = __go_json_scan_step(&st.scan, st.data[i]);
        i = i + 1;
        if new_op != op {
            st.opcode = new_op;
            st.off = i;
            return;
        };
    }
    st.off = len(st.data) + 1;
    st.opcode = go_encoding_json_scanner_eof(&st.scan);
    return;
}

// Go's decodeState.scanNext.
fn go_encoding_json_decode_scan_next(st: &GoJsonDecodeState) -> void {
    if st.off < len(st.data) {
        st.opcode = __go_json_scan_step(&st.scan, st.data[st.off]);
        st.off = st.off + 1;
    } else {
        st.opcode = go_encoding_json_scanner_eof(&st.scan);
        st.off = len(st.data) + 1;
    };
    return;
}

// Go's decodeState.skip: step until the parse depth
// drops below the entry depth. Unreachable after
// checkValid (the value is well-formed, so its
// closing bracket exists); the 77426 backstop keeps
// a corrupt buffer from looping forever.
fn go_encoding_json_decode_skip(st: &GoJsonDecodeState) -> void {
    let depth = st.scan.depth;
    let i = st.off;
    while i < len(st.data) {
        let op = __go_json_scan_step(&st.scan, st.data[i]);
        i = i + 1;
        if st.scan.depth < depth {
            st.off = i;
            st.opcode = op;
            return;
        };
    }
    panic(77426);
}

// Go's decodeState.rescanLiteral: from d.off, scan
// to the literal's end and read one byte ahead
// (the opcode is the state the byte after the
// literal produces).
fn __go_json_decode_rescan_literal(st: &GoJsonDecodeState) -> void {
    let data = st.data;
    let i = st.off;
    let first = data[i - 1];
    if first == 34u8 {
        let done = false;
        while i < len(data) {
            if done {
                break;
            };
            let c = data[i];
            if c == 92u8 {
                i = i + 2;
                continue;
            };
            if c == 34u8 {
                i = i + 1;
                done = true;
                continue;
            };
            i = i + 1;
        }
    } else {
        if first == 116u8 {
            i = i + 3;
        } else {
            if first == 102u8 {
                i = i + 4;
            } else {
                if first == 110u8 {
                    i = i + 3;
                } else {
                    while i < len(data) {
                        let c = data[i];
                        if __go_json_is_digit(c) {
                            i = i + 1;
                            continue;
                        };
                        if c == 46u8 {
                            i = i + 1;
                            continue;
                        };
                        if c == 101u8 {
                            i = i + 1;
                            continue;
                        };
                        if c == 69u8 {
                            i = i + 1;
                            continue;
                        };
                        if c == 43u8 {
                            i = i + 1;
                            continue;
                        };
                        if c == 45u8 {
                            i = i + 1;
                            continue;
                        };
                        break;
                    }
                };
            };
        };
    };
    if i < len(data) {
        st.opcode = __go_json_state_end_value(&st.scan, data[i]);
    } else {
        st.opcode = GO_JSON_SCAN_END;
    };
    st.off = i + 1;
    return;
}

// Go's rescanLiteral + the slice it yields: the
// literal bytes (including the closing quote for
// strings). Call only when st.opcode is
// scanBeginLiteral.
fn go_encoding_json_decode_read_literal(st: &GoJsonDecodeState) -> Vec<u8> {
    let start = __go_json_decode_read_index(st);
    __go_json_decode_rescan_literal(st);
    let end = __go_json_decode_read_index(st);
    return __go_json_slice(st.data, start, end);
}

// Read one JSON value for a SCALAR target (Go's
// d.value for a scalar): a literal is rescanned and
// returned with true; an array / object is skipped,
// a type error is saved, and false is returned (the
// caller keeps the zero value); any other opcode is
// the phase panic backstop (77426). type_code names
// the target for the type error. The offset for the
// composite type error is st.off at entry (Go's
// d.off in array() / object()).
fn go_encoding_json_decode_read_scalar(st: &GoJsonDecodeState, type_code: i64) -> (Vec<u8>, bool) {
    let off = st.off;
    if st.opcode == GO_JSON_SCAN_BEGIN_LITERAL {
        let item = go_encoding_json_decode_read_literal(st);
        return (item, true);
    };
    if st.opcode == GO_JSON_SCAN_BEGIN_ARRAY {
        go_encoding_json_decode_skip(st);
        __go_json_decode_save_type_error(st, GO_JSON_VALUE_ARRAY, type_code, off);
        go_encoding_json_decode_scan_next(st);
        return (Vec::new(), false);
    };
    if st.opcode == GO_JSON_SCAN_BEGIN_OBJECT {
        go_encoding_json_decode_skip(st);
        __go_json_decode_save_type_error(st, GO_JSON_VALUE_OBJECT, type_code, off);
        go_encoding_json_decode_scan_next(st);
        return (Vec::new(), false);
    };
    panic(77426);
}

// ---------- literal stores (decode.go literalStore) ----------
//
// Each store decodes one literal (item) into a
// concrete target kind and returns (value, abort):
// abort is a plain error that must stop the whole
// unmarshal at once (Go's `return fmt.Errorf(...)`
// paths for ,string misuse); a type mismatch is
// SAVED into the state instead (Go's saveError),
// and decoding continues. from_quoted is the
// ",string" case (the item is the unwrapped string
// content, not a quoted literal).

// Go's literalStore for a string target.
fn go_encoding_json_decode_literal_string(st: &GoJsonDecodeState, item: Vec<u8>, from_quoted: bool) -> (Vec<u8>, ptr) {
    if len(item) == 0 {
        __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_STRING);
        return (Vec::new(), go_errors_nil());
    };
    let c = item[0];
    if c == 110u8 {
        if from_quoted {
            let n = __go_json_null_literal();
            if !__go_json_bytes_eq(item, n) {
                __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_STRING);
            };
        };
        return (Vec::new(), go_errors_nil());
    };
    if c == 116u8 {
        if from_quoted {
            __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_STRING);
        } else {
            __go_json_decode_save_type_error(st, GO_JSON_VALUE_BOOL, GO_JSON_TYPE_STRING, __go_json_decode_read_index(st));
        };
        return (Vec::new(), go_errors_nil());
    };
    if c == 102u8 {
        if from_quoted {
            __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_STRING);
        } else {
            __go_json_decode_save_type_error(st, GO_JSON_VALUE_BOOL, GO_JSON_TYPE_STRING, __go_json_decode_read_index(st));
        };
        return (Vec::new(), go_errors_nil());
    };
    if c == 34u8 {
        let (s, ok) = go_encoding_json_unquote_bytes(item);
        if !ok {
            if from_quoted {
                return (Vec::new(), __go_json_string_tag_error(item, GO_JSON_TYPE_STRING));
            };
            panic(77426);
        };
        return (s, go_errors_nil());
    };
    if from_quoted {
        return (Vec::new(), __go_json_string_tag_error(item, GO_JSON_TYPE_STRING));
    };
    __go_json_decode_save_type_error(st, GO_JSON_VALUE_NUMBER, GO_JSON_TYPE_STRING, __go_json_decode_read_index(st));
    return (Vec::new(), go_errors_nil());
}

// Go's literalStore for an int target.
fn go_encoding_json_decode_literal_int(st: &GoJsonDecodeState, item: Vec<u8>, from_quoted: bool) -> (i64, ptr) {
    if len(item) == 0 {
        __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_INT);
        return (0, go_errors_nil());
    };
    let c = item[0];
    if c == 110u8 {
        if from_quoted {
            let n = __go_json_null_literal();
            if !__go_json_bytes_eq(item, n) {
                __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_INT);
            };
        };
        return (0, go_errors_nil());
    };
    if c == 116u8 {
        if from_quoted {
            __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_INT);
        } else {
            __go_json_decode_save_type_error(st, GO_JSON_VALUE_BOOL, GO_JSON_TYPE_INT, __go_json_decode_read_index(st));
        };
        return (0, go_errors_nil());
    };
    if c == 102u8 {
        if from_quoted {
            __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_INT);
        } else {
            __go_json_decode_save_type_error(st, GO_JSON_VALUE_BOOL, GO_JSON_TYPE_INT, __go_json_decode_read_index(st));
        };
        return (0, go_errors_nil());
    };
    if c == 34u8 {
        let (_s, ok) = go_encoding_json_unquote_bytes(item);
        if !ok {
            if from_quoted {
                return (0, __go_json_string_tag_error(item, GO_JSON_TYPE_INT));
            };
            panic(77426);
        };
        __go_json_decode_save_type_error(st, GO_JSON_VALUE_STRING, GO_JSON_TYPE_INT, __go_json_decode_read_index(st));
        return (0, go_errors_nil());
    };
    if c != 45u8 {
        if c < 48u8 {
            if from_quoted {
                return (0, __go_json_string_tag_error(item, GO_JSON_TYPE_INT));
            };
            panic(77426);
        };
        if c > 57u8 {
            if from_quoted {
                return (0, __go_json_string_tag_error(item, GO_JSON_TYPE_INT));
            };
            panic(77426);
        };
    };
    let conv = go_strconv_parse_int(item, 10, 64);
    if conv.err != go_errors_nil() {
        __go_json_decode_save_type_error_number(st, GO_JSON_TYPE_INT, item, __go_json_decode_read_index(st));
        return (0, go_errors_nil());
    };
    return (conv.v, go_errors_nil());
}

// Go's literalStore for a uint target.
fn go_encoding_json_decode_literal_uint(st: &GoJsonDecodeState, item: Vec<u8>, from_quoted: bool) -> (u64, ptr) {
    if len(item) == 0 {
        __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_UINT);
        return (0 as u64, go_errors_nil());
    };
    let c = item[0];
    if c == 110u8 {
        if from_quoted {
            let n = __go_json_null_literal();
            if !__go_json_bytes_eq(item, n) {
                __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_UINT);
            };
        };
        return (0 as u64, go_errors_nil());
    };
    if c == 116u8 {
        if from_quoted {
            __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_UINT);
        } else {
            __go_json_decode_save_type_error(st, GO_JSON_VALUE_BOOL, GO_JSON_TYPE_UINT, __go_json_decode_read_index(st));
        };
        return (0 as u64, go_errors_nil());
    };
    if c == 102u8 {
        if from_quoted {
            __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_UINT);
        } else {
            __go_json_decode_save_type_error(st, GO_JSON_VALUE_BOOL, GO_JSON_TYPE_UINT, __go_json_decode_read_index(st));
        };
        return (0 as u64, go_errors_nil());
    };
    if c == 34u8 {
        let (_s, ok) = go_encoding_json_unquote_bytes(item);
        if !ok {
            if from_quoted {
                return (0 as u64, __go_json_string_tag_error(item, GO_JSON_TYPE_UINT));
            };
            panic(77426);
        };
        __go_json_decode_save_type_error(st, GO_JSON_VALUE_STRING, GO_JSON_TYPE_UINT, __go_json_decode_read_index(st));
        return (0 as u64, go_errors_nil());
    };
    if c != 45u8 {
        if c < 48u8 {
            if from_quoted {
                return (0 as u64, __go_json_string_tag_error(item, GO_JSON_TYPE_UINT));
            };
            panic(77426);
        };
        if c > 57u8 {
            if from_quoted {
                return (0 as u64, __go_json_string_tag_error(item, GO_JSON_TYPE_UINT));
            };
            panic(77426);
        };
    };
    let conv = go_strconv_parse_uint(item, 10, 64);
    if conv.err != go_errors_nil() {
        __go_json_decode_save_type_error_number(st, GO_JSON_TYPE_UINT, item, __go_json_decode_read_index(st));
        return (0 as u64, go_errors_nil());
    };
    return (conv.v, go_errors_nil());
}

// Go's literalStore for a bool target.
fn go_encoding_json_decode_literal_bool(st: &GoJsonDecodeState, item: Vec<u8>, from_quoted: bool) -> (bool, ptr) {
    if len(item) == 0 {
        __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_BOOL);
        return (false, go_errors_nil());
    };
    let c = item[0];
    if c == 110u8 {
        if from_quoted {
            let n = __go_json_null_literal();
            if !__go_json_bytes_eq(item, n) {
                __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_BOOL);
            };
        };
        return (false, go_errors_nil());
    };
    if c == 116u8 {
        if from_quoted {
            let t = __go_json_true_literal();
            if !__go_json_bytes_eq(item, t) {
                __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_BOOL);
                return (false, go_errors_nil());
            };
        };
        return (true, go_errors_nil());
    };
    if c == 102u8 {
        if from_quoted {
            let f = __go_json_false_literal();
            if !__go_json_bytes_eq(item, f) {
                __go_json_decode_save_string_tag_error(st, item, GO_JSON_TYPE_BOOL);
                return (false, go_errors_nil());
            };
        };
        return (false, go_errors_nil());
    };
    if c == 34u8 {
        let (_s, ok) = go_encoding_json_unquote_bytes(item);
        if !ok {
            if from_quoted {
                return (false, __go_json_string_tag_error(item, GO_JSON_TYPE_BOOL));
            };
            panic(77426);
        };
        __go_json_decode_save_type_error(st, GO_JSON_VALUE_STRING, GO_JSON_TYPE_BOOL, __go_json_decode_read_index(st));
        return (false, go_errors_nil());
    };
    if from_quoted {
        return (false, __go_json_string_tag_error(item, GO_JSON_TYPE_BOOL));
    };
    __go_json_decode_save_type_error(st, GO_JSON_VALUE_NUMBER, GO_JSON_TYPE_BOOL, __go_json_decode_read_index(st));
    return (false, go_errors_nil());
}

// Go's literalStore for a []byte target (a base64
// string, or null for nil). Returns (bytes, is_nil,
// abort).
