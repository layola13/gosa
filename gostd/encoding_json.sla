// gostd encoding/json: the SLA-side model of Go's encoding/json
// package (v1 API; jsontext / v2 are separate packages, CENSUS-170
// section 7.2.2, not here).
//
// Oracle: Go 1.27.2 stdlib src/encoding/json/*.go, read 2026-11-27:
//   encode.go (1344 lines), decode.go (1302), stream.go (526),
//   scanner.go (612), indent.go (184), fold.go (50), tables.go
//   (220), tags.go (40). Census: CENSUS-170.md rev1 section 7.2.1,
//   wave 1b, prerequisite: the encoding package interfaces first.
//
// Organisation follows the psa_std / gostd precedent: one .sla
// file per Go package, public entry points go_<pkg>_<name>,
// private helpers __go_<pkg>_<name>, panic codes listed up
// front, loud refusals instead of silent approximations.
// Strings are Vec<u8> everywhere. Splice position: encoding/json
// sits AFTER the existing 21-file splice order (errors, math,
// strconv, strings, fmt, sync, time, sort, runtime, io, bytes,
// hash, crc32, fnv, base64, hex, utf8, path, flag, bufio, log,
// context) as file 22, at the end, so the existing order is
// untouched and every cross-file call below is satisfied by an
// earlier file. Nothing in this file is called by an earlier
// file, so no forward reference is introduced.
//
// Cross-file dependencies (all in earlier splice files):
//   errors.sla  go_errors_nil / go_errors_new /
//               go_errors_new_with_id (sentinel errors)
//   strconv.sla go_strconv_format_int / format_uint /
//               format_bool / parse_int / parse_uint /
//               parse_bool / quote (scalar text, number
//               parsing, %q quoting) and the private
//               __go_utf8_decode / __go_utf8_append
//               (UTF-8 decode/encode at an offset --
//               bufio.sla calls the same two private
//               helpers, so this is the established
//               precedent, not a new reach)
//   strings.sla the private __go_str_simple_fold (foldName
//               -- fmt.sla calls strconv's private
//               helpers the same way) and GosBuilder +
//               go_strings_builder_write_string (the
//               io.Writer model at this surface, fmt
//               precedent: an Encoder writes into a
//               caller-held builder)
//   sort.sla    go_sort_strings (map key sorting) and
//               go_sort_vec with a named comparator
//               (entry sorting; passing a named fn as
//               the comparator is sort.sla's own shape)
//   bytes.sla   go_bytes_compare (entry key ordering)
//   base64.sla  go_base64_std_encoding / go_base64_encode
//               / go_base64_decode ([]byte as base64)
//   io.sla      go_io_eof / go_io_err_unexpected_eof
//               (streaming Decoder EOF errors)
// No call is made to fmt, time, sync, runtime, math, hash,
// crc32, fnv, hex, utf8.sla, path, flag, bufio, log or
// context: the scanner, string escaping and number handling
// here are self-contained (the utf8.sla package is not
// needed because strconv's private UTF-8 helpers cover
// the offset-decode shape this file needs).
//
// VALUE REPRESENTATION (gostd contract):
//   Go string            -> Vec<u8>
//   Go []byte            -> Vec<u8>
//   Go error             -> GosError heap ptr (errors.sla)
//   Go int64             -> i64
//   Go uint64            -> u64
//   Go bool              -> bool
//   Go (T, error)        -> a result struct { v, err,
//                           err_offset, set[, is_nil] }
//                           named per family
//                           (GoJsonStringResult, ...).
//                           set is true only when Go
//                           actually stored a value
//                           (null and type errors
//                           leave the target
//                           untouched); is_nil, on
//                           slice / map / []byte
//                           results, reports the JSON
//                           null (nil, not empty).
//   Go map[string]T      -> Vec<GoJsonXEntry> (SLA has no
//                           map type; entries in JSON order
//                           for decode, sorted by key for
//                           encode; the frontend inserts
//                           them into the Go map, so later
//                           duplicate keys win, as in Go)
//   Go nil slice / map   -> is_nil: bool on the slice/map
//                           result structs (a Vec<u8> cannot
//                           tell nil from empty; the
//                           frontend holds nil-ness, as it
//                           does for the []byte argument of
//                           go_encoding_json_marshal_bytes)
//   Go json.Number       -> Vec<u8> holding the literal
//
// THE CONCRETE-TYPE MODEL. There is no reflection surface
// in gostd (base gap, CENSUS-170 section 8), so this file
// cannot implement Marshal(v any) / Unmarshal(data, v any)
// over an arbitrary value. It implements the concrete-type
// generation paths instead, in three layers:
//
//   (A) PRIMITIVES the frontend-emitted concrete code
//       calls: the scanner state machine
//       (GoJsonScanner + go_encoding_json_scan_step),
//       checkValid / Valid, appendString / quote,
//       HTMLEscape / Compact / Indent, parseTag /
//       tagOptions.Contains, foldName, isValidNumber,
//       unquoteBytes, the decode-state machine
//       (GoJsonDecodeState + scan/skip/rescan/literal
//       primitives), and the marshal framing helpers
//       (array / object / field / map-key begin-sep-end).
//       The frontend emits one concrete marshal /
//       unmarshal routine per Go type and calls these
//       primitives for every leaf and every punctuation
//       byte; the per-type routine is ordinary emitted
//       SLA, not a value in this file.
//
//   (B) COMPLETE CONCRETE PATHS for the census subset,
//       usable directly and as the worked reference for
//       layer (A): Marshal / Unmarshal (+ MarshalIndent)
//       for string, int (i64), uint (u64), bool, []byte
//       (base64), json.Number, []string, []int, []bool,
//       map[string]string, map[string]int,
//       map[string]bool, and the streaming Encoder /
//       Decoder over a byte buffer for those same types
//       (+ Token / More / InputOffset / Buffered).
//
//   (C) STRUCTS are frontend-emitted: the field list,
//       tags and fold matching come from the frontend's
//       knowledge of the Go struct type. This file gives
//       the struct routine everything it needs: field
//       framing (go_encoding_json_marshal_field),
//       tag parsing (go_encoding_json_parse_tag,
//       go_encoding_json_tag_contains,
//       go_encoding_json_is_valid_tag),
//       case-insensitive matching
//       (go_encoding_json_field_name_matches, built on
//       foldName), omitempty / omitzero emptiness
//       (go_encoding_json_is_empty_* -- in this subset
//       omitzero is the same test as omitempty: the
//       zero value is the empty value for string / int
//       / bool / slice / map), the ,string quoted
//       scalar forms
//       (go_encoding_json_append_string_quoted and the
//       decode literal helpers' from_quoted flag), and
//       the decode-state primitives for the object loop
//       (scan_while / scan_next / skip / read_literal /
//       literal stores). The object-loop recipe is
//       spelled out in the comment on
//       go_encoding_json_decode_new. The frontend must
//       NOT invent struct handling anywhere else.
//
// Panic codes (gostd block 77400-77499; this file):
//   77425  json marshal of an unsupported type -- any /
//          interface{} / generic reflection-style encode,
//          float (float not landed yet), chan / func /
//          complex, or any other type outside the 1b
//          concrete-type subset. The frontend refuses
//          these at the call site; this code is the
//          loud backstop (go_encoding_json_refuse_
//          marshal), never a silent null.
//   77426  json unmarshal type mismatch / invalid syntax
//          backstop -- a float target, an any /
//          interface{} target, a value the decoder's
//          phase checks prove unreachable after
//          checkValid, or a frontend-emitted decode
//          hitting a scanner opcode the oracle's
//          phasePanicMsg covers. The frontend refuses
//          out-of-subset targets at the call site; this
//          code is the loud backstop
//          (go_encoding_json_refuse_unmarshal).
// No other code in this file panics. (77401 errors,
// 77402/77403 io/bufio, 77410-77413 sync, 77415 bufio,
// 77416/77417 strings, 77418 context, 77420/77421 +
// 77423 time, 77422/77424 log, 77430-77439 sort reserved,
// 77440-77442 runtime, 77446/77447 fmt, 77451/77452 math
// are all other files' -- verified free by grep over
// wave1a/ + wave1a-sunny/ + census/ + the staging gostd/
// dir on 2026-11-27; no collision.)
//
// Error sentinels (target ids; errors.sla reserves the
// 900000-999999 range for gostd sentinel ids):
//   900036 json SyntaxError (go_errors_new_with_id)
//   900037 json UnmarshalTypeError (go_errors_new_with_id)
// Compare sentinels through errors.Is (target id),
// never by pointer equality. A SyntaxError's Offset is
// NOT carried in the GosError (it has no offset field):
// every result struct in this file carries err_offset
// alongside err, and checkValid returns it in
// GoJsonValidResult.offset. The message text is Go's
// SyntaxError message verbatim.
//
// THE SEAMS -- integration checks, one per item the
// task brief names. None of these is decided silently
// inside this file; each names the party that must
// confirm it at integration time.
//
// (a) ENCODING INTERFACES. The encoding package
//     interfaces (BinaryMarshaler, TextMarshaler,
//     BinaryUnmarshaler, TextUnmarshaler -- the
//     `encoding` package, CENSUS-170 section 7.2.2)
//     are NOT yet written, so this file cannot check
//     "does this type implement Marshaler" the way
//     Go's newTypeEncoder does. The hooks are modelled
//     as FRONTEND-EMITTED functions, following the
//     fmt go_host_write_stdout / log go_log_caller
//     precedent: when the frontend knows a concrete
//     type implements json.Marshaler /
//     encoding.TextMarshaler (or the Unmarshaler
//     counterparts), it emits a call to that type's
//     hook and feeds the hook's bytes through
//     go_encoding_json_append_compact (MarshalJSON
//     output, escapeHTML on) or
//     go_encoding_json_append_string (MarshalText
//     output, as a JSON string). Until the encoding
//     package lands, a type the frontend cannot prove
//     implements a hook is marshaled by its concrete
//     default encoding. The MarshalerError shape
//     ("json: error calling MarshalJSON for type ...")
//     is therefore a frontend error, not one this
//     file can construct (it has no type names).
//
// (b) STREAMING / io.Reader + io.Writer. Encoder /
//     Decoder are modelled as state machines over a
//     byte buffer: GoJsonEncoder writes into a
//     caller-held GosBuilder (the fmt precedent -- an
//     io.Writer at this surface), GoJsonDecoder reads
//     from a Vec<u8> buffer the frontend feeds with
//     go_encoding_json_decoder_feed. The actual
//     io.Reader / io.Writer binding -- refilling the
//     buffer from a reader, flushing the builder to
//     a writer -- is FRONTEND work. Consequence, named
//     here: the decoder never slides its buffer down
//     (SLA has no Vec truncate), so scanp is an
//     absolute offset, scanned stays 0, and the buffer
//     grows by every fed chunk for the decoder's
//     lifetime; the frontend rebuilds the decoder if
//     a long-lived stream's buffer growth matters.
//     InputOffset() stays exact (scanned + scanp).
//
// (c) FLOAT. Float32 / float64 are OUT of wave 1b
//     (float not landed yet). Any float value or
//     target is a loud refusal: marshal panics 77425,
//     unmarshal panics 77426 (helpers
//     go_encoding_json_refuse_marshal /
//     go_encoding_json_refuse_unmarshal). The number
//     grammar in the scanner still accepts floats
//     (the scanner is syntax, not values), and
//     Token returns a JSON number as its raw literal
//     text (see the Token divergence below) so a
//     float literal is observable, just not decoded
//     into a float. When float lands, the float
//     encoder (Go's floatEncoder: 'f' vs 'e' by
//     magnitude, strconv FormatFloat -1, e-09 -> e-9
//     cleanup) and literalStore float case belong in
//     this file behind the same helpers.
//
// (d) ANY / INTERFACE{}. Decoding into any (Go's
//     valueInterface / arrayInterface / objectInterface
//     -- bool / float64 / string / []any /
//     map[string]any / nil) is OUT (no reflection
//     surface, no any value in SLA). Marshal of an
//     any value and Unmarshal into an any target are
//     loud refusals (77425 / 77426). The frontend
//     must never emit a call into this file for an
//     any-typed value; the refusal helpers exist so
//     a missed call fails loudly instead of
//     producing a wrong null.
//
// (e) NO MUTABLE GLOBALS. SLA has no mutable globals
//     (verified: no top-level static/let in sa_std or
//     the gostd corpus), so there is no scanner pool,
//     no encodeState pool and no type-field cache in
//     this file. Every scanner, decode state, encoder
//     and decoder is a value the caller creates and
//     holds. Field metadata (tag parsing, fold
//     indexes) is recomputed per call by the
//     frontend-emitted struct routine; the cost is
//     the frontend's to weigh, not a silent cache.
//
// (f) CYCLES. Go detects marshal cycles after 1000
//     nested pointers (startDetectingCyclesAfter) and
//     returns UnsupportedValueError. The concrete
//     paths in this file cannot cycle: a concrete
//     value is a finite tree of Vecs (slices and
//     maps-as-entry-vecs cannot alias themselves in
//     SLA the way Go pointers can), so no cycle
//     check is needed and none is implemented. If a
//     future pointer surface ever lets a concrete
//     value alias itself, the check belongs with
//     that surface, not here.
//
// (g) STRUCT FIELD RULES the frontend must implement
//     (this file supplies the primitives, not the
//     decisions): embedded-field promotion and the
//     dominant-field rules (Go typeFields), the
//     "tag wins, then shallowest, then first index"
//     ordering, unexported-field skipping, and the
//     anonymous-struct flattening walk. The frontend
//     knows the Go struct type; it emits the resolved
//     field list (name, tag options, quoted flag,
//     omitEmpty / omitZero) and calls
//     go_encoding_json_marshal_field / the decode
//     primitives per field. This file does NOT
//     re-derive field lists from a type.
//
// DIVERGENCES (all deliberate, all noted here):
//   - SyntaxError offsets ride in result structs, not
//     in the GosError (see the sentinel note above).
//   - Decoder.Token returns a JSON number as its raw
//     literal text (GoJsonToken.num), not a float64:
//     float is not landed. The token kind is
//     GO_JSON_TOKEN_NUMBER either way; when float
//     lands, Token should decode the literal into
//     an f64 alongside the raw text.
//   - Decoder.UseNumber has no effect in wave 1b: it
//     only changes decoding into any, which is out.
//     The flag is carried on the decode state so the
//     call exists and is a no-op, not a missing API.
//   - UnmarshalTypeError messages name the Go type
//     statically per entry point ("string", "int",
//     "[]string", "map[string]int", ...): this file
//     has no reflect.Type to render, so the type
//     name is a constant chosen by the function, not
//     a computed string. Struct-field errors name
//     the field path from the decode state's error
//     context, exactly like Go's errorContext.
//   - The ,string error message renders the item
//     with strconv.Quote (Go's %q) and the type name
//     statically, as above.
//   - Compact / Indent leave dst untouched on error
//     (Go returns dst[:origLen], which is the same
//     observable effect; SLA has no Vec truncate,
//     so the work is done in a temp vec and appended
//     only on success).
//   - isValidTag treats a non-ASCII rune as a letter:
//     Go uses unicode.IsLetter, which needs unicode
//     tables this file does not carry. The only
//     divergence is non-ASCII non-letters (e.g. '«',
//     '¡'), which Go rejects and this file accepts
//     as a tag name.
//   - The scanner's step is an i64 state code, not a
//     Go func value: SLA has no fn_ptr values for
//     closures (S3, RULING-EXEC-170.md section 3),
//     and a scanner step is a state, not a thread, so
//     the dispatch is an if-chain over state codes in
//     __go_json_scan_step. The transition table is
//     Go's scanner.go verbatim, code for code.
//   - Decoder never slides its buffer (seam (b)).
//   - Marshal of an unsupported type panics 77425
//     instead of returning UnsupportedTypeError, and
//     unmarshal into an unsupported target panics
//     77426 instead of returning InvalidUnmarshalError
//     / UnmarshalTypeError: the frontend refuses
//     out-of-subset types at the call site, and these
//     codes are the loud backstop. The error-returning
//     Go shapes remain available for in-subset
//     failures (syntax errors, type mismatches on
//     concrete values, invalid Number literals).
//   - json.Number's zero value ("") marshals as "0"
//     (Go compatibility rule, encode.go stringEncoder).
//   - No HTML escaping is applied to map keys beyond
//     the string escaping every string gets: Go sorts
//     map keys by the UNESCAPED key string and escapes
//     on write, which is what the entry sort + field
//     writer here do.
//
// LOUD REFUSALS (every gap in this file panics with a
// claimed code; nothing is a silent stub):
//   77425  marshal of an unsupported type (any /
//          interface{} / float / chan / func / complex
//          / reflection-style encode)
//   77426  unmarshal into an unsupported target, and
//          the decoder phase-panic backstop
//          (unreachable after checkValid)
// All other entry points are implemented for the 1b
// concrete-type subset. What is NOT in this file
// (out of the census scope for encoding/json):
// encoding/json/jsontext and encoding/json/v2
// (section 7.2.2), the encoding package interfaces
// (seam (a)), float encode/decode (seam (c)), and
// any / interface{} decode (seam (d)).
//
// Nothing in this file has been compiled or tested
// (write-first batch; the debug phase is separate).

@import "sa_std/vec.sa"

// ---------- scan opcodes (scanner.go const block) ----------

const GO_JSON_SCAN_CONTINUE: i64 = 0;
const GO_JSON_SCAN_BEGIN_LITERAL: i64 = 1;
const GO_JSON_SCAN_BEGIN_OBJECT: i64 = 2;
const GO_JSON_SCAN_OBJECT_KEY: i64 = 3;
const GO_JSON_SCAN_OBJECT_VALUE: i64 = 4;
const GO_JSON_SCAN_END_OBJECT: i64 = 5;
const GO_JSON_SCAN_BEGIN_ARRAY: i64 = 6;
const GO_JSON_SCAN_ARRAY_VALUE: i64 = 7;
const GO_JSON_SCAN_END_ARRAY: i64 = 8;
const GO_JSON_SCAN_SKIP_SPACE: i64 = 9;
const GO_JSON_SCAN_END: i64 = 10;
const GO_JSON_SCAN_ERROR: i64 = 11;

// ---------- parse states (scanner.go parseState stack) ----------

const GO_JSON_PARSE_OBJECT_KEY: i64 = 0;
const GO_JSON_PARSE_OBJECT_VALUE: i64 = 1;
const GO_JSON_PARSE_ARRAY_VALUE: i64 = 2;

// ---------- scanner states (one code per state fn) ----------

const GO_JSON_STATE_BEGIN_VALUE: i64 = 0;
const GO_JSON_STATE_BEGIN_VALUE_OR_EMPTY: i64 = 1;
const GO_JSON_STATE_BEGIN_STRING_OR_EMPTY: i64 = 2;
const GO_JSON_STATE_BEGIN_STRING: i64 = 3;
const GO_JSON_STATE_END_VALUE: i64 = 4;
const GO_JSON_STATE_END_TOP: i64 = 5;
const GO_JSON_STATE_IN_STRING: i64 = 6;
const GO_JSON_STATE_IN_STRING_ESC: i64 = 7;
const GO_JSON_STATE_IN_STRING_ESC_U: i64 = 8;
const GO_JSON_STATE_IN_STRING_ESC_U1: i64 = 9;
const GO_JSON_STATE_IN_STRING_ESC_U12: i64 = 10;
const GO_JSON_STATE_IN_STRING_ESC_U123: i64 = 11;
const GO_JSON_STATE_NEG: i64 = 12;
const GO_JSON_STATE_1: i64 = 13;
const GO_JSON_STATE_0: i64 = 14;
const GO_JSON_STATE_DOT: i64 = 15;
const GO_JSON_STATE_DOT0: i64 = 16;
const GO_JSON_STATE_E: i64 = 17;
const GO_JSON_STATE_ESIGN: i64 = 18;
const GO_JSON_STATE_E0: i64 = 19;
const GO_JSON_STATE_T: i64 = 20;
const GO_JSON_STATE_TR: i64 = 21;
const GO_JSON_STATE_TRU: i64 = 22;
const GO_JSON_STATE_F: i64 = 23;
const GO_JSON_STATE_FA: i64 = 24;
const GO_JSON_STATE_FAL: i64 = 25;
const GO_JSON_STATE_FALS: i64 = 26;
const GO_JSON_STATE_N: i64 = 27;
const GO_JSON_STATE_NU: i64 = 28;
const GO_JSON_STATE_NUL: i64 = 29;
const GO_JSON_STATE_ERROR: i64 = 30;

const GO_JSON_MAX_NESTING_DEPTH: i64 = 10000;

// ---------- Decoder token states (stream.go) ----------

const GO_JSON_TOKEN_TOP_VALUE: i64 = 0;
const GO_JSON_TOKEN_ARRAY_START: i64 = 1;
const GO_JSON_TOKEN_ARRAY_VALUE: i64 = 2;
const GO_JSON_TOKEN_ARRAY_COMMA: i64 = 3;
const GO_JSON_TOKEN_OBJECT_START: i64 = 4;
const GO_JSON_TOKEN_OBJECT_KEY: i64 = 5;
const GO_JSON_TOKEN_OBJECT_COLON: i64 = 6;
const GO_JSON_TOKEN_OBJECT_VALUE: i64 = 7;
const GO_JSON_TOKEN_OBJECT_COMMA: i64 = 8;

// ---------- Decoder token kinds ----------

const GO_JSON_TOKEN_DELIM: i64 = 0;
const GO_JSON_TOKEN_BOOL: i64 = 1;
const GO_JSON_TOKEN_NUMBER: i64 = 2;
const GO_JSON_TOKEN_STRING: i64 = 3;
const GO_JSON_TOKEN_NULL: i64 = 4;

// ---------- error target ids ----------

const GO_JSON_SYNTAX_ERROR_ID: i64 = 900036;
const GO_JSON_TYPE_ERROR_ID: i64 = 900037;

// ---------- scan-error context codes ----------
//
// The scanner's error message is "invalid character " +
// quoteChar(c) + " " + context. Contexts are codes here
// (SLA has no string literals); __go_json_append_scan_
// context renders them. Codes 24-31 are the Token
// contexts, whose text carries its own leading space
// (stream.go tokenError builds the message without the
// extra separator space).

const GO_JSON_CTX_EMPTY: i64 = 0;
const GO_JSON_CTX_BEGIN_VALUE: i64 = 1;
const GO_JSON_CTX_BEGIN_OBJECT_KEY: i64 = 2;
const GO_JSON_CTX_AFTER_OBJECT_KEY: i64 = 3;
const GO_JSON_CTX_AFTER_OBJECT_KV: i64 = 4;
const GO_JSON_CTX_AFTER_ARRAY_ELEMENT: i64 = 5;
const GO_JSON_CTX_AFTER_TOP_VALUE: i64 = 6;
const GO_JSON_CTX_IN_STRING: i64 = 7;
const GO_JSON_CTX_IN_STRING_ESC: i64 = 8;
const GO_JSON_CTX_IN_U_ESCAPE: i64 = 9;
const GO_JSON_CTX_TRUE_R: i64 = 10;
const GO_JSON_CTX_TRUE_U: i64 = 11;
const GO_JSON_CTX_TRUE_E: i64 = 12;
const GO_JSON_CTX_FALSE_A: i64 = 13;
const GO_JSON_CTX_FALSE_L: i64 = 14;
const GO_JSON_CTX_FALSE_S: i64 = 15;
const GO_JSON_CTX_FALSE_E: i64 = 16;
const GO_JSON_CTX_NULL_U: i64 = 17;
const GO_JSON_CTX_NULL_L: i64 = 18;
const GO_JSON_CTX_IN_NUMBER: i64 = 19;
const GO_JSON_CTX_AFTER_DOT: i64 = 20;
const GO_JSON_CTX_IN_EXPONENT: i64 = 21;
const GO_JSON_CTX_MAX_DEPTH: i64 = 22;
const GO_JSON_CTX_UNEXPECTED_EOF: i64 = 23;
const GO_JSON_CTX_TOKEN_BEGIN_VALUE: i64 = 24;
const GO_JSON_CTX_TOKEN_AFTER_ARRAY: i64 = 25;
const GO_JSON_CTX_TOKEN_BEGIN_KEY: i64 = 26;
const GO_JSON_CTX_TOKEN_AFTER_KEY: i64 = 27;
const GO_JSON_CTX_TOKEN_AFTER_KV: i64 = 28;
const GO_JSON_CTX_EXPECT_COMMA: i64 = 29;
const GO_JSON_CTX_EXPECT_COLON: i64 = 30;
const GO_JSON_CTX_NOT_AT_VALUE: i64 = 31;

// ---------- Go type-name codes (UnmarshalTypeError) ----------

const GO_JSON_TYPE_STRING: i64 = 0;
const GO_JSON_TYPE_INT: i64 = 1;
const GO_JSON_TYPE_UINT: i64 = 2;
const GO_JSON_TYPE_BOOL: i64 = 3;
const GO_JSON_TYPE_BYTES: i64 = 4;
const GO_JSON_TYPE_STRING_SLICE: i64 = 5;
const GO_JSON_TYPE_INT_SLICE: i64 = 6;
const GO_JSON_TYPE_BOOL_SLICE: i64 = 7;
const GO_JSON_TYPE_STRING_MAP: i64 = 8;
const GO_JSON_TYPE_INT_MAP: i64 = 9;
const GO_JSON_TYPE_BOOL_MAP: i64 = 10;
const GO_JSON_TYPE_NUMBER: i64 = 11;

// ---------- JSON value-description codes ----------

const GO_JSON_VALUE_BOOL: i64 = 0;
const GO_JSON_VALUE_STRING: i64 = 1;
const GO_JSON_VALUE_NUMBER: i64 = 2;
const GO_JSON_VALUE_ARRAY: i64 = 3;
const GO_JSON_VALUE_OBJECT: i64 = 4;
const GO_JSON_VALUE_NULL: i64 = 5;

// ---------- structs ----------

// Go's scanner: the step is an i64 state code (not a Go
// func value -- SLA has no fn_ptr values). parse_state
// is a stack with logical length depth (SLA has no Vec
// truncate, so popped entries stay allocated past
// depth and are ignored). bytes counts stepped bytes
// for SyntaxError offsets; it is NOT reset by
// go_encoding_json_scanner_reset, exactly like Go's
// reset (callers that need a fresh count use a fresh
// scanner from go_encoding_json_scanner_new).
struct GoJsonScanner {
    step: i64,
    end_top: bool,
    parse_state: Vec<i64>,
    depth: i64,
    err: ptr,
    bytes: i64,
}

// Go's (T, error) for byte results (Marshal, Compact,
// Indent, MarshalIndent, RawMessage marshal).
struct GoJsonBytes {
    b: Vec<u8>,
    err: ptr,
}

// Byte result with the error's offset alongside it
// (SyntaxError offsets do not fit in a GosError).
struct GoJsonBytesResult {
    v: Vec<u8>,
    err: ptr,
    err_offset: i64,
    set: bool,
    is_nil: bool,
}

// checkValid's answer: ok, the SyntaxError (or nil),
// and the error offset.
struct GoJsonValidResult {
    ok: bool,
    err: ptr,
    offset: i64,
}

struct GoJsonStringResult {
    v: Vec<u8>,
    err: ptr,
    err_offset: i64,
    set: bool,
}

struct GoJsonIntResult {
    v: i64,
    err: ptr,
    err_offset: i64,
    set: bool,
}

struct GoJsonUintResult {
    v: u64,
    err: ptr,
    err_offset: i64,
    set: bool,
}

struct GoJsonBoolResult {
    v: bool,
    err: ptr,
    err_offset: i64,
    set: bool,
}

struct GoJsonStringSliceResult {
    v: Vec<Vec<u8>>,
    err: ptr,
    err_offset: i64,
    set: bool,
    is_nil: bool,
}

struct GoJsonIntSliceResult {
    v: Vec<i64>,
    err: ptr,
    err_offset: i64,
    set: bool,
    is_nil: bool,
}

struct GoJsonBoolSliceResult {
    v: Vec<bool>,
    err: ptr,
    err_offset: i64,
    set: bool,
    is_nil: bool,
}

// One map entry. Maps decode into Vec<entry> in JSON
// order; the frontend inserts them into the Go map.
struct GoJsonStringEntry {
    k: Vec<u8>,
    v: Vec<u8>,
}

struct GoJsonIntEntry {
    k: Vec<u8>,
    v: i64,
}

struct GoJsonBoolEntry {
    k: Vec<u8>,
    v: bool,
}

struct GoJsonStringMapResult {
    v: Vec<GoJsonStringEntry>,
    err: ptr,
    err_offset: i64,
    set: bool,
    is_nil: bool,
}

struct GoJsonIntMapResult {
    v: Vec<GoJsonIntEntry>,
    err: ptr,
    err_offset: i64,
    set: bool,
    is_nil: bool,
}

struct GoJsonBoolMapResult {
    v: Vec<GoJsonBoolEntry>,
    err: ptr,
    err_offset: i64,
    set: bool,
    is_nil: bool,
}

// parseTag's answer: the name before the first comma
// and the options after it (without the comma).
struct GoJsonTag {
    name: Vec<u8>,
    opts: Vec<u8>,
}

// A byte span inside a buffer (readValue's answer).
struct GoJsonSpan {
    start: i64,
    len: i64,
    err: ptr,
}

// Go's decodeState. data is the whole input (for the
// one-shot Unmarshal entry points) or the current
// value's span (for Decoder.Decode). off is the next
// read offset; opcode is the last scan result.
// saved_err / saved_offset are the first type error
// seen (Go's saveError keeps the first). err_struct /
// err_fields are the error context (Go's errorContext):
// err_fields has logical length err_fields_len (same
// no-truncate rule as the scanner stack).
struct GoJsonDecodeState {
    data: Vec<u8>,
    off: i64,
    opcode: i64,
    scan: GoJsonScanner,
    saved_err: ptr,
    saved_offset: i64,
    use_number: bool,
    disallow_unknown_fields: bool,
    err_struct: Vec<u8>,
    err_fields: Vec<Vec<u8>>,
    err_fields_len: i64,
}

// Go's Encoder: writes into a caller-held GosBuilder
// (the io.Writer model at this surface). indent_prefix /
// indent_value are SetIndent's arguments (empty = off).
// err is sticky (Go: once set, every Encode returns it).
struct GoJsonEncoder {
    out: GosBuilder,
    err: ptr,
    escape_html: bool,
    indent_prefix: Vec<u8>,
    indent_value: Vec<u8>,
}

// Go's Decoder over a byte buffer (seam (b)). buf is
// everything fed so far; scanp is the start of unread
// data (absolute -- the buffer is never slid down);
// scanned stays 0 for the same reason. scan is the
// readValue scanner; d is the decodeState for the
// value being decoded. token_state / token_stack
// (logical length token_depth) are the Token API's
// state. err is sticky (Go: a read error ends the
// stream; decode errors are NOT sticky).
struct GoJsonDecoder {
    buf: Vec<u8>,
    scanp: i64,
    scanned: i64,
    scan: GoJsonScanner,
    err: ptr,
    token_state: i64,
    token_stack: Vec<i64>,
    token_depth: i64,
    d: GoJsonDecodeState,
}

// Go's Token: one of Delim (kind DELIM, delim byte),
// bool, float64-as-raw-literal (kind NUMBER, num --
// see the Token divergence note), string, nil (kind
// NULL). is_null is unused for the other kinds.
struct GoJsonToken {
    kind: i64,
    delim: u8,
    b: bool,
    num: Vec<u8>,
    s: Vec<u8>,
}

struct GoJsonTokenResult {
    tok: GoJsonToken,
    err: ptr,
    err_offset: i64,
}

struct GoJsonPeek {
    c: u8,
    found: bool,
}

// ---------- byte helpers ----------

fn __go_json_append(dst: Vec<u8>, src: Vec<u8>) -> void {
    let i = 0;
    while i < len(src) {
        dst.push(src[i]);
        i = i + 1;
    }
    return;
}

// Fresh copy of b[lo:hi] (bounds are the caller's).
fn __go_json_slice(b: Vec<u8>, lo: i64, hi: i64) -> Vec<u8> {
    let out = Vec::new();
    let i = lo;
    while i < hi {
        out.push(b[i]);
        i = i + 1;
    }
    return out;
}

fn __go_json_bytes_eq(a: Vec<u8>, b: Vec<u8>) -> bool {
    if len(a) != len(b) {
        return false;
    };
    let i = 0;
    while i < len(a) {
        if a[i] != b[i] {
            return false;
        };
        i = i + 1;
    }
    return true;
}

// The hex digits Go's encode.go spells as const hex.
fn __go_json_hex_digit(v: i64) -> u8 {
    if v == 0 { return 48u8; };
    if v == 1 { return 49u8; };
    if v == 2 { return 50u8; };
    if v == 3 { return 51u8; };
    if v == 4 { return 52u8; };
    if v == 5 { return 53u8; };
    if v == 6 { return 54u8; };
    if v == 7 { return 55u8; };
    if v == 8 { return 56u8; };
    if v == 9 { return 57u8; };
    if v == 10 { return 97u8; };
    if v == 11 { return 98u8; };
    if v == 12 { return 99u8; };
    if v == 13 { return 100u8; };
    if v == 14 { return 101u8; };
    return 102u8;
}

// Go's scanner.isSpace: c <= ' ' and one of space,
// tab, carriage return, newline.
fn __go_json_is_space(c: u8) -> bool {
    let v = c as i64;
    if v > 32 {
        return false;
    };
    if v == 32 { return true; };
    if v == 9 { return true; };
    if v == 13 { return true; };
    if v == 10 { return true; };
    return false;
}

fn __go_json_is_digit(c: u8) -> bool {
    let v = c as i64;
    if v < 48 {
        return false;
    };
    if v > 57 {
        return false;
    };
    return true;
}

fn __go_json_is_hex_digit(c: u8) -> bool {
    let v = c as i64;
    if v >= 48 {
        if v <= 57 {
            return true;
        };
    };
    if v >= 97 {
        if v <= 102 {
            return true;
        };
    };
    if v >= 65 {
        if v <= 70 {
            return true;
        };
    };
    return false;
}

// ---------- message fragments ----------
//
// SLA has no string literals, so every error message
// is built from byte pushes, the corpus-wide pattern
// (io.sla builds its sentinel messages the same way).

// "json: cannot unmarshal "
fn __go_json_msg_cannot_unmarshal(dst: Vec<u8>) -> void {
    dst.push(106u8); dst.push(115u8); dst.push(111u8); dst.push(110u8); dst.push(58u8); dst.push(32u8);
    dst.push(99u8); dst.push(97u8); dst.push(110u8); dst.push(110u8); dst.push(111u8); dst.push(116u8);
    dst.push(32u8); dst.push(117u8); dst.push(110u8); dst.push(109u8); dst.push(97u8); dst.push(114u8);
    dst.push(115u8); dst.push(104u8); dst.push(97u8); dst.push(108u8); dst.push(32u8);
    return;
}

