// Go type names for UnmarshalTypeError messages, by
// GO_JSON_TYPE_* code. The name is a constant chosen
// by the entry point (see the header divergence note).
fn __go_json_append_type_name(dst: Vec<u8>, code: i64) -> void {
    if code == GO_JSON_TYPE_STRING {
        dst.push(115u8); dst.push(116u8); dst.push(114u8); dst.push(105u8); dst.push(110u8); dst.push(103u8);
        return;
    };
    if code == GO_JSON_TYPE_INT {
        dst.push(105u8); dst.push(110u8); dst.push(116u8);
        return;
    };
    if code == GO_JSON_TYPE_UINT {
        dst.push(117u8); dst.push(105u8); dst.push(110u8); dst.push(116u8);
        return;
    };
    if code == GO_JSON_TYPE_BOOL {
        dst.push(98u8); dst.push(111u8); dst.push(111u8); dst.push(108u8);
        return;
    };
    if code == GO_JSON_TYPE_BYTES {
        dst.push(91u8); dst.push(93u8); dst.push(98u8); dst.push(121u8); dst.push(116u8); dst.push(101u8);
        return;
    };
    if code == GO_JSON_TYPE_STRING_SLICE {
        dst.push(91u8); dst.push(93u8); dst.push(115u8); dst.push(116u8); dst.push(114u8); dst.push(105u8);
        dst.push(110u8); dst.push(103u8);
        return;
    };
    if code == GO_JSON_TYPE_INT_SLICE {
        dst.push(91u8); dst.push(93u8); dst.push(105u8); dst.push(110u8); dst.push(116u8);
        return;
    };
    if code == GO_JSON_TYPE_BOOL_SLICE {
        dst.push(91u8); dst.push(93u8); dst.push(98u8); dst.push(111u8); dst.push(111u8); dst.push(108u8);
        return;
    };
    if code == GO_JSON_TYPE_STRING_MAP {
        dst.push(109u8); dst.push(97u8); dst.push(112u8); dst.push(91u8); dst.push(115u8); dst.push(116u8);
        dst.push(114u8); dst.push(105u8); dst.push(110u8); dst.push(103u8); dst.push(93u8); dst.push(115u8);
        dst.push(116u8); dst.push(114u8); dst.push(105u8); dst.push(110u8); dst.push(103u8);
        return;
    };
    if code == GO_JSON_TYPE_INT_MAP {
        dst.push(109u8); dst.push(97u8); dst.push(112u8); dst.push(91u8); dst.push(115u8); dst.push(116u8);
        dst.push(114u8); dst.push(105u8); dst.push(110u8); dst.push(103u8); dst.push(93u8); dst.push(105u8);
        dst.push(110u8); dst.push(116u8);
        return;
    };
    if code == GO_JSON_TYPE_BOOL_MAP {
        dst.push(109u8); dst.push(97u8); dst.push(112u8); dst.push(91u8); dst.push(115u8); dst.push(116u8);
        dst.push(114u8); dst.push(105u8); dst.push(110u8); dst.push(103u8); dst.push(93u8); dst.push(98u8);
        dst.push(111u8); dst.push(111u8); dst.push(108u8);
        return;
    };
    // json.Number
    dst.push(106u8); dst.push(115u8); dst.push(111u8); dst.push(110u8); dst.push(46u8); dst.push(78u8);
    dst.push(117u8); dst.push(109u8); dst.push(98u8); dst.push(101u8); dst.push(114u8);
    return;
}

// JSON value descriptions for UnmarshalTypeError
// messages, by GO_JSON_VALUE_* code.
fn __go_json_append_value_desc(dst: Vec<u8>, code: i64) -> void {
    if code == GO_JSON_VALUE_BOOL {
        dst.push(98u8); dst.push(111u8); dst.push(111u8); dst.push(108u8);
        return;
    };
    if code == GO_JSON_VALUE_STRING {
        dst.push(115u8); dst.push(116u8); dst.push(114u8); dst.push(105u8); dst.push(110u8); dst.push(103u8);
        return;
    };
    if code == GO_JSON_VALUE_NUMBER {
        dst.push(110u8); dst.push(117u8); dst.push(109u8); dst.push(98u8); dst.push(101u8); dst.push(114u8);
        return;
    };
    if code == GO_JSON_VALUE_ARRAY {
        dst.push(97u8); dst.push(114u8); dst.push(114u8); dst.push(97u8); dst.push(121u8);
        return;
    };
    if code == GO_JSON_VALUE_OBJECT {
        dst.push(111u8); dst.push(98u8); dst.push(106u8); dst.push(101u8); dst.push(99u8); dst.push(116u8);
        return;
    };
    dst.push(110u8); dst.push(117u8); dst.push(108u8); dst.push(108u8);
    return;
}

// Scan-error contexts, by GO_JSON_CTX_* code. Codes
// 24-28 carry their own leading space (Token errors);
// the scanner's error adds one separator space before
// codes 0-23.
fn __go_json_append_scan_context(dst: Vec<u8>, code: i64) -> void {
    if code == GO_JSON_CTX_EMPTY {
        return;
    };
    if code == GO_JSON_CTX_BEGIN_VALUE {
        // "looking for beginning of value"
        dst.push(108u8); dst.push(111u8); dst.push(111u8); dst.push(107u8); dst.push(105u8); dst.push(110u8);
        dst.push(103u8); dst.push(32u8); dst.push(102u8); dst.push(111u8); dst.push(114u8); dst.push(32u8);
        dst.push(98u8); dst.push(101u8); dst.push(103u8); dst.push(105u8); dst.push(110u8); dst.push(110u8);
        dst.push(105u8); dst.push(110u8); dst.push(103u8); dst.push(32u8); dst.push(111u8); dst.push(102u8);
        dst.push(32u8); dst.push(118u8); dst.push(97u8); dst.push(108u8); dst.push(117u8); dst.push(101u8);
        return;
    };
    if code == GO_JSON_CTX_BEGIN_OBJECT_KEY {
        // "looking for beginning of object key string"
        dst.push(108u8); dst.push(111u8); dst.push(111u8); dst.push(107u8); dst.push(105u8); dst.push(110u8);
        dst.push(103u8); dst.push(32u8); dst.push(102u8); dst.push(111u8); dst.push(114u8); dst.push(32u8);
        dst.push(98u8); dst.push(101u8); dst.push(103u8); dst.push(105u8); dst.push(110u8); dst.push(110u8);
        dst.push(105u8); dst.push(110u8); dst.push(103u8); dst.push(32u8); dst.push(111u8); dst.push(102u8);
        dst.push(32u8); dst.push(111u8); dst.push(98u8); dst.push(106u8); dst.push(101u8); dst.push(99u8);
        dst.push(116u8); dst.push(32u8); dst.push(107u8); dst.push(101u8); dst.push(121u8); dst.push(32u8);
        dst.push(115u8); dst.push(116u8); dst.push(114u8); dst.push(105u8); dst.push(110u8); dst.push(103u8);
        return;
    };
    if code == GO_JSON_CTX_AFTER_OBJECT_KEY {
        // "after object key"
        dst.push(97u8); dst.push(102u8); dst.push(116u8); dst.push(101u8); dst.push(114u8); dst.push(32u8);
        dst.push(111u8); dst.push(98u8); dst.push(106u8); dst.push(101u8); dst.push(99u8); dst.push(116u8);
        dst.push(32u8); dst.push(107u8); dst.push(101u8); dst.push(121u8);
        return;
    };
    if code == GO_JSON_CTX_AFTER_OBJECT_KV {
        // "after object key:value pair"
        dst.push(97u8); dst.push(102u8); dst.push(116u8); dst.push(101u8); dst.push(114u8); dst.push(32u8);
        dst.push(111u8); dst.push(98u8); dst.push(106u8); dst.push(101u8); dst.push(99u8); dst.push(116u8);
        dst.push(32u8); dst.push(107u8); dst.push(101u8); dst.push(121u8); dst.push(58u8); dst.push(118u8);
        dst.push(97u8); dst.push(108u8); dst.push(117u8); dst.push(101u8); dst.push(32u8); dst.push(112u8);
        dst.push(97u8); dst.push(105u8); dst.push(114u8);
        return;
    };
    if code == GO_JSON_CTX_AFTER_ARRAY_ELEMENT {
        // "after array element"
        dst.push(97u8); dst.push(102u8); dst.push(116u8); dst.push(101u8); dst.push(114u8); dst.push(32u8);
