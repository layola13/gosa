// ---------- Decoder (stream.go) ----------

// Go's NewDecoder over a byte buffer (seam (b)):
// the frontend feeds input with decoder_feed; the
// decoder never refills from a reader itself.
fn go_encoding_json_decoder_new(buf: Vec<u8>) -> GoJsonDecoder {
    return GoJsonDecoder {
        buf: buf,
        scanp: 0,
        scanned: 0,
        scan: go_encoding_json_scanner_new(),
        err: go_errors_nil(),
        token_state: GO_JSON_TOKEN_TOP_VALUE,
        token_stack: Vec::new(),
        token_depth: 0,
        d: go_encoding_json_decode_new(Vec::new()),
    };
}

// Feed more input bytes into the decoder's buffer.
// The buffer is never slid down (no Vec truncate in
// SLA), so scanp is an absolute offset -- see
// seam (b).
fn go_encoding_json_decoder_feed(dec: &GoJsonDecoder, chunk: Vec<u8>) -> void {
    __go_json_append(dec.buf, chunk);
    return;
}

// Go's Decoder.UseNumber: carried on the decode
// state; no effect in wave 1b (it only changes
// decoding into any -- see the header divergence
// note), but the call exists so the frontend can
// emit it.
fn go_encoding_json_decoder_use_number(dec: &GoJsonDecoder) -> void {
    dec.d.use_number = true;
    return;
}

// Go's Decoder.DisallowUnknownFields: honoured by
// frontend-emitted struct decode (see the
// object-loop recipe on decode_new).
fn go_encoding_json_decoder_disallow_unknown_fields(dec: &GoJsonDecoder) -> void {
    dec.d.disallow_unknown_fields = true;
    return;
}

// Go's Decoder.InputOffset.
fn go_encoding_json_decoder_input_offset(dec: &GoJsonDecoder) -> i64 {
    return dec.scanned + dec.scanp;
}

// Go's Decoder.Buffered: the unread remainder.
fn go_encoding_json_decoder_buffered(dec: &GoJsonDecoder) -> Vec<u8> {
    return __go_json_slice(dec.buf, dec.scanp, len(dec.buf));
}

// Go's nonSpace (stream.go).
fn __go_json_non_space(b: Vec<u8>) -> bool {
    let i = 0;
    while i < len(b) {
        if !__go_json_is_space(b[i]) {
            return true;
        };
        i = i + 1;
    }
    return false;
}

// Go's Decoder.readValue, with the buffer-complete
// model (seam (b)): refill always returns io.EOF
// with zero bytes, so the end-of-buffer path is the
// EOF path inline. The span is the byte range of
// the next complete value; err is nil, a SyntaxError
// (target 900036), io.EOF (target 900010) or
// io.ErrUnexpectedEOF (target 900015).
fn __go_json_decoder_read_value(dec: &GoJsonDecoder) -> GoJsonSpan {
    go_encoding_json_scanner_reset(&dec.scan);
    let scanp = dec.scanp;
    let n = len(dec.buf);
    while scanp < n {
        let c = dec.buf[scanp];
        dec.scan.bytes = dec.scan.bytes + 1;
        let op = __go_json_scan_step(&dec.scan, c);
        if op == GO_JSON_SCAN_END {
            dec.scan.bytes = dec.scan.bytes - 1;
            return GoJsonSpan { start: dec.scanp, len: scanp - dec.scanp, err: go_errors_nil() };
        };
        if op == GO_JSON_SCAN_END_OBJECT {
            if __go_json_state_end_value(&dec.scan, 32u8) == GO_JSON_SCAN_END {
                scanp = scanp + 1;
                return GoJsonSpan { start: dec.scanp, len: scanp - dec.scanp, err: go_errors_nil() };
            };
        } else {
            if op == GO_JSON_SCAN_END_ARRAY {
                if __go_json_state_end_value(&dec.scan, 32u8) == GO_JSON_SCAN_END {
                    scanp = scanp + 1;
                    return GoJsonSpan { start: dec.scanp, len: scanp - dec.scanp, err: go_errors_nil() };
                };
            } else {
                if op == GO_JSON_SCAN_ERROR {
                    dec.err = dec.scan.err;
                    return GoJsonSpan { start: dec.scanp, len: 0, err: dec.scan.err };
                };
            };
        };
        scanp = scanp + 1;
    }
    if __go_json_scan_step(&dec.scan, 32u8) == GO_JSON_SCAN_END {
        return GoJsonSpan { start: dec.scanp, len: scanp - dec.scanp, err: go_errors_nil() };
    };
    if __go_json_non_space(dec.buf) {
        dec.err = go_io_err_unexpected_eof();
        return GoJsonSpan { start: dec.scanp, len: 0, err: dec.err };
    };
    dec.err = go_io_eof();
    return GoJsonSpan { start: dec.scanp, len: 0, err: dec.err };
}

// Go's Decoder.peek: the next non-space byte at or
// after scanp (scanp advances to it); found=false
// at end of buffer (Go's refill would return
// io.EOF there).
fn __go_json_decoder_peek(dec: &GoJsonDecoder) -> GoJsonPeek {
    let i = dec.scanp;
    while i < len(dec.buf) {
        let c = dec.buf[i];
        if __go_json_is_space(c) {
            i = i + 1;
            continue;
        };
        dec.scanp = i;
        return GoJsonPeek { c: c, found: true };
    }
    return GoJsonPeek { c: 0u8, found: false };
}

// Go's Decoder.tokenPrepareForDecode.
fn __go_json_decoder_token_prepare_for_decode(dec: &GoJsonDecoder) -> ptr {
    if dec.token_state == GO_JSON_TOKEN_ARRAY_COMMA {
        let pk = __go_json_decoder_peek(dec);
        if !pk.found {
            return go_io_eof();
        };
        if pk.c != 44u8 {
            let m = Vec::new();
            __go_json_append_scan_context(m, GO_JSON_CTX_EXPECT_COMMA);
            return go_encoding_json_syntax_error(m, go_encoding_json_decoder_input_offset(dec));
        };
        dec.scanp = dec.scanp + 1;
        dec.token_state = GO_JSON_TOKEN_ARRAY_VALUE;
        return go_errors_nil();
    };
    if dec.token_state == GO_JSON_TOKEN_OBJECT_COLON {
        let pk = __go_json_decoder_peek(dec);
        if !pk.found {
            return go_io_eof();
        };
        if pk.c != 58u8 {
            let m = Vec::new();
            __go_json_append_scan_context(m, GO_JSON_CTX_EXPECT_COLON);
            return go_encoding_json_syntax_error(m, go_encoding_json_decoder_input_offset(dec));
        };
        dec.scanp = dec.scanp + 1;
        dec.token_state = GO_JSON_TOKEN_OBJECT_VALUE;
        return go_errors_nil();
    };
    return go_errors_nil();
}

// Go's Decoder.tokenValueAllowed.
fn __go_json_decoder_token_value_allowed(dec: &GoJsonDecoder) -> bool {
    if dec.token_state == GO_JSON_TOKEN_TOP_VALUE {
        return true;
    };
    if dec.token_state == GO_JSON_TOKEN_ARRAY_START {
        return true;
    };
    if dec.token_state == GO_JSON_TOKEN_ARRAY_VALUE {
        return true;
    };
    if dec.token_state == GO_JSON_TOKEN_OBJECT_VALUE {
        return true;
    };
    return false;
}

// Go's Decoder.tokenValueEnd.
fn __go_json_decoder_token_value_end(dec: &GoJsonDecoder) -> void {
    if dec.token_state == GO_JSON_TOKEN_ARRAY_START {
        dec.token_state = GO_JSON_TOKEN_ARRAY_COMMA;
        return;
    };
    if dec.token_state == GO_JSON_TOKEN_ARRAY_VALUE {
        dec.token_state = GO_JSON_TOKEN_ARRAY_COMMA;
        return;
    };
    if dec.token_state == GO_JSON_TOKEN_OBJECT_VALUE {
        dec.token_state = GO_JSON_TOKEN_OBJECT_COMMA;
        return;
    };
    return;
}

// The token stack (logical length token_depth --
// the same no-truncate rule as the scanner stack).
fn __go_json_decoder_push_token_state(dec: &GoJsonDecoder, st: i64) -> void {
    if dec.token_depth < len(dec.token_stack) {
        dec.token_stack[dec.token_depth] = st;
    } else {
        dec.token_stack.push(st);
    };
    dec.token_depth = dec.token_depth + 1;
    return;
}

