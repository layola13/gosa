// gostd archive/zip: the SLA-side model of Go's archive/zip
// package (Go 1.27.2), over byte strings (Vec<u8>).
// Organisation follows the psa_std precedent: public
// entry points go_archive_zip_*, private helpers
// __go_zip_*.
//
// Oracle: Go 1.27.2 archive/zip (reader.go, writer.go,
// struct.go, register.go), mirrored from the box Go
// tree /usr/local/go/src/archive/zip/ into
// wave2-oracle/archive_zip/ (reader.go sha d35e8e55...,
// writer.go sha a76c310e..., struct.go sha b2ee362b...,
// register.go sha 79c2b8c3... -- all four match the
// box exactly).
//
// This file is number 30 in the splice order: the 28
// landed corpus files, then archive/tar (29), then
// this file (30). It is written against the fresh
// 603232ac plugin (with the B1 hashmap import); the
// installed plugin 0.1.8 fails earlier in the splice
// (raw 1009 in fmt) and never reaches this file.
//
// API map (Go -> gostd):
//   NewReader(r io.ReaderAt, size) -> NewReader over
//     the archive bytes directly: gostd has no
//     ReaderAt handle; go_io_read_full IS the SLA
//     random-access primitive. Divergence D0: the
//     caller hands over the whole archive as Vec<u8>.
//   NewReaderStrict -> go_archive_zip_new_reader_strict
//     (enforces the insecure-path check that Go gates
//     behind GODEBUG zipinsecurepath=0, off by default
//     in Go 1.27; the non-strict form does NOT enforce
//     it, matching Go's default).
//   Reader.File, Reader.Comment, File.Open,
//   File.OpenRaw, File.DataOffset, FileHeader fields,
//   Writer.Create/CreateHeader/CreateRaw/Write/Close/
//   CloseFile/Flush/SetOffset/SetComment/Copy.
//   Store (method 0) is fully implemented for read
//   and write. Deflate (method 8) returns
//   ErrAlgorithm (900058) until compress/flate lands
//   -- see divergence D2 below.
//   Reader.RegisterDecompressor, Writer.RegisterCompressor
//   and the package-level Register* functions are
//   OMITTED: they take function values, and
//   closure->fn_ptr adaptation is impossible in
//   current SLA (LANG-PROPOSAL-closure-fnptr.md).
//   FileInfoHeader, (FileHeader).FileInfo,
//   (FileHeader).Mode, (FileHeader).SetMode,
//   OpenReader, Reader.Open and the whole fs.FS
//   surface (initFileList, openLookup, openReadDir,
//   openDir, fileListEntry) are OMITTED: they need
//   io/fs FileInfo/FileMode, which gostd does not
//   model yet. Writer.AddFS is omitted for the same
//   reason. Writer.CreateHeader's duplicate-FileHeader
//   check is SKIPPED: Go compares pointers, which is
//   unrepresentable in SLA values (value-equality
//   would over-catch).
//
// Divergences:
//   D0: NewReader takes Vec<u8>, not (ReaderAt, size).
//   D1: GoTime has no zero sentinel and no location.
//     A zero MS-DOS date/time (1980-01-01 00:00:00)
//     decodes to go_time_unix(315532800, 0), not a
//     zero time; Modified keeps UTC (Go attaches a
//     fixed-offset zone estimated from the extended
//     timestamp delta -- the instant is identical,
//     only the Location differs).
//   D2: Deflate is a documented seam, NOT implemented:
//     File.Open on a Deflate entry returns
//     ErrAlgorithm; Writer.CreateHeader with
//     Method=8 returns ErrAlgorithm. Store and
//     CreateRaw/Copy work fully. Until compress/flate
//     lands, this package is Store-only.
//   D2b: Writer.Create defaults to Store in gostd
//     (Go defaults to Deflate, which is unimplemented
//     until compress/flate lands; a Create that always
//     errors would make the writer unusable).
//   D3: Writer.Flush is a no-op returning nil:
//     GosIoWriter has no buffering, so there is
//     nothing to flush (Go flushes a bufio.Writer).
//   D4: Read errors are sticky per Go's checksumReader:
//     after EOF or a verification error, further
//     reads return (0, the same error).
//   D5: SetOffset panics (77453) if any bytes have
//     been written -- the only live Go panic in the
//     implemented surface. The panic message is
//     "zip: SetOffset called after data was written".
//   D6: Headers are values, not pointers. Go mutates
//     the caller's FileHeader in CreateHeader even
//     when it fails (UTF-8 flag, versions, ext-time);
//     gostd leaves the caller's header unchanged on
//     error. Likewise the duplicate-FileHeader check
//     (pointer comparison in Go) is skipped, and a
//     failed local-header write leaves no dir entry
//     (Go appends to dir before writing the header).
//
// Panic codes (gostd block 77400-77499):
//   77453  LIVE: Writer.SetOffset after data written
//          (Go panics the same way).
//   77454  RESERVED: FileInfoHeader (needs io/fs)
//   77455  RESERVED: (FileHeader).FileInfo
//   77456  RESERVED: (FileHeader).Mode
//   77457  RESERVED: (FileHeader).SetMode
//   77458  RESERVED: OpenReader (needs os)
//   77459  RESERVED: Reader.Open / fs.FS surface
//   77460  RESERVED: Reader.RegisterDecompressor
//   77461  RESERVED: Writer.RegisterCompressor
//   77462  RESERVED: package RegisterDecompressor
//   77463  RESERVED: package RegisterCompressor
//   77464  RESERVED: Writer.AddFS (needs io/fs)
//   (77400 is tar's live code; 77415 bufio, 77418
//   context, 77419 slices-reserved, 77422/77424 log,
//   77433 cmp-reserved, 77443 maps, 77444/77445/77448
//   tar-reserved; 77453-77464 verified free
//   corpus-wide 2026-11-28.)
//
// Error target ids (gostd block 900000-900099):
//   900057  ErrFormat ("zip: not a valid zip file")
//   900058  ErrAlgorithm ("zip: unsupported
//           compression algorithm")
//   900059  ErrChecksum ("zip: checksum error")
//   900060  ErrInsecurePath ("zip: insecure file path")
//   900061  errLongName ("zip: FileHeader.Name too long")
//   900062  errLongExtra ("zip: FileHeader.Extra too long")
//   900063  invalid comment length
//           ("zip: invalid comment length")
//   900064  writer closed twice
//           ("zip: writer closed twice")
//   900065  write to closed file
//           ("zip: write to closed file")
//   900066  file closed twice
//           ("zip: file closed twice")
//   900067  write to directory ("zip: write to directory")
//   900068  Writer.Comment too long
//           ("zip: Writer.Comment too long")
//   900069  invalid duplicate FileHeader
//           ("archive/zip: invalid duplicate FileHeader")
//   (900010 io.EOF and 900011 io.ErrUnexpectedEOF are
//   reused from io.sla; 900047-900056 are tar's;
//   900057-900069 verified free corpus-wide
//   2026-11-28.)
//
// Seams used (all in the landed corpus):
//   io.sla: GoIoResult, GoIoBytes, go_io_read_full,
//     GosSectionReader + go_io_section_reader_read_at
//     (not needed -- direct Vec access is used),
//     GosIoWriter + go_io_writer_write, go_io_eof(),
//     go_io_err_unexpected_eof(), ids 900010/900011.
//   crc32.sla: go_crc32_checksum_ieee,
//     go_crc32_ieee_table, go_crc32_update.
//   time.sla: GoTime, go_time_unix, accessors
//     go_time_year/month/day/hour/minute/second,
//     go_time_unix_sec.
//   errors.sla: go_errors_new_with_id,
//     go_errors_is, go_errors_nil.
//   utf8.sla: go_utf8_decode_rune, go_utf8_valid_rune,
//     go_utf8_rune_error.
//   bytes.sla: go_bytes_clone (Vec<u8> copies).
//
// Corpus example at the end of this file:
//   go_archive_zip_demo_roundtrip writes a three-file
//   Store archive into an in-memory multi-writer sink
//   (io.sla's GosMultiWriter -- writes through the
//   indexed sink are visible to the caller), reads it
//   back, verifies names, contents, the directory
//   flag, the comment, the ModTime, and the CRC, then
//   exercises Writer.Copy into a second archive.
//   Returns true when every check holds.

@import "sa_std/vec.sa";

// ---------- constants ----------

const GO_ZIP_SIG_LOCAL: u64 = 67324752;
const GO_ZIP_SIG_CENTRAL: u64 = 33639248;
const GO_ZIP_SIG_EOCD: u64 = 101010256;
const GO_ZIP_SIG_ZIP64_EOCD: u64 = 101075792;
const GO_ZIP_SIG_ZIP64_LOCATOR: u64 = 117853008;
const GO_ZIP_SIG_DATA_DESC: u64 = 134695760;
const GO_ZIP_SIG_DIGITAL: u64 = 84233040;

const GO_ZIP_METHOD_STORE: u64 = 0;
const GO_ZIP_METHOD_DEFLATE: u64 = 8;

const GO_ZIP_FLAG_ENCRYPTED: u64 = 1;
const GO_ZIP_FLAG_DESC: u64 = 8;
const GO_ZIP_FLAG_UTF8: u64 = 2048;

const GO_ZIP_VERSION_20: u64 = 20;
const GO_ZIP_VERSION_45: u64 = 45;
const GO_ZIP_VERSION_46: u64 = 46;

const GO_ZIP_CREATOR_UNIX: u64 = 768;
const GO_ZIP_CREATOR_FAT: u64 = 0;

const GO_ZIP_EXTRA_ZIP64: u64 = 1;
const GO_ZIP_EXTRA_NTFS: u64 = 10;
const GO_ZIP_EXTRA_UNIX: u64 = 13;
const GO_ZIP_EXTRA_EXT_TIME: u64 = 21589;
const GO_ZIP_EXTRA_INFOZIP_UNIX: u64 = 22613;

const GO_ZIP_U16MAX: u64 = 65535;
const GO_ZIP_U32MAX: u64 = 4294967295;
const GO_ZIP_LOCAL_HEADER_LEN: i64 = 30;
const GO_ZIP_CENTRAL_HEADER_LEN: i64 = 46;
const GO_ZIP_EOCD_LEN: i64 = 22;
const GO_ZIP_ZIP64_EOCD_LEN: i64 = 56;
const GO_ZIP_ZIP64_LOCATOR_LEN: i64 = 20;
const GO_ZIP_DESC_LEN: i64 = 16;

const GO_ZIP_PANIC_SET_OFFSET: i64 = 77453;

// ---------- structs ----------

// Go's archive/zip.FileHeader, flattened: wire-sized
// fields are u64 (SLA has no u16/u32); Modified is a
// GoTime; the raw MS-DOS date/time words are kept
// for roundtripping. header_offset lives on
// GosZipFile, not here (as in Go).
struct GosZipFileHeader {
    name: Vec<u8>,
    comment: Vec<u8>,
    extra: Vec<u8>,
    creator_version: u64,
    reader_version: u64,
    flags: u64,
    method: u64,
    modified_time: u64,
    modified_date: u64,
    modified: GoTime,
    modified_set: bool,
    crc32: u64,
    compressed_size: u64,
    uncompressed_size: u64,
    external_attrs: u64,
    disk_number: u64,
    non_utf8: bool,
}

// Go's archive/zip.File: the header plus the offset
// of its local header in the archive.
struct GosZipFile {
    header: GosZipFileHeader,
    header_offset: i64,
}

// One central-directory entry as written by the
// Writer: the finalised header plus its local-header
// offset.
struct GosZipDirEntry {
    header: GosZipFileHeader,
    offset: i64,
}

// Go's archive/zip.Reader: the archive bytes, the
// parsed files, the archive comment, and the base
// offset (nonzero for self-extracting archives).
struct GosZipReader {
    data: Vec<u8>,
    files: Vec<GosZipFile>,
    comment: Vec<u8>,
    base_offset: i64,
}

// Result of NewReader / NewReaderStrict.
struct GoZipReaderResult {
    reader: GosZipReader,
    err: ptr,
}

// Go's checksumReader (File.Open result): reads the
// stored bytes, verifies size and CRC32 at EOF.
// is_dir + dir_err model Go's dirReader: a directory
// entry returns (0, ErrFormat) when it claims
// uncompressed data, else (0, EOF), on every read.
struct GosZipFileReader {
    data: Vec<u8>,
    start: i64,
    pos: i64,
    end: i64,
    header: GosZipFileHeader,
    desc_pos: i64,
    has_desc: bool,
    nread: i64,
    is_dir: bool,
    dir_err: ptr,
    err: ptr,
}

struct GoZipFileReaderResult {
    reader: GosZipFileReader,
    err: ptr,
}

// Go's File.OpenRaw result: the raw compressed bytes,
// no decompression, no CRC check.
struct GosZipRawReader {
    data: Vec<u8>,
    pos: i64,
    end: i64,
    err: ptr,
}

struct GoZipRawReaderResult {
    reader: GosZipRawReader,
    err: ptr,
}

// Result of File.DataOffset.
struct GoZipHeaderResult {
    offset: i64,
    err: ptr,
}

// Writer state for the currently open file.
struct GosZipWriterState {
    header: GosZipFileHeader,
    offset: i64,
    raw: bool,
    is_dir: bool,
    closed: bool,
    crc: u64,
    raw_count: i64,
    comp_count: i64,
}

// Go's archive/zip.Writer: sink, central-directory
// entries, current-file state, comment, byte count,
// zip64 flag, and the IEEE CRC table (built once).
struct GosZipWriter {
    sink: GosIoWriter,
    dir: Vec<GosZipDirEntry>,
    last: GosZipWriterState,
    last_open: bool,
    closed: bool,
    comment: Vec<u8>,
    count: i64,
    used_zip64: bool,
    crc_tab: Vec<u64>,
}

// Parsed end-of-central-directory record.
struct GosZipDirEnd {
    records: u64,
    size: u64,
    offset: u64,
    comment: Vec<u8>,
    end_offset: i64,
    base_offset: i64,
    err: ptr,
}

// Parsed central-directory header.
struct GoZipDirHeaderResult {
    file: GosZipFile,
    next_pos: i64,
    err: ptr,
}

// Extra-field parse result: the header with fields
// possibly overridden, plus the best Modified time
// and the (possibly overridden) header offset.
// err is nil on success, ErrFormat on a malformed
// zip64 extra.
struct GoZipExtraResult {
    header: GosZipFileHeader,
    modified: GoTime,
    has_modified: bool,
    header_offset: i64,
    err: ptr,
}

// MS-DOS date/time pair.
struct GoZipMsDos {
    date: u64,
    time: u64,
}

// ---------- error constructors ----------
// Go's exported ErrFormat / ErrAlgorithm / ErrChecksum
// plus the package's internal errors. Each message is
// built byte-by-byte (SLA has no string literals);
// sentinel comparison is via go_errors_is against
// the target id, as in errors.sla.

fn __go_zip_is_nil(e: ptr) -> bool {
    return e == go_errors_nil();
}

fn __go_zip_is_eof(e: ptr) -> bool {
    return go_errors_is(e, go_io_eof());
}

fn __go_zip_is_unexpected_eof(e: ptr) -> bool {
    return go_errors_is(e, go_io_err_unexpected_eof());
}

fn go_archive_zip_err_format() -> ptr {
    let msg = Vec::new();
    msg.push(122u8);
    msg.push(105u8);
    msg.push(112u8);
    msg.push(58u8);
    msg.push(32u8);
    msg.push(110u8);
    msg.push(111u8);
    msg.push(116u8);
    msg.push(32u8);
    msg.push(97u8);
    msg.push(32u8);
    msg.push(118u8);
    msg.push(97u8);
    msg.push(108u8);
    msg.push(105u8);
    msg.push(100u8);
    msg.push(32u8);
    msg.push(122u8);
    msg.push(105u8);
    msg.push(112u8);
    msg.push(32u8);
    msg.push(102u8);
    msg.push(105u8);
    msg.push(108u8);
    msg.push(101u8);
    return go_errors_new_with_id(msg, (900057 as i64));
}

