// gostd bufio: the SLA-side model of Go's bufio package
// (Reader / Writer / ReadWriter / Scanner + the four
// built-in split functions), over byte strings (Vec<u8>).
// Oracle: Go 1.27.2 stdlib, /usr/local/go/src/bufio/
// (bufio.go + scan.go), read 2026-11-26. Organisation
// follows the psa_std / gostd precedent: public entry
// points go_<pkg>_<name>, private helpers
// __go_<pkg>_<name>, panic codes listed up front.
//
// Splice position: bufio sits after io in the library
// order (census §7.2.1, 1a). It calls errors.sla
// (go_errors_new / _with_id / _nil) and strconv.sla
// (__go_utf8_decode / __go_utf8_append), so it must
// splice after errors + strconv. Cross-file calls are
// plain function calls.
//
// Panic codes (gostd block 77400-77499; this file):
//   77415  bufio read error / invalid state: the
//          underlying reader/writer returned a negative
//          count, returned more bytes than it appended,
//          or an impossible count; fill called on a
//          full buffer; Scanner saw too many empty
//          tokens without progressing; ReadLine's
//          rewind-past-start (unreachable in Go).
//          (Go panics errNegativeRead /
//          errNegativeWrite / "tried to fill full
//          buffer" / "too many empty tokens" in the
//          same places.)
//   77403  bufio buffer misuse: Scanner.Buffer or
//          Scanner.Split called after Scan started
//          (Go panics "Buffer called after Scan" /
//          "Split called after Scan").
//          (R1400: formally assigned to bufio; the
//          old io.sla:12 "reserved" note is rewritten.)
//   NOTE on the brief's "negative size" example: the
//   oracle does NOT panic there. Go 1.27.2
//   NewReaderSize clamps with max(size, 16) and
//   NewWriterSize defaults size <= 0 to 4096, so
//   gostd clamps/defaults the same way and claims no
//   panic for it. 77403 covers the genuine Go panics
//   above instead. (77401 errors, 77410/77413 sync,
//   77411/77412 strconv, 77416/77417 strings,
//   77420/77421/77423 time, 77430-77439 sort,
//   77440-77442 runtime, 77446/77447 fmt,
//   77451/77452 math belong to other files; see
//   NOTES-runtime.md for the whole-library map.)
//
// Target ids (gostd owns 900000-999999):
//   900010 io.EOF -- SHARED, not bufio's. bufio
//          returns io.EOF (via go_bufio_eof()); it
//          defines NO second EOF sentinel. The io
//          line's EOF constructor, if it adds one,
//          must use this same id.
//   900033 bufio.ErrBufferFull
//   900034 bufio.ErrNegativeCount
//   900035 bufio.ErrInvalidUnreadByte
//   900023 bufio.ErrInvalidUnreadRune
//   900024 bufio.ErrTooLong (Scanner)
//   900025 bufio.ErrNegativeAdvance (Scanner)
//   900026 bufio.ErrAdvanceTooFar (Scanner)
//   900027 bufio.ErrBadReadCount (Scanner)
//   900028 bufio.ErrFinalToken (Scanner)
//   (900001/900002 strconv, 900010 io.EOF already in
//   use elsewhere. Errors are GosError values built
//   by go_errors_new_with_id, so errors.Is works by
//   target id through go_errors_is.)
//
// ============ THE IO SEAM (R1400: bufio_ctor_handles) ============
// The underlying reader / writer is an io HANDLE,
// not a bare fn value (central ruling R1400, Muse
// relay 16006; the closure-adapter route S3 was
// proven impossible in RULING-EXEC-170.md §3.2, and
// the handle route is §3.4 option 2). io.sla defines
// the handle types at the end of the file:
//
//   GosIoReader -- tagged handle over io's concrete
//     readers (LimitReader / SectionReader /
//     MultiReader / TeeReader), read through
//     go_io_reader_read(&h, dst, max) -> GoIoResult.
//   GosIoWriter -- tagged handle over io's concrete
//     writers (Discard / MultiWriter / OffsetWriter),
//     written through go_io_writer_write(&h, p).
//
// The constructors take these handles BY VALUE and
// the structs retain them in `rd` / `wr` fields; the
// frontend builds a handle with go_io_reader_from_* /
// go_io_writer_from_* and must not keep using the
// original after handing it over (same by-value
// ownership model as ReadWriter, see below).
// Transient handles (Reader.WriteTo's writer,
// Writer.ReadFrom's reader) are BORROWED
// (&GosIoReader / &GosIoWriter): the caller keeps
// its handle and sees the state updates. A reader
// from another package (strings / bytes) reaches
// bufio by materialising its bytes and wrapping them
// in a LimitReader handle, per io.sla's contract.
//   The read dispatch appends up to `max` bytes to
//   the supplied Vec and returns { n, err }; n is the
//   number of bytes appended; err is nil on success.
//   A handle that lies about n is a broken reader
//   and gostd panics 77415 on it.
//   Read/write RESULTS are unified on GoIoResult
//   (io.sla): GoBufioReadResult / GoBufioWriteResult
//   are deleted (R1400: result-type unification rides
//   with the seam change). GoBufioCountResult stays:
//   it counts, it is not a byte count into a buffer.
//   77403 is formally bufio's (R1400): the io.sla:12
//   "reserved" comment is rewritten, io claims
//   nothing there.
//   io.ErrNoProgress and io.ErrShortWrite carry the
//   io line's target ids (900012 / 900014, R1378):
//   __go_bufio_no_progress / __go_bufio_short_write
//   build them with go_errors_new_with_id, so
//   errors.Is matches io's go_io_err_no_progress /
//   go_io_err_short_write. (Note: the message bytes
//   differ -- bufio writes "io: no progress" /
//   "io: short write", io writes the Go messages
//   "multiple Read calls return no data or error" /
//   "short write" -- same id, different text; the
//   central/debug phase may align the text.)
//   No WriterTo / ReaderFrom / StringWriter fast
//   paths: Reader.WriteTo and Writer.ReadFrom /
//   WriteString run the generic loop only. The
//   fast paths need interface assertions over the
//   underlying reader/writer, which the handle seam
//   cannot express. The generic path is always
//   correct; it only costs copies.
//
// R1426 (liii) lib_borrow: every fn in this file that APPENDS
// into a dst takes dst: &Vec<u8> (io.sla's readers likewise).
// A by-value dst is a copy: pushes into it are invisible to
// the caller (the (liii) defect, SLA-FIXES-170.md §4: fill /
// Reader.Read / ReadFrom / scanner-fill all guarded on
// len(scratch) after the read, so the old code panicked 77415
// on the first successful underlying read). Internal scratch
// buffers are passed as &scratch; the frontend passes the
// Reader.Read destination by borrow.
//
// Loud refusals in this file: panics 77415/77403
// above. Nothing is silently stubbed.
//
// Divergences from Go (all deliberate, all noted):
//   - Peek returns a COPY of the buffered bytes, not
//     a slice into the buffer: Go's bytes stop being
//     valid at the next read, gostd's copy stays
//     valid. Contents at call time are identical.
//   - Scanner.Bytes returns the stored token Vec
//     (an alias, as in Go -- overwritten by the next
//     Scan), while split functions receive a COPY of
//     the unprocessed data, never the live buffer.
//   - ReadWriter stores its Reader and Writer BY
//     VALUE. Go's ReadWriter shares the very same
//     Reader/Writer objects. The gostd pair is
//     consistent only while it is the sole owner:
//     NewReadWriter takes ownership; do NOT keep
//     using the original Reader/Writer afterwards
//     (their buffered state would split from the
//     pair's). Use the pair's .r / .w fields.
//   - A zero-value Reader/Writer/Scanner is NOT
//     usable (Go's is, after Reset). The
//     constructors are required; Reset on a struct
//     whose buffer was never allocated grows a
//     default one, but the handle fields still need a
//     constructor or a Reset call to be set.
//   - ReadLine's nil line is an empty Vec<u8>
//     (gostd has no nil slices; len 0 is the test).
//   - Scanner.Buffer takes the caller's buffer as a
//     copy of its full length (Vec exposes no
//     capacity); Go uses buf[0:cap(buf)].
//   - Writer.AvailableBuffer returns an empty Vec
//     (no capacity to report); append to it and pass
//     it to the next Write, as in Go.
//   - A 0-byte nil-error write from the underlying
//     writer spins forever in Go's Write loop too;
//     gostd matches Go (it hangs) rather than
//     inventing an error.
//
// Coverage (census §7.2.1 bufio, 1a):
//   Reader: NewReader/NewReaderSize, Read/ReadByte/
//     ReadRune/ReadBytes/ReadString/ReadSlice/
//     ReadLine/Peek/UnreadByte/UnreadRune/Discard/
//     Buffered/Reset/Size (+ WriteTo, extra).
//   Writer: NewWriter/NewWriterSize, Write/WriteByte/
//     WriteString/WriteRune/Available/Buffered/
//     Flush/Reset (+ Size/AvailableBuffer/ReadFrom).
//   ReadWriter: NewReadWriter.
//   Scanner: NewScanner, Scan/Text/Bytes/Err/Split/
//     Buffer; split funcs ScanLines/ScanWords/
//     ScanRunes/ScanBytes.
//   Sentinel accessors: go_bufio_eof + the nine
//   go_bufio_err_* constructors above.

const GO_BUFIO_DEFAULT_SIZE: i64 = 4096;
const GO_BUFIO_MIN_READ_SIZE: i64 = 16;
const GO_BUFIO_MAX_EMPTY_READS: i64 = 100;
const GO_BUFIO_MAX_SCAN_TOKEN_SIZE: i64 = 65536;
const GO_BUFIO_START_BUF_SIZE: i64 = 4096;

const GO_BUFIO_ID_EOF: i64 = 900010;
const GO_BUFIO_ID_BUFFER_FULL: i64 = 900033;
const GO_BUFIO_ID_NEGATIVE_COUNT: i64 = 900034;
const GO_BUFIO_ID_INVALID_UNREAD_BYTE: i64 = 900035;
const GO_BUFIO_ID_INVALID_UNREAD_RUNE: i64 = 900023;
const GO_BUFIO_ID_TOO_LONG: i64 = 900024;
const GO_BUFIO_ID_NEGATIVE_ADVANCE: i64 = 900025;
const GO_BUFIO_ID_ADVANCE_TOO_FAR: i64 = 900026;
const GO_BUFIO_ID_BAD_READ_COUNT: i64 = 900027;
const GO_BUFIO_ID_FINAL_TOKEN: i64 = 900028;

// ---------- result structs ----------

// (n, err) for a read into an append target, and for
// a write of a whole Vec, is GoIoResult (io.sla):
// R1400 unifies the read/write result types on
// GoIoResult, so GoBufioReadResult /
// GoBufioWriteResult are DELETED (they were
// structurally identical to GoIoResult, { n, err }).
// GoBufioCountResult below is a different struct:
// it counts, it is not a byte count into a buffer.

// (n, err) where n is a count, not a byte count into
// a caller buffer: Discard / WriteTo / ReadFrom.
struct GoBufioCountResult {
    n: i64,
    err: ptr,
}

// Peek: the bytes (a copy, see header) + error.
struct GoBufioPeekResult {
    data: Vec<u8>,
    err: ptr,
}

struct GoBufioByteResult {
    b: u8,
    err: ptr,
}

struct GoBufioRuneResult {
    r: i64,
    size: i64,
    err: ptr,
}

// ReadSlice / ReadBytes / ReadString payload + error.
struct GoBufioSliceResult {
    line: Vec<u8>,
    err: ptr,
}

struct GoBufioBytesResult {
    data: Vec<u8>,
    err: ptr,
}

// ReadLine: line (no terminator), isPrefix, error.
struct GoBufioLineResult {
    line: Vec<u8>,
    is_prefix: bool,
    err: ptr,
}

// Writer.WriteRune: bytes written + error.
struct GoBufioWriteRuneResult {
    size: i64,
    err: ptr,
}

// collectFragments: the full buffers, the final
// fragment, their combined length, and the error.
struct GoBufioFragments {
    full: Vec<Vec<u8>>,
    frag: Vec<u8>,
    total: i64,
    err: ptr,
}

// SplitFunc result: bytes to advance, the token (if
// any), and the error (if any). ErrFinalToken is
// signalled by returning the final-token sentinel
// (target id 900028) as err; see Scanner.Scan.
struct GoBufioSplitResult {
    advance: i64,
    token: Vec<u8>,
    has_token: bool,
    err: ptr,
}

// ---------- byte helpers ----------

fn __go_bufio_append(dst: &Vec<u8>, src: Vec<u8>) -> void {
    let i = 0;
    while i < len(src) {
        dst.push(src[i]);
        i = i + 1;
    }
    return;
}

fn __go_bufio_slice(b: Vec<u8>, lo: i64, hi: i64) -> Vec<u8> {
    let out = Vec::new();
    let i = lo;
    while i < hi {
        out.push(b[i]);
        i = i + 1;
    }
    return out;
}

// Allocate a zero-filled Vec of exactly `size`
// bytes: the Reader/Writer backing buffer, whose
// length IS its capacity in gostd.
fn __go_bufio_new_buf(size: i64) -> Vec<u8> {
    let out = Vec::new();
    let i = 0;
    while i < size {
        out.push(0u8);
        i = i + 1;
    }
    return out;
}

// First index of c in b[from:to], or -1.
fn __go_bufio_index_byte_from(b: Vec<u8>, from: i64, to: i64, c: u8) -> i64 {
    let i = from;
    while i < to {
        if b[i] == c { return i; };
        i = i + 1;
    }
    return -1;
}

fn __go_bufio_index_byte(b: Vec<u8>, c: u8) -> i64 {
    return __go_bufio_index_byte_from(b, 0, len(b), c);
}

// ---------- error helpers ----------

// Is err a non-nil error with this target id?
fn __go_bufio_is_err(err: ptr, target_id: i64) -> bool {
    if err == go_errors_nil() { return false; };
    return go_errors_target_id(err) == target_id;
}

fn __go_bufio_is_eof(err: ptr) -> bool {
    return __go_bufio_is_err(err, GO_BUFIO_ID_EOF);
}

fn __go_bufio_no_progress() -> ptr {
    let msg = Vec::new();
    msg.push(105u8); msg.push(111u8); msg.push(58u8); msg.push(32u8);
    msg.push(110u8); msg.push(111u8); msg.push(32u8); msg.push(112u8);
    msg.push(114u8); msg.push(111u8); msg.push(103u8); msg.push(114u8);
    msg.push(101u8); msg.push(115u8); msg.push(115u8);
    return go_errors_new_with_id(msg, 900012);
}

fn __go_bufio_short_write() -> ptr {
    let msg = Vec::new();
    msg.push(105u8); msg.push(111u8); msg.push(58u8); msg.push(32u8);
    msg.push(115u8); msg.push(104u8); msg.push(111u8); msg.push(114u8);
    msg.push(116u8); msg.push(32u8); msg.push(119u8); msg.push(114u8);
    msg.push(105u8); msg.push(116u8); msg.push(101u8);
    return go_errors_new_with_id(msg, 900014);
}

// ---------- sentinel constructors ----------

// io.EOF, target id 900010. This is the SAME
// sentinel the io line owns -- not a second one.
// (strings.sla's go_strings_eof builds the identical
// id; whichever the frontend calls, errors.Is by id
// matches.)
fn go_bufio_eof() -> ptr {
    let msg = Vec::new();
    msg.push(69u8); msg.push(79u8); msg.push(70u8);
    return go_errors_new_with_id(msg, GO_BUFIO_ID_EOF);
}

