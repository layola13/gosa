// gostd compress/bzip2: the SLA-side model of Go's
// compress/bzip2 package (Go 1.27.2), over byte strings (Vec<u8>).
// Organisation follows the psa_std precedent: public
// entry points go_bzip2_*, private helpers __go_bzip2_*.
//
// Oracle: Go 1.27.2 compress/bzip2 (bzip2.go, bit_reader.go,
// huffman.go, move_to_front.go), mirrored from the box Go
// tree /usr/local/go/src/compress/bzip2/ into
// wave2-oracle/compress_bzip2/ (bzip2.go sha 75175949...,
// bit_reader.go sha a6e3de57..., huffman.go sha c7f62572...,
// move_to_front.go sha 9c58462d... -- all four match the
// box exactly).
//
// This file is number 31 in the splice order: the 28
// landed corpus files, then archive/tar (29), archive/zip
// (30), then this file (31). It is written against the fresh
// 603232ac plugin (with the B1 hashmap import); the
// installed plugin 0.1.8 fails earlier in the splice
// (raw 1009 in fmt) and never reaches this file.
//
// API map (Go -> gostd):
//   NewReader(r io.Reader) io.Reader ->
//     go_bzip2_new_reader over the compressed bytes
//     directly (divergence D0: gostd has no streaming
//     Reader handle; the bit reader runs over an index
//     into the caller's Vec<u8>).
//   (reader).Read -> go_bzip2_reader_read(r, dst, max)
//     appends up to max decompressed bytes to dst.
//   StructuralError -> go_bzip2_err_* constructors, one
//     target id per distinct Go message (900070-900089);
//     Error() text is "bzip2 data invalid: " + detail.
//   Internal (ported in full): bitReader, huffmanTree /
//     huffmanNode / newHuffmanTree / buildHuffmanNode,
//     moveToFrontDecoder, inverseBWT, updateCRC (+ the
//     256-entry table built by __go_bzip2_crc_table).
//   No writer exists in Go's compress/bzip2 (read-only
//   package); there is none here either.
//
// Divergences:
//   D0: NewReader takes the compressed bytes (Vec<u8>),
//     not an io.Reader. gostd has no streaming reader
//     handle; go_io_read_full is the random-access
//     primitive elsewhere in the corpus, and the bit
//     reader here is index-based over the same bytes.
//   D1: u32 does not exist in SLA (see crc32.sla); all
//     Go uint32 values (CRC state, tt entries, Huffman
//     codes) are u64 holding 32-bit values, masked to
//     32 bits at every step (crc32.sla precedent).
//   D2: Go's preRLE aliases tt (preRLE = tt[:bufIndex]);
//     SLA has no aliasing, so the reader walks tt
//     directly with pre_rle_len / pre_rle_used instead
//     of a separate preRLE field. Identical observable
//     behaviour: inverseBWT mutates tt in place and the
//     RLE walk reads the transformed entries.
//   D3: Go's crctab is a package-level var built once by
//     init(); gostd has no globals, so each reader owns
//     its table (built once in NewReader, crc_tab).
//   D4: Go's bitReader.ReadBits64 returns buffered bits
//     even after an error is set; this port mirrors Go
//     exactly (no sticky early return): it satisfies
//     from the buffer first and only reads a new byte
//     when more bits are needed.
//   D5: buildHuffmanNode guards level > 31 with the
//     "equal symbols" error. Go guards level == 31
//     inside the empty-side branch only; for valid
//     canonical codes (lengths 1..20, enforced in
//     readBlock) the depth never exceeds 20 + the
//     empty-side skips, so the guard is unreachable in
//     practice and exists only to keep the (31 - level)
//     shift defined in u64 arithmetic.
//   D6: The Huffman decode fast path reads br.n directly
//     (as in Go); the slow path goes through ReadBits.
//     The Go fast path masks the shift with & 63; this
//     port omits the mask because br.bits is always
//     < 64 here (at most 55 after a refill), so the
//     shift is already defined.
//   D7: readBlock's lengths slice is reused across trees
//     in Go; here newHuffmanTree takes &Vec<u64> and
//     copies into its own sorted pairs, so the caller's
//     lengths vec is untouched.
//   D8: Go's repeat / repeatPower are int; here they are
//     u64 (the repeat limit 2*1024*1024 and the
//     block-size bound are both far below 2^63, and the
//     values only flow into u64 shifts and comparisons).

@import "sa_std/vec.sa";

// ---------- constants ----------

const GO_BZIP2_FILE_MAGIC: u64 = 16986;
const GO_BZIP2_BLOCK_MAGIC: u64 = 54156738319193;
const GO_BZIP2_FINAL_MAGIC: u64 = 25779555029136;
const GO_BZIP2_CRC_POLY: u64 = 79764919;
const GO_BZIP2_INVALID_NODE: u64 = 65535;
const GO_BZIP2_REPEAT_LIMIT: u64 = 2097152;

// Live panic codes (defensive; unreachable from readBlock
// for valid streams, but present in the helpers exactly
// as in Go):
//   77465 newHuffmanTree: too few symbols (< 2 lengths)
//   77466 newMTFDecoder: too many symbols (> 256)
//   77467 newMTFDecoderWithRange: cannot have > 256 symbols
// Reserved spares: 77468-77472.
const GO_BZIP2_PANIC_HUFFMAN_TOO_FEW: i64 = 77465;
const GO_BZIP2_PANIC_MTF_TOO_MANY: i64 = 77466;
const GO_BZIP2_PANIC_MTF_RANGE_TOO_MANY: i64 = 77467;

// ---------- error helpers ----------

fn __go_bzip2_is_nil(e: ptr) -> bool {
    return e == go_errors_nil();
}

fn __go_bzip2_is_eof(e: ptr) -> bool {
    return go_errors_is(e, go_io_eof());
}

fn __go_bzip2_is_unexpected_eof(e: ptr) -> bool {
    return go_errors_is(e, go_io_err_unexpected_eof());
}

// "bzip2 data invalid: " -- the shared prefix of every
// StructuralError (Go's (StructuralError).Error()).
fn __go_bzip2_msg_prefix(out: &Vec<u8>) -> void {
    out.push(98u8);
    out.push(122u8);
    out.push(105u8);
    out.push(112u8);
    out.push(50u8);
    out.push(32u8);
    out.push(100u8);
    out.push(97u8);
    out.push(116u8);
    out.push(97u8);
    out.push(32u8);
    out.push(105u8);
    out.push(110u8);
    out.push(118u8);
    out.push(97u8);
    out.push(108u8);
    out.push(105u8);
    out.push(100u8);
    out.push(58u8);
    out.push(32u8);
    return;
}

fn __go_bzip2_slice(b: &Vec<u8>, lo: i64, hi: i64) -> Vec<u8> {
    let out = Vec::new();
    let i = lo;
    while i < hi {
        out.push(b[i]);
        i = i + 1;
    }
    return out;
}

// ---------- StructuralError constructors ----------
// One target id per distinct Go message (900070-900089).
// The full text is "bzip2 data invalid: " + detail.

fn __go_bzip2_err_bad_magic() -> ptr {
    let msg = Vec::new();
    __go_bzip2_msg_prefix(&msg);
    msg.push(98u8);
    msg.push(97u8);
    msg.push(100u8);
    msg.push(32u8);
    msg.push(109u8);
    msg.push(97u8);
    msg.push(103u8);
    msg.push(105u8);
    msg.push(99u8);
    msg.push(32u8);
    msg.push(118u8);
    msg.push(97u8);
    msg.push(108u8);
    msg.push(117u8);
    msg.push(101u8);
    return go_errors_new_with_id(msg, (900070 as i64));
}

