// ---------- public: typed wrappers (type.go) ----------
// Go's atomic.Int32 / Int64 / Uint32 / Uint64 /
// Uintptr / Bool / Pointer[T] methods. The int/uint
// wrappers delegate to the top-level functions,
// exactly like Go's type.go does; Bool and Pointer
// call their helpers directly (Go has no top-level
// bool functions, and Pointer[T] delegates to the
// Pointer top-level functions above). The zero value
// of every handle is the zero cell (Go's zero values
// are usable), so no separate zero constructor is
// needed beyond the go_sync_atomic_new_* family.

// --- Bool (type.go; backed by uint32 in Go) ---

// Go (*Bool).Load.
fn go_sync_atomic_bool_load(x: &GoAtomicBool) -> bool {
    return __go_sync_atomic_bool_load(x);
}

// Go (*Bool).Store.
fn go_sync_atomic_bool_store(x: &GoAtomicBool, val: bool) -> void {
    __go_sync_atomic_bool_store(x, val);
    return;
}

// Go (*Bool).Swap.
fn go_sync_atomic_bool_swap(x: &GoAtomicBool, new: bool) -> bool {
    return __go_sync_atomic_bool_swap(x, new);
}

// Go (*Bool).CompareAndSwap.
fn go_sync_atomic_bool_compare_and_swap(x: &GoAtomicBool, old: bool, new: bool) -> bool {
    let (_cur, ok) = __go_sync_atomic_bool_cmpxchg(x, old, new);
    return ok;
}

// --- Pointer[T] (type.go; T erased, seam (f)) ---

// Go (*Pointer[T]).Load: the address as i64 (nil = 0).
fn go_sync_atomic_pointer_load(x: &GoAtomicPointer) -> i64 {
    return go_sync_atomic_load_pointer(x);
}

// Go (*Pointer[T]).Store.
fn go_sync_atomic_pointer_store(x: &GoAtomicPointer, val: i64) -> void {
    go_sync_atomic_store_pointer(x, val);
    return;
}

// Go (*Pointer[T]).Swap.
