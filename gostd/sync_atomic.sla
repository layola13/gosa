// ---------- public: atomic.Value (value.go) ----------
// The frontend builds Store / Swap / CompareAndSwap
// arguments with go_sync_atomic_value_i64 / _bytes /
// _ptr below (seam (g)); a nil payload (present=false,
// kind 0) must never be passed to Store, Swap or
// CompareAndSwap-new -- the 77434 backstop fires if
// it is. Load returns present=false on an empty Value,
// exactly like Go's nil return.

// Go (*Value).Load: the most recent Store, or nil
// (present=false) if there has been no Store.
fn go_sync_atomic_value_load(v: &GoAtomicValue) -> GoAtomicValueResult {
    let k = __go_sync_atomic_value_wait_ready(v);
    if k == GO_SYNC_ATOMIC_VALUE_KIND_EMPTY {
        return __go_sync_atomic_value_empty();
    };
    if k == GO_SYNC_ATOMIC_VALUE_KIND_I64 {
        return GoAtomicValueResult { present: true, kind: k, i: v.i, b: Vec::new(), p: 0 };
    };
    if k == GO_SYNC_ATOMIC_VALUE_KIND_BYTES {
        return GoAtomicValueResult { present: true, kind: k, i: 0, b: v.b, p: 0 };
    };
    return GoAtomicValueResult { present: true, kind: k, i: 0, b: Vec::new(), p: v.p };
}

// Go (*Value).Store: sets the Value to val. All calls
// for one Value must use the same concrete kind;
// a different kind panics 77435, a nil or unsupported
// kind panics 77434. Mirrors Go's first-store
// protocol: claim the kind with CAS 0 -> -1, store
// the payload, then publish the kind.
fn go_sync_atomic_value_store(v: &GoAtomicValue, val: GoAtomicValueResult) -> void {
    if val.kind != GO_SYNC_ATOMIC_VALUE_KIND_I64 && val.kind != GO_SYNC_ATOMIC_VALUE_KIND_BYTES && val.kind != GO_SYNC_ATOMIC_VALUE_KIND_PTR {
        panic(77434);
    };
    let k = __go_sync_atomic_i64_load(&v.kind);
    while true {
        if k == GO_SYNC_ATOMIC_VALUE_KIND_EMPTY {
            let (_old, ok) = __go_sync_atomic_i64_cmpxchg(&v.kind, 0, GO_SYNC_ATOMIC_VALUE_KIND_IN_PROGRESS);
            if ok {
                __go_sync_atomic_value_store_payload(v, val);
                __go_sync_atomic_i64_store(&v.kind, val.kind);
                return;
            };
            k = __go_sync_atomic_i64_load(&v.kind);
        } else {
            if k == GO_SYNC_ATOMIC_VALUE_KIND_IN_PROGRESS {
                k = __go_sync_atomic_value_wait_ready(v);
            } else {
                if k != val.kind {
                    panic(77435);
                };
                __go_sync_atomic_value_store_payload(v, val);
                return;
            }
        }
    }
}

// Go (*Value).Swap: stores new and returns the
// previous value, or nil (present=false) if the Value
// was empty. Same type rules as Store (77434 /
// 77435). See DIVERGENCES for the payload window:
// the old value is read and the new one stored in
// two steps, not one atomic swap.
fn go_sync_atomic_value_swap(v: &GoAtomicValue, new: GoAtomicValueResult) -> GoAtomicValueResult {
    if new.kind != GO_SYNC_ATOMIC_VALUE_KIND_I64 && new.kind != GO_SYNC_ATOMIC_VALUE_KIND_BYTES && new.kind != GO_SYNC_ATOMIC_VALUE_KIND_PTR {
        panic(77434);
    };
    let k = __go_sync_atomic_i64_load(&v.kind);
    while true {
        if k == GO_SYNC_ATOMIC_VALUE_KIND_EMPTY {
            let (_old, ok) = __go_sync_atomic_i64_cmpxchg(&v.kind, 0, GO_SYNC_ATOMIC_VALUE_KIND_IN_PROGRESS);
            if ok {
                __go_sync_atomic_value_store_payload(v, new);
                __go_sync_atomic_i64_store(&v.kind, new.kind);
                return __go_sync_atomic_value_empty();
            };
            k = __go_sync_atomic_i64_load(&v.kind);
        } else {
            if k == GO_SYNC_ATOMIC_VALUE_KIND_IN_PROGRESS {
                k = __go_sync_atomic_value_wait_ready(v);
            } else {
                if k != new.kind {
                    panic(77435);
                };
                let old = go_sync_atomic_value_load(v);
                __go_sync_atomic_value_store_payload(v, new);
                return old;
            }
        }
    }
}

// Go (*Value).CompareAndSwap: swaps only if the
// current value equals old. A nil old on an empty
// Value performs the first store (returns true); a
// non-nil old on an empty Value returns false. A new
// payload whose kind differs from old's kind (when
// old is non-nil) or from the stored kind panics
// 77435; a nil or unsupported new kind panics 77434.
fn go_sync_atomic_value_compare_and_swap(v: &GoAtomicValue, old: GoAtomicValueResult, new: GoAtomicValueResult) -> bool {
    if new.kind != GO_SYNC_ATOMIC_VALUE_KIND_I64 && new.kind != GO_SYNC_ATOMIC_VALUE_KIND_BYTES && new.kind != GO_SYNC_ATOMIC_VALUE_KIND_PTR {
        panic(77434);
    };
    if old.present && old.kind != new.kind {
        panic(77435);
    };
    let k = __go_sync_atomic_i64_load(&v.kind);
    while true {
        if k == GO_SYNC_ATOMIC_VALUE_KIND_EMPTY {
            if !old.present {
                let (_o, ok) = __go_sync_atomic_i64_cmpxchg(&v.kind, 0, GO_SYNC_ATOMIC_VALUE_KIND_IN_PROGRESS);
                if ok {
                    __go_sync_atomic_value_store_payload(v, new);
                    __go_sync_atomic_i64_store(&v.kind, new.kind);
                    return true;
                };
                k = __go_sync_atomic_i64_load(&v.kind);
            } else {
                return false;
            }
        } else {
            if k == GO_SYNC_ATOMIC_VALUE_KIND_IN_PROGRESS {
                k = __go_sync_atomic_value_wait_ready(v);
            } else {
                if k != new.kind {
                    panic(77435);
                };
                let cur = go_sync_atomic_value_load(v);
                if !__go_sync_atomic_value_equal(cur, old) {
                    return false;
                };
                __go_sync_atomic_value_store_payload(v, new);
                return true;
            }
        }
    }
}

// ---------- public: Value payload constructors ----------
// The frontend builds Value arguments with these
// (seam (g)). There is no constructor for a nil
// payload: present=false is spelled by the empty
// result, which must never be passed to Store / Swap
// / CompareAndSwap-new (77434).

// An i64 payload (Go int / int64 / uint64 scalars
// funnelled to kind 1 by the frontend).
fn go_sync_atomic_value_i64(val: i64) -> GoAtomicValueResult {
    return GoAtomicValueResult { present: true, kind: GO_SYNC_ATOMIC_VALUE_KIND_I64, i: val, b: Vec::new(), p: 0 };
}

// A Vec<u8> payload (Go string or []byte -- the
// holder cannot tell them apart, seam (g)).
fn go_sync_atomic_value_bytes(val: Vec<u8>) -> GoAtomicValueResult {
    return GoAtomicValueResult { present: true, kind: GO_SYNC_ATOMIC_VALUE_KIND_BYTES, i: 0, b: val, p: 0 };
}

// A pointer payload (Go *T / unsafe.Pointer as an
// i64 address, nil = 0).
fn go_sync_atomic_value_ptr(val: i64) -> GoAtomicValueResult {
    return GoAtomicValueResult { present: true, kind: GO_SYNC_ATOMIC_VALUE_KIND_PTR, i: 0, b: Vec::new(), p: val };
}
