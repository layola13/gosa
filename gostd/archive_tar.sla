// headerError: "archive/tar: cannot encode header" plus
// "; and "-joined non-empty reasons (Go filters empties;
// with no reasons the prefix stands alone).
fn __go_tar_err_cannot_encode(reasons: Vec<Vec<u8>>) -> ptr {
    let msg = Vec::new();
    __go_tar_msg_prefix(&msg);
    msg.push(99u8);
    msg.push(97u8);
    msg.push(110u8);
    msg.push(110u8);
    msg.push(111u8);
    msg.push(116u8);
    msg.push(32u8);
    msg.push(101u8);
    msg.push(110u8);
    msg.push(99u8);
    msg.push(111u8);
    msg.push(100u8);
    msg.push(101u8);
    msg.push(32u8);
    msg.push(104u8);
    msg.push(101u8);
    msg.push(97u8);
    msg.push(100u8);
    msg.push(101u8);
    msg.push(114u8);
    let kept = 0;
    let i = 0;
    while i < len(reasons) {
        if len(reasons[i]) > 0 {
            if kept == 0 {
                msg.push(58u8);
                msg.push(32u8);
            } else {
                msg.push(59u8);
                msg.push(32u8);
                msg.push(97u8);
                msg.push(110u8);
                msg.push(100u8);
                msg.push(32u8);
            };
            __go_tar_append(&msg, reasons[i]);
            kept = kept + 1;
        };
        i = i + 1;
    }
    return go_errors_new_with_id(msg, GO_TAR_ID_ERR_CANNOT_ENCODE);
}

// Flush's missed-bytes error: "archive/tar: missed writing N bytes".
// Built with target 0 (Go returns a plain fmt.Errorf here, no
// sentinel identity).
fn __go_tar_err_missed_writing(n: i64) -> ptr {
    let msg = Vec::new();
    __go_tar_msg_prefix(&msg);
    msg.push(109u8);
    msg.push(105u8);
    msg.push(115u8);
    msg.push(115u8);
    msg.push(101u8);
    msg.push(100u8);
    msg.push(32u8);
    msg.push(119u8);
    msg.push(114u8);
    msg.push(105u8);
    msg.push(116u8);
    msg.push(105u8);
    msg.push(110u8);
    msg.push(103u8);
    msg.push(32u8);
    __go_tar_append(&msg, go_strconv_format_int(n, 10));
    msg.push(32u8);
    msg.push(98u8);
    msg.push(121u8);
    msg.push(116u8);
    msg.push(101u8);
    msg.push(115u8);
    return go_errors_new(msg);
}

// Is err the io.EOF sentinel? (S9: via errors.Is.)
fn __go_tar_is_eof(err: ptr) -> bool {
    return go_errors_is(err, go_io_eof());
}

// Is err nil? (go_errors_nil() is 0 as ptr.)
fn __go_tar_is_nil(err: ptr) -> bool {
    return err == go_errors_nil();
}

// ---------- Small helpers ----------

fn __go_tar_min(a: i64, b: i64) -> i64 {
    if a < b { return a; };
    return b;
}

fn __go_tar_max(a: i64, b: i64) -> i64 {
    if a > b { return a; };
    return b;
}

// Append src onto dst (Vec is a shared handle; the push is
// visible to the caller -- same pattern as __go_err_append).
fn __go_tar_append(dst: &Vec<u8>, src: Vec<u8>) -> void {
    let i = 0;
    while i < len(src) {
        dst.push(src[i]);
        i = i + 1;
    }
    return;
}

// Sub-slice copy: v[start..end].
fn __go_tar_slice(v: Vec<u8>, start: i64, end: i64) -> Vec<u8> {
    let out = Vec::new();
    let i = start;
    while i < end {
        out.push(v[i]);
        i = i + 1;
    }
    return out;
}

fn __go_tar_zero_block() -> Vec<u8> {
    let blk = Vec::new();
    let i = 0;
    while i < GO_TAR_BLOCK_SIZE {
        blk.push(0u8);
        i = i + 1;
    }
    return blk;
}

fn __go_tar_block_is_zero(blk: Vec<u8>) -> bool {
    let i = 0;
    while i < len(blk) {
        if blk[i] != 0u8 { return false; };
        i = i + 1;
    }
    return true;
}

// blockPadding: -offset & (blockSize-1).
fn __go_tar_block_padding(offset: i64) -> i64 {
    return (0 - offset) & (GO_TAR_BLOCK_SIZE - 1);
}

fn __go_tar_is_header_only_type(flag: i64) -> bool {
    if flag == GO_TAR_TYPE_LINK { return true; };
    if flag == GO_TAR_TYPE_SYMLINK { return true; };
    if flag == GO_TAR_TYPE_CHAR { return true; };
    if flag == GO_TAR_TYPE_BLOCK { return true; };
    if flag == GO_TAR_TYPE_DIR { return true; };
    if flag == GO_TAR_TYPE_FIFO { return true; };
    return false;
}

fn __go_tar_has_nul(s: Vec<u8>) -> bool {
    let i = 0;
    while i < len(s) {
        if s[i] == 0u8 { return true; };
        i = i + 1;
    }
    return false;
}

fn __go_tar_is_ascii(s: Vec<u8>) -> bool {
    let i = 0;
    while i < len(s) {
        if (s[i] as i64) >= 128 { return false; };
        i = i + 1;
    }
    return true;
}

// Replace every non-ASCII byte with '?'.
fn __go_tar_to_ascii(s: Vec<u8>) -> Vec<u8> {
    let out = Vec::new();
    let i = 0;
    while i < len(s) {
        if (s[i] as i64) >= 128 {
            out.push(63u8);
        } else {
            out.push(s[i]);
        };
        i = i + 1;
    }
    return out;
}

// parseString: bytes up to the first NUL.
fn __go_tar_parse_string(b: Vec<u8>) -> Vec<u8> {
    let i = 0;
    while i < len(b) {
        if b[i] == 0u8 {
            return __go_tar_slice(b, 0, i);
        };
        i = i + 1;
    }
    return go_bytes_clone(b);
}

// Time helpers. GoTime has no zero sentinel in the corpus;
// the zero time is unix_ns == 0 (divergence D1).
fn __go_tar_time_is_zero(t: GoTime) -> bool {
    return t.unix_ns == 0;
}

// Floor-split unix_ns into (sec, nsec in [0, 1e9)).
fn __go_tar_time_split(t: GoTime) -> (i64, i64) {
    let sec = t.unix_ns / 1000000000;
    let ns = t.unix_ns % 1000000000;
    if ns < 0 {
        sec = sec - 1;
        ns = ns + 1000000000;
    };
    return (sec, ns);
}

fn __go_tar_time_trunc_sec(t: GoTime) -> GoTime {
    let (sec, _ns) = __go_tar_time_split(t);
    return go_time_unix(sec, 0);
}

// filepath.IsLocal, Unix-only: the cleaned path must be
// non-empty, relative, and contain no leading "..".
fn __go_tar_is_local(name: Vec<u8>) -> bool {
    if len(name) == 0 { return false; };
    let clean = go_path_clean(name);
    if len(clean) == 0 { return false; };
    if clean[0] == 47u8 { return false; };
    if go_bytes_equal(clean, __go_tar_dotdot()) { return false; };
    let dotdot_slash = __go_tar_dotdot_slash();
    if go_bytes_has_prefix(clean, dotdot_slash) { return false; };
    return true;
}

fn __go_tar_dotdot() -> Vec<u8> {
    let v = Vec::new();
    v.push(46u8);
    v.push(46u8);
    return v;
}

fn __go_tar_dotdot_slash() -> Vec<u8> {
    let v = Vec::new();
    v.push(46u8);
    v.push(46u8);
    v.push(47u8);
    return v;
}

// PAX record lookup: returns (value, found).
fn __go_tar_pax_get(recs: Vec<GosTarPaxRecord>, key: Vec<u8>) -> (Vec<u8>, bool) {
    let i = 0;
    while i < len(recs) {
        if go_bytes_equal(recs[i].key, key) {
            return (go_bytes_clone(recs[i].value), true);
        };
        i = i + 1;
    }
    return (Vec::new(), false);
}

// PAX record set: returns a new record list with key
// overwritten (or appended). Functional style -- avoids
// assigning to a field of an indexed element.
fn __go_tar_pax_set(recs: Vec<GosTarPaxRecord>, key: Vec<u8>, value: Vec<u8>) -> Vec<GosTarPaxRecord> {
    let out = Vec::new();
    let i = 0;
    let replaced = false;
    while i < len(recs) {
        if go_bytes_equal(recs[i].key, key) {
            out.push(GosTarPaxRecord { key: go_bytes_clone(recs[i].key), value: go_bytes_clone(value) });
            replaced = true;
        } else {
            out.push(GosTarPaxRecord { key: go_bytes_clone(recs[i].key), value: go_bytes_clone(recs[i].value) });
        };
        i = i + 1;
    }
    if replaced == false {
        out.push(GosTarPaxRecord { key: key, value: value });
    };
    return out;
}

// Zero GosTarHeader.
fn __go_tar_header_new() -> GosTarHeader {
    return GosTarHeader {
        typeflag: 0,
        name: Vec::new(),
        linkname: Vec::new(),
        size: 0,
        mode: 0,
        uid: 0,
        gid: 0,
        uname: Vec::new(),
        gname: Vec::new(),
        mod_time: go_time_unix(0, 0),
        access_time: go_time_unix(0, 0),
        change_time: go_time_unix(0, 0),
        devmajor: 0,
        devminor: 0,
        xattrs: Vec::new(),
        pax_records: Vec::new(),
        format: 0,
    };
}

// Split a long name into (prefix, suffix) for USTAR
// (writer.go splitUSTARPath, verbatim logic). Returns
// (prefix, suffix, ok); ok is false when the name fits
// in the name field already, is non-ASCII, or cannot be
// split at a '/'.
fn __go_tar_split_ustar_path(name: Vec<u8>) -> (Vec<u8>, Vec<u8>, bool) {
    let length = len(name);
    if length <= GO_TAR_NAME_SIZE {
        return (Vec::new(), Vec::new(), false);
    };
    if __go_tar_is_ascii(name) == false {
        return (Vec::new(), Vec::new(), false);
    };
    if length > GO_TAR_PREFIX_SIZE + 1 {
        length = GO_TAR_PREFIX_SIZE + 1;
    } else if name[length - 1] == 47u8 {
        length = length - 1;
    };
    let i = go_bytes_last_index_byte(__go_tar_slice(name, 0, length), 47u8);
    let nlen = len(name) - i - 1;
    let plen = i;
    if i <= 0 || nlen > GO_TAR_NAME_SIZE || nlen == 0 || plen > GO_TAR_PREFIX_SIZE {
        return (Vec::new(), Vec::new(), false);
    };
    return (__go_tar_slice(name, 0, i), __go_tar_slice(name, i + 1, len(name)), true);
}

// ---------- Numeric fields ----------
// Field offsets (from the oracle's headerV7/headerGNU/
// headerSTAR/headerUSTAR layouts):
//   name 0:100, mode 100:8, uid 108:8, gid 116:8, size 124:12,
//   modTime 136:12, chksum 148:8, typeFlag 156:1, linkName 157:100,
//   magic 257:6, version 263:2, uname 265:32, gname 297:32,
//   devMajor 329:8, devMinor 337:8,
//   GNU atime 345:12, GNU ctime 357:12, GNU sparse 386:97,
//   GNU realSize 483:12,
//   STAR prefix 345:131, STAR atime 476:12, STAR ctime 488:12,
//   STAR trailer 508:4, USTAR prefix 345:155.

fn __go_tar_parse_octal(b: Vec<u8>) -> (i64, ptr) {
    let cutset = Vec::new();
    cutset.push(32u8);
    cutset.push(0u8);
    let s = go_bytes_trim(b, cutset);
    if len(s) == 0 {
        return (0, go_errors_nil());
    };
    let r = go_strconv_parse_uint(__go_tar_parse_string(s), 8, 64);
    if __go_tar_is_nil(r.err) == false {
        return (0, __go_tar_err_header());
    };
    return (r.v as i64, go_errors_nil());
}

fn __go_tar_parse_numeric(b: Vec<u8>) -> (i64, ptr) {
    if len(b) == 0 {
        return (0, __go_tar_err_header());
    };
    if ((b[0] as i64) & 128) != 0 {
        let inv: u64 = 0;
        if ((b[0] as i64) & 64) != 0 {
            inv = 0u64 - 1;
        };
        let x: u64 = 0;
        let i = 0;
        while i < len(b) {
            let c: u64 = (b[i] as u64) ^ inv;
            if i == 0 {
                c = c & 127u64;
            };
            if (x >> 56) > 0 {
                return (0, __go_tar_err_header());
            };
            x = (x << 8) | c;
            i = i + 1;
        }
        if (x >> 63) > 0 {
            return (0, __go_tar_err_header());
        };
        if inv != 0 {
            return (0 - (x as i64) - 1, go_errors_nil());
        };
        return (x as i64, go_errors_nil());
    };
    return __go_tar_parse_octal(b);
}

fn __go_tar_fits_in_octal(n: i64, x: i64) -> bool {
    if n >= 22 {
        return x >= 0;
    };
    let oct_bits = (n - 1) * 3;
    let limit = (1u64 << (oct_bits as u64)) as i64;
    return x >= 0 && x < limit;
}

fn __go_tar_fits_in_base256(n: i64, x: i64) -> bool {
    if n >= 9 {
        return true;
    };
    let bin_bits = (n - 1) * 8;
    let limit = (1u64 << (bin_bits as u64)) as i64;
    return x >= (0 - limit) && x < limit;
}

// formatString: copy s into blk[off..off+field_len), NUL
// terminate if it fits; ErrFieldTooLong otherwise, but the
// copy still happens (truncated). The trailing-slash quirk:
// when s overflows and the last field byte is '/', trim
// trailing slashes from s and store the trimmed value, but
// still return the error.
fn __go_tar_format_string(blk: &Vec<u8>, off: i64, field_len: i64, s: Vec<u8>) -> ptr {
    let err = go_errors_nil();
    let n = len(s);
    if n > field_len {
        err = __go_tar_err_field_too_long();
    };
    let m = __go_tar_min(n, field_len);
    let i = 0;
    while i < m {
        blk[off + i] = s[i];
        i = i + 1;
    }
    if n < field_len {
        blk[off + n] = 0u8;
    };
    if n > field_len && blk[off + field_len - 1] == 47u8 {
        let t = field_len - 1;
        while t > 0 {
            if s[t - 1] == 47u8 {
                t = t - 1;
            } else {
                break;
            };
        }
        let j = 0;
        while j < t {
            blk[off + j] = s[j];
            j = j + 1;
        }
        blk[off + t] = 0u8;
    };
    return err;
}

// formatOctal: '0'-pad s to field_len-1 digits, then
// formatString (which NUL-terminates the last byte).
fn __go_tar_format_octal(blk: &Vec<u8>, off: i64, field_len: i64, x: i64) -> ptr {
    let err = go_errors_nil();
    let v = x;
    if __go_tar_fits_in_octal(field_len, x) == false {
        v = 0;
        err = __go_tar_err_field_too_long();
    };
    let s = go_strconv_format_int(v, 8);
    let pad = field_len - 1 - len(s);
    let full = Vec::new();
    let i = 0;
    while i < pad {
        full.push(48u8);
        i = i + 1;
    }
    __go_tar_append(&full, s);
    let e2 = __go_tar_format_string(blk, off, field_len, full);
    if __go_tar_is_nil(e2) == false {
        return e2;
    };
    return err;
}

// formatNumeric: octal when it fits, else base-256 with
// the 0x80 flag bit on the first byte, else octal zero
// plus ErrFieldTooLong (Go's last-resort path).
fn __go_tar_format_numeric(blk: &Vec<u8>, off: i64, field_len: i64, x: i64) -> ptr {
    if __go_tar_fits_in_octal(field_len, x) {
        return __go_tar_format_octal(blk, off, field_len, x);
    };
    if __go_tar_fits_in_base256(field_len, x) {
        let ux = x as u64;
        let i = field_len - 1;
        while i >= 0 {
            blk[off + i] = (ux & 255u64) as u8;
            ux = ux >> 8;
            i = i - 1;
        }
        blk[off] = ((blk[off] as u64) | 128u64) as u8;
        return go_errors_nil();
    };
    let _e = __go_tar_format_octal(blk, off, field_len, 0);
    return __go_tar_err_field_too_long();
}

// ---------- Checksum and format detection ----------

fn __go_tar_compute_checksum(blk: &Vec<u8>) -> (i64, i64) {
    let unsigned = 0;
    let signed = 0;
    let i = 0;
    while i < len(blk) {
        if i >= 148 && i < 156 {
            unsigned = unsigned + 32;
            signed = signed + 32;
        } else {
            let b = blk[i] as i64;
            unsigned = unsigned + b;
            if b >= 128 {
                signed = signed + (b - 256);
            } else {
                signed = signed + b;
            };
        };
        i = i + 1;
    }
    return (unsigned, signed);
}

fn __go_tar_magic_ustar() -> Vec<u8> {
    let v = Vec::new();
    v.push(117u8);
    v.push(115u8);
    v.push(116u8);
    v.push(97u8);
    v.push(114u8);
    v.push(0u8);
    return v;
}

fn __go_tar_version_ustar() -> Vec<u8> {
    let v = Vec::new();
    v.push(48u8);
    v.push(48u8);
    return v;
}

fn __go_tar_magic_gnu() -> Vec<u8> {
    let v = Vec::new();
    v.push(117u8);
    v.push(115u8);
    v.push(116u8);
    v.push(97u8);
    v.push(114u8);
    v.push(32u8);
    return v;
}

fn __go_tar_version_gnu() -> Vec<u8> {
    let v = Vec::new();
    v.push(32u8);
    v.push(0u8);
    return v;
}

fn __go_tar_trailer_star() -> Vec<u8> {
    let v = Vec::new();
    v.push(116u8);
    v.push(97u8);
    v.push(114u8);
    v.push(0u8);
    return v;
}

// getFormat: verify the checksum, then guess the format
// from the magic values. FormatUnknown on checksum failure.
fn __go_tar_get_format(blk: Vec<u8>) -> i64 {
    let (value, perr) = __go_tar_parse_octal(__go_tar_slice(blk, 148, 156));
    let (chksum1, chksum2) = __go_tar_compute_checksum(&blk);
    if __go_tar_is_nil(perr) == false {
        return GO_TAR_FORMAT_UNKNOWN;
    };
    if value != chksum1 && value != chksum2 {
        return GO_TAR_FORMAT_UNKNOWN;
    };
    let magic = __go_tar_slice(blk, 257, 263);
    let version = __go_tar_slice(blk, 263, 265);
    let trailer = __go_tar_slice(blk, 508, 512);
    if go_bytes_equal(magic, __go_tar_magic_ustar()) && go_bytes_equal(trailer, __go_tar_trailer_star()) {
        return GO_TAR_FORMAT_STAR;
    };
    if go_bytes_equal(magic, __go_tar_magic_ustar()) {
        return GO_TAR_FORMAT_USTAR | GO_TAR_FORMAT_PAX;
    };
    if go_bytes_equal(magic, __go_tar_magic_gnu()) && go_bytes_equal(version, __go_tar_version_gnu()) {
        return GO_TAR_FORMAT_GNU;
    };
    return GO_TAR_FORMAT_V7;
}

// setFormat: write the magic values for the format, then
// update the checksum field (6 octal digits, NUL, space).
// A V7 format writes nothing. Any other unknown format
// panics -- same as Go's panic("invalid format"); the
// panic code is the generic invalid-format code 77400
// (gostd block base, no tar code is attached to it).
fn __go_tar_set_format(blk: &Vec<u8>, format: i64) -> void {
    if (format & GO_TAR_FORMAT_V7) != 0 {
    } else if (format & GO_TAR_FORMAT_GNU) != 0 {
        __go_tar_put_bytes(blk, 257, __go_tar_magic_gnu());
        __go_tar_put_bytes(blk, 263, __go_tar_version_gnu());
    } else if (format & GO_TAR_FORMAT_STAR) != 0 {
        __go_tar_put_bytes(blk, 257, __go_tar_magic_ustar());
        __go_tar_put_bytes(blk, 263, __go_tar_version_ustar());
        __go_tar_put_bytes(blk, 508, __go_tar_trailer_star());
    } else if (format & (GO_TAR_FORMAT_USTAR | GO_TAR_FORMAT_PAX)) != 0 {
        __go_tar_put_bytes(blk, 257, __go_tar_magic_ustar());
        __go_tar_put_bytes(blk, 263, __go_tar_version_ustar());
    } else {
        panic(77400);
    };
    let (chksum, _signed) = __go_tar_compute_checksum(blk);
    __go_tar_format_octal(blk, 148, 7, chksum);
    blk[155] = 32u8;
    return;
}

// Copy src bytes into blk at off.
fn __go_tar_put_bytes(blk: &Vec<u8>, off: i64, src: Vec<u8>) -> void {
    let i = 0;
    while i < len(src) {
        blk[off + i] = src[i];
        i = i + 1;
    }
    return;
}

// ---------- PAX records ----------
// PAX key ids for __go_tar_pax_key (SLA has no string
// literals, so keys are built by pushing byte codes).
const GO_TAR_KEY_PATH: i64 = 0;
const GO_TAR_KEY_LINKPATH: i64 = 1;
const GO_TAR_KEY_SIZE: i64 = 2;
const GO_TAR_KEY_UID: i64 = 3;
const GO_TAR_KEY_GID: i64 = 4;
const GO_TAR_KEY_UNAME: i64 = 5;
const GO_TAR_KEY_GNAME: i64 = 6;
const GO_TAR_KEY_MTIME: i64 = 7;
const GO_TAR_KEY_ATIME: i64 = 8;
const GO_TAR_KEY_CTIME: i64 = 9;
const GO_TAR_KEY_GNU_MAJOR: i64 = 10;
const GO_TAR_KEY_GNU_MINOR: i64 = 11;
const GO_TAR_KEY_GNU_NAME: i64 = 12;
const GO_TAR_KEY_GNU_SIZE: i64 = 13;
const GO_TAR_KEY_GNU_REALSIZE: i64 = 14;
const GO_TAR_KEY_GNU_MAP: i64 = 15;
const GO_TAR_KEY_GNU_NUMBLOCKS: i64 = 16;
const GO_TAR_KEY_GNU_OFFSET: i64 = 17;
const GO_TAR_KEY_GNU_NUMBYTES: i64 = 18;
const GO_TAR_KEY_GNU_PREFIX: i64 = 19;
const GO_TAR_KEY_SCHILY_XATTR: i64 = 20;

fn __go_tar_pax_key(id: i64) -> Vec<u8> {
    let v = Vec::new();
    if id == GO_TAR_KEY_PATH {
        v.push(112u8);
        v.push(97u8);
        v.push(116u8);
        v.push(104u8);
    } else if id == GO_TAR_KEY_LINKPATH {
        v.push(108u8);
        v.push(105u8);
        v.push(110u8);
        v.push(107u8);
        v.push(112u8);
        v.push(97u8);
        v.push(116u8);
        v.push(104u8);
    } else if id == GO_TAR_KEY_SIZE {
        v.push(115u8);
        v.push(105u8);
        v.push(122u8);
        v.push(101u8);
    } else if id == GO_TAR_KEY_UID {
        v.push(117u8);
        v.push(105u8);
        v.push(100u8);
    } else if id == GO_TAR_KEY_GID {
        v.push(103u8);
        v.push(105u8);
        v.push(100u8);
    } else if id == GO_TAR_KEY_UNAME {
        v.push(117u8);
        v.push(110u8);
        v.push(97u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_KEY_GNAME {
        v.push(103u8);
        v.push(110u8);
        v.push(97u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_KEY_MTIME {
        v.push(109u8);
        v.push(116u8);
        v.push(105u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_KEY_ATIME {
        v.push(97u8);
        v.push(116u8);
        v.push(105u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_KEY_CTIME {
        v.push(99u8);
        v.push(116u8);
        v.push(105u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_KEY_GNU_MAJOR {
        __go_tar_append(&v, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX));
        v.push(109u8);
        v.push(97u8);
        v.push(106u8);
        v.push(111u8);
        v.push(114u8);
    } else if id == GO_TAR_KEY_GNU_MINOR {
        __go_tar_append(&v, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX));
        v.push(109u8);
        v.push(105u8);
        v.push(110u8);
        v.push(111u8);
        v.push(114u8);
    } else if id == GO_TAR_KEY_GNU_NAME {
        __go_tar_append(&v, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX));
        v.push(110u8);
        v.push(97u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_KEY_GNU_SIZE {
        __go_tar_append(&v, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX));
        v.push(115u8);
        v.push(105u8);
        v.push(122u8);
        v.push(101u8);
    } else if id == GO_TAR_KEY_GNU_REALSIZE {
        __go_tar_append(&v, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX));
        v.push(114u8);
        v.push(101u8);
        v.push(97u8);
        v.push(108u8);
        v.push(115u8);
        v.push(105u8);
        v.push(122u8);
        v.push(101u8);
    } else if id == GO_TAR_KEY_GNU_MAP {
        __go_tar_append(&v, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX));
        v.push(109u8);
        v.push(97u8);
        v.push(112u8);
    } else if id == GO_TAR_KEY_GNU_NUMBLOCKS {
        __go_tar_append(&v, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX));
        v.push(110u8);
        v.push(117u8);
        v.push(109u8);
        v.push(98u8);
        v.push(108u8);
        v.push(111u8);
        v.push(99u8);
        v.push(107u8);
        v.push(115u8);
    } else if id == GO_TAR_KEY_GNU_OFFSET {
        __go_tar_append(&v, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX));
        v.push(111u8);
        v.push(102u8);
        v.push(102u8);
        v.push(115u8);
        v.push(101u8);
        v.push(116u8);
    } else if id == GO_TAR_KEY_GNU_NUMBYTES {
        __go_tar_append(&v, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX));
        v.push(110u8);
        v.push(117u8);
        v.push(109u8);
        v.push(98u8);
        v.push(121u8);
        v.push(116u8);
        v.push(101u8);
        v.push(115u8);
    } else if id == GO_TAR_KEY_GNU_PREFIX {
        v.push(71u8);
        v.push(78u8);
        v.push(85u8);
        v.push(46u8);
        v.push(115u8);
        v.push(112u8);
        v.push(97u8);
        v.push(114u8);
        v.push(115u8);
        v.push(101u8);
        v.push(46u8);
    } else if id == GO_TAR_KEY_SCHILY_XATTR {
        v.push(83u8);
        v.push(67u8);
        v.push(72u8);
        v.push(73u8);
        v.push(76u8);
        v.push(89u8);
        v.push(46u8);
        v.push(120u8);
        v.push(97u8);
        v.push(116u8);
        v.push(116u8);
        v.push(114u8);
        v.push(46u8);
    };
    return v;
}

// parsePAXTime: "%d.%d" with optional sub-second part.
// Negative times get the negative correction (Go semantics).
fn __go_tar_parse_pax_time(s: Vec<u8>) -> (GoTime, ptr) {
    let idx = go_bytes_index_byte(s, 46u8);
    let ss = Vec::new();
    let sn = Vec::new();
    if idx < 0 {
        ss = go_bytes_clone(s);
    } else {
        ss = __go_tar_slice(s, 0, idx);
        sn = __go_tar_slice(s, idx + 1, len(s));
    };
    let r = go_strconv_parse_int(ss, 10, 64);
    if __go_tar_is_nil(r.err) == false {
        return (go_time_unix(0, 0), __go_tar_err_header());
    };
    let secs = r.v;
    if len(sn) == 0 {
        return (go_time_unix(secs, 0), go_errors_nil());
    };
    let nano = Vec::new();
    let i = 0;
    while i < 9 {
        nano.push(48u8);
        i = i + 1;
    }
    let j = 0;
    while j < len(sn) {
        let c = sn[j];
        if c < 48u8 || c > 57u8 {
            return (go_time_unix(0, 0), __go_tar_err_header());
        };
        if j < 9 {
            nano[j] = c;
        };
        j = j + 1;
    }
    let rn = go_strconv_parse_int(nano, 10, 64);
    if __go_tar_is_nil(rn.err) == false {
        return (go_time_unix(0, 0), __go_tar_err_header());
    };
    let nsecs = rn.v;
    if len(ss) > 0 && ss[0] == 45u8 {
        return (go_time_unix(secs, 0 - nsecs), go_errors_nil());
    };
    return (go_time_unix(secs, nsecs), go_errors_nil());
}

// formatPAXTime: seconds, or seconds.fraction with
// trailing zeros trimmed. Negative times get the sign
// correction (Go semantics).
fn __go_tar_format_pax_time(t: GoTime) -> Vec<u8> {
    let (secs, nsecs) = __go_tar_time_split(t);
    if nsecs == 0 {
        return go_strconv_format_int(secs, 10);
    };
    let sign = Vec::new();
    if secs < 0 {
        sign.push(45u8);
        secs = 0 - (secs + 1);
        nsecs = 0 - (nsecs - 1000000000);
    };
    let frac = go_strconv_format_int(nsecs, 10);
    let pad = 9 - len(frac);
    let full = Vec::new();
    let i = 0;
    while i < pad {
        full.push(48u8);
        i = i + 1;
    }
    __go_tar_append(&full, frac);
    let out = Vec::new();
    __go_tar_append(&out, sign);
    __go_tar_append(&out, go_strconv_format_int(secs, 10));
    out.push(46u8);
    __go_tar_append(&out, full);
    while len(out) > 0 {
        if out[len(out) - 1] == 48u8 {
            out.pop();
        } else {
            break;
        };
    }
    return out;
}

// parsePAXRecord: "N key=value\n" -> (record, remainder, err).
fn __go_tar_parse_pax_record(s: Vec<u8>) -> (GosTarPaxRecord, Vec<u8>, ptr) {
    let empty_rec = GosTarPaxRecord { key: Vec::new(), value: Vec::new() };
    let idx = go_bytes_index_byte(s, 32u8);
    if idx < 0 {
        return (empty_rec, go_bytes_clone(s), __go_tar_err_header());
    };
    let n_str = __go_tar_slice(s, 0, idx);
    let rest = __go_tar_slice(s, idx + 1, len(s));
    let r = go_strconv_parse_int(n_str, 10, 64);
    if __go_tar_is_nil(r.err) == false {
        return (empty_rec, go_bytes_clone(s), __go_tar_err_header());
    };
    let n = r.v;
    if n < 5 || n > len(s) {
        return (empty_rec, go_bytes_clone(s), __go_tar_err_header());
    };
    n = n - (len(n_str) + 1);
    if n <= 0 {
        return (empty_rec, go_bytes_clone(s), __go_tar_err_header());
    };
    let rec = __go_tar_slice(rest, 0, n - 1);
    if rest[n - 1] != 10u8 {
        return (empty_rec, go_bytes_clone(s), __go_tar_err_header());
    };
    let rem = __go_tar_slice(rest, n, len(rest));
    let kidx = go_bytes_index_byte(rec, 61u8);
    if kidx < 0 {
        return (empty_rec, go_bytes_clone(s), __go_tar_err_header());
    };
    let k = __go_tar_slice(rec, 0, kidx);
    let v = __go_tar_slice(rec, kidx + 1, len(rec));
    if __go_tar_valid_pax_record(k, v) == false {
        return (empty_rec, go_bytes_clone(s), __go_tar_err_header());
    };
    return (GosTarPaxRecord { key: k, value: v }, rem, go_errors_nil());
}

// formatPAXRecord: build "N key=value\n" with the size
// field accounting for its own width (two-pass).
fn __go_tar_format_pax_record(k: Vec<u8>, v: Vec<u8>) -> (Vec<u8>, ptr) {
    if __go_tar_valid_pax_record(k, v) == false {
        return (Vec::new(), __go_tar_err_header());
    };
    let size = len(k) + len(v) + 3;
    size = size + len(go_strconv_itoa(size));
    let record = __go_tar_build_pax_record(size, k, v);
    if len(record) != size {
        size = len(record);
        record = __go_tar_build_pax_record(size, k, v);
    };
    return (record, go_errors_nil());
}

fn __go_tar_build_pax_record(size: i64, k: Vec<u8>, v: Vec<u8>) -> Vec<u8> {
    let out = Vec::new();
    __go_tar_append(&out, go_strconv_itoa(size));
    out.push(32u8);
    __go_tar_append(&out, k);
    out.push(61u8);
    __go_tar_append(&out, v);
    out.push(10u8);
    return out;
}

// validPAXRecord: non-empty key without '=', and no NUL
// in the value for path-like keys, no NUL in the key
// otherwise.
fn __go_tar_valid_pax_record(k: Vec<u8>, v: Vec<u8>) -> bool {
    if len(k) == 0 {
        return false;
    };
    if go_bytes_index_byte(k, 61u8) >= 0 {
        return false;
    };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_PATH)) || go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_LINKPATH)) || go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_UNAME)) || go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_GNAME)) {
        return __go_tar_has_nul(v) == false;
    };
    return __go_tar_has_nul(k) == false;
}

// ---------- Sparse helpers ----------

fn __go_tar_sparse_end(e: GosTarSparseEntry) -> i64 {
    return e.offset + e.length;
}

fn __go_tar_validate_sparse_entries(sp: Vec<GosTarSparseEntry>, size: i64) -> bool {
    if size < 0 {
        return false;
    };
    let pre = GosTarSparseEntry { offset: 0, length: 0 };
    let i = 0;
    while i < len(sp) {
        let cur = sp[i];
        if cur.offset < 0 || cur.length < 0 {
            return false;
        };
        if cur.offset > (9223372036854775807 - cur.length) {
            return false;
        };
        if __go_tar_sparse_end(cur) > size {
            return false;
        };
        if __go_tar_sparse_end(pre) > cur.offset {
            return false;
        };
        pre = cur;
        i = i + 1;
    }
    return true;
}

// alignSparseEntries: round data-fragment edges to block
// boundaries (start up, end down, unless end == size).
fn __go_tar_align_sparse_entries(src: Vec<GosTarSparseEntry>, size: i64) -> Vec<GosTarSparseEntry> {
    let dst = Vec::new();
    let i = 0;
    while i < len(src) {
        let s = src[i];
        let pos = s.offset + __go_tar_block_padding(s.offset);
        let end = __go_tar_sparse_end(s);
        if end != size {
            end = end - __go_tar_block_padding(0 - end);
        };
        if pos < end {
            dst.push(GosTarSparseEntry { offset: pos, length: end - pos });
        };
        i = i + 1;
    }
    return dst;
}

// invertSparseEntries: data fragments -> hole fragments
// (the complement within [0, size)). The final fragment
// is always appended, even when empty.
fn __go_tar_invert_sparse_entries(src: Vec<GosTarSparseEntry>, size: i64) -> Vec<GosTarSparseEntry> {
    let dst = Vec::new();
    let pre = GosTarSparseEntry { offset: 0, length: 0 };
    let i = 0;
    while i < len(src) {
        let cur = src[i];
        if cur.length == 0 {
            i = i + 1;
            continue;
        };
        pre.length = cur.offset - pre.offset;
        if pre.length > 0 {
            dst.push(GosTarSparseEntry { offset: pre.offset, length: pre.length });
        };
        pre.offset = __go_tar_sparse_end(cur);
        i = i + 1;
    }
    pre.length = size - pre.offset;
    dst.push(GosTarSparseEntry { offset: pre.offset, length: pre.length });
    return dst;
}

// appendSparseEntry: append unless the map is full.
fn __go_tar_append_sparse_entry(spd: Vec<GosTarSparseEntry>, ent: GosTarSparseEntry) -> (Vec<GosTarSparseEntry>, ptr) {
    if len(spd) >= GO_TAR_MAX_SPARSE_ENTRIES {
        return (Vec::new(), __go_tar_err_sparse_too_long());
    };
    spd.push(ent);
    return (spd, go_errors_nil());
}

// Drop the first hole (sparse reader advances past a
// fragment, keeping the last one). Uses let-bound copies
// -- no &v[i] borrow form (lix).
fn __go_tar_holes_tail(holes: Vec<GosTarSparseEntry>) -> Vec<GosTarSparseEntry> {
    let out = Vec::new();
    let i = 1;
    while i < len(holes) {
        out.push(holes[i]);
        i = i + 1;
    }
    return out;
}

// ---------- allowedFormats helpers ----------
// Field-name ids for __go_tar_field_name.
const GO_TAR_FIELD_NAME: i64 = 0;
const GO_TAR_FIELD_LINKNAME: i64 = 1;
const GO_TAR_FIELD_UNAME: i64 = 2;
const GO_TAR_FIELD_GNAME: i64 = 3;
const GO_TAR_FIELD_MODE: i64 = 4;
const GO_TAR_FIELD_UID: i64 = 5;
const GO_TAR_FIELD_GID: i64 = 6;
const GO_TAR_FIELD_SIZE: i64 = 7;
const GO_TAR_FIELD_DEVMAJOR: i64 = 8;
const GO_TAR_FIELD_DEVMINOR: i64 = 9;
const GO_TAR_FIELD_MODTIME: i64 = 10;
const GO_TAR_FIELD_ACCESSTIME: i64 = 11;
const GO_TAR_FIELD_CHANGETIME: i64 = 12;

fn __go_tar_field_name(id: i64) -> Vec<u8> {
    let v = Vec::new();
    if id == GO_TAR_FIELD_NAME {
        v.push(78u8);
        v.push(97u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_FIELD_LINKNAME {
        v.push(76u8);
        v.push(105u8);
        v.push(110u8);
        v.push(107u8);
        v.push(110u8);
        v.push(97u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_FIELD_UNAME {
        v.push(85u8);
        v.push(110u8);
        v.push(97u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_FIELD_GNAME {
        v.push(71u8);
        v.push(110u8);
        v.push(97u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_FIELD_MODE {
        v.push(77u8);
        v.push(111u8);
        v.push(100u8);
        v.push(101u8);
    } else if id == GO_TAR_FIELD_UID {
        v.push(85u8);
        v.push(105u8);
        v.push(100u8);
    } else if id == GO_TAR_FIELD_GID {
        v.push(71u8);
        v.push(105u8);
        v.push(100u8);
    } else if id == GO_TAR_FIELD_SIZE {
        v.push(83u8);
        v.push(105u8);
        v.push(122u8);
        v.push(101u8);
    } else if id == GO_TAR_FIELD_DEVMAJOR {
        v.push(68u8);
        v.push(101u8);
        v.push(118u8);
        v.push(109u8);
        v.push(97u8);
        v.push(106u8);
        v.push(111u8);
        v.push(114u8);
    } else if id == GO_TAR_FIELD_DEVMINOR {
        v.push(68u8);
        v.push(101u8);
        v.push(118u8);
        v.push(109u8);
        v.push(105u8);
        v.push(110u8);
        v.push(111u8);
        v.push(114u8);
    } else if id == GO_TAR_FIELD_MODTIME {
        v.push(77u8);
        v.push(111u8);
        v.push(100u8);
        v.push(84u8);
        v.push(105u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_FIELD_ACCESSTIME {
        v.push(65u8);
        v.push(99u8);
        v.push(99u8);
        v.push(101u8);
        v.push(115u8);
        v.push(115u8);
        v.push(84u8);
        v.push(105u8);
        v.push(109u8);
        v.push(101u8);
    } else if id == GO_TAR_FIELD_CHANGETIME {
        v.push(67u8);
        v.push(104u8);
        v.push(97u8);
        v.push(110u8);
        v.push(103u8);
        v.push(101u8);
        v.push(84u8);
        v.push(105u8);
        v.push(109u8);
        v.push(101u8);
    };
    return v;
}

// Reason prefix ids: 0 GNU, 1 USTAR, 2 PAX.
fn __go_tar_reason_prefix(id: i64) -> Vec<u8> {
    let v = Vec::new();
    if id == 0 {
        v.push(71u8);
        v.push(78u8);
        v.push(85u8);
    } else if id == 1 {
        v.push(85u8);
        v.push(83u8);
        v.push(84u8);
        v.push(65u8);
        v.push(82u8);
    } else if id == 2 {
        v.push(80u8);
        v.push(65u8);
        v.push(88u8);
    };
    v.push(32u8);
    v.push(99u8);
    v.push(97u8);
    v.push(110u8);
    v.push(110u8);
    v.push(111u8);
    v.push(116u8);
    v.push(32u8);
    v.push(101u8);
    v.push(110u8);
    v.push(99u8);
    v.push(111u8);
    v.push(100u8);
    v.push(101u8);
    v.push(32u8);
    return v;
}

// Build "GNU|USTAR|PAX cannot encode <name>=<value>".
fn __go_tar_why_reason(fmt_id: i64, name: Vec<u8>, value: Vec<u8>) -> Vec<u8> {
    let out = __go_tar_reason_prefix(fmt_id);
    __go_tar_append(&out, name);
    out.push(61u8);
    __go_tar_append(&out, value);
    return out;
}

// Accumulator for allowedFormats (the Go closures'
// captured state, as a struct mutated through &).
struct GoTarAllowState {
    format: i64,
    pax: Vec<GosTarPaxRecord>,
    why_no_ustar: Vec<u8>,
    why_no_pax: Vec<u8>,
    why_no_gnu: Vec<u8>,
    why_only_pax: Vec<u8>,
    why_only_gnu: Vec<u8>,
    prefer_pax: bool,
}

fn __go_tar_allow_new() -> GoTarAllowState {
    return GoTarAllowState {
        format: GO_TAR_FORMAT_USTAR | GO_TAR_FORMAT_PAX | GO_TAR_FORMAT_GNU,
        pax: Vec::new(),
        why_no_ustar: Vec::new(),
        why_no_pax: Vec::new(),
        why_no_gnu: Vec::new(),
        why_only_pax: Vec::new(),
        why_only_gnu: Vec::new(),
        prefer_pax: false,
    };
}

// Format bit helpers (Go's Format.has/mayOnlyBe/
// mustNotBe/mayBe). mustNotBe uses ~bit == -1-bit.
fn __go_tar_fmt_must_not_be(st: &GoTarAllowState, bit: i64) -> void {
    st.format = st.format & (0 - 1 - bit);
    return;
}

fn __go_tar_fmt_may_only_be(st: &GoTarAllowState, bits: i64) -> void {
    st.format = st.format & bits;
    return;
}

// verifyString (common.go allowedFormats closure).
// pax_key is a GO_TAR_KEY_* id, or -1 for paxNone.
fn __go_tar_verify_string(st: &GoTarAllowState, hdr_pax: Vec<GosTarPaxRecord>, s: Vec<u8>, size: i64, field_id: i64, pax_key: i64) -> void {
    let name = __go_tar_field_name(field_id);
    let too_long = len(s) > size;
    let allow_long_gnu = pax_key == GO_TAR_KEY_PATH || pax_key == GO_TAR_KEY_LINKPATH;
    if __go_tar_has_nul(s) || (too_long && allow_long_gnu == false) {
        st.why_no_gnu = __go_tar_why_reason(0, name, go_strconv_quote(s));
        __go_tar_fmt_must_not_be(st, GO_TAR_FORMAT_GNU);
    };
    if __go_tar_is_ascii(s) == false || too_long {
        let can_split_ustar = pax_key == GO_TAR_KEY_PATH;
        let (_pre, _suf, ok) = __go_tar_split_ustar_path(s);
        if can_split_ustar == false || ok == false {
            st.why_no_ustar = __go_tar_why_reason(1, name, go_strconv_quote(s));
            __go_tar_fmt_must_not_be(st, GO_TAR_FORMAT_USTAR);
        };
        if pax_key == 0 - 1 {
            st.why_no_pax = __go_tar_why_reason(2, name, go_strconv_quote(s));
            __go_tar_fmt_must_not_be(st, GO_TAR_FORMAT_PAX);
        } else {
            st.pax = __go_tar_pax_set(st.pax, __go_tar_pax_key(pax_key), go_bytes_clone(s));
        };
    };
    if pax_key != 0 - 1 {
        let (v, ok) = __go_tar_pax_get(hdr_pax, __go_tar_pax_key(pax_key));
        if ok && go_bytes_equal(v, s) {
            st.pax = __go_tar_pax_set(st.pax, __go_tar_pax_key(pax_key), v);
        };
    };
    return;
}

// verifyNumeric (common.go allowedFormats closure).
fn __go_tar_verify_numeric(st: &GoTarAllowState, hdr_pax: Vec<GosTarPaxRecord>, n: i64, size: i64, field_id: i64, pax_key: i64) -> void {
    let name = __go_tar_field_name(field_id);
    if __go_tar_fits_in_base256(size, n) == false {
        st.why_no_gnu = __go_tar_why_reason(0, name, go_strconv_format_int(n, 10));
        __go_tar_fmt_must_not_be(st, GO_TAR_FORMAT_GNU);
    };
    if __go_tar_fits_in_octal(size, n) == false {
        st.why_no_ustar = __go_tar_why_reason(1, name, go_strconv_format_int(n, 10));
        __go_tar_fmt_must_not_be(st, GO_TAR_FORMAT_USTAR);
        if pax_key == 0 - 1 {
            st.why_no_pax = __go_tar_why_reason(2, name, go_strconv_format_int(n, 10));
            __go_tar_fmt_must_not_be(st, GO_TAR_FORMAT_PAX);
        } else {
            st.pax = __go_tar_pax_set(st.pax, __go_tar_pax_key(pax_key), go_strconv_format_int(n, 10));
        };
    };
    if pax_key != 0 - 1 {
        let (v, ok) = __go_tar_pax_get(hdr_pax, __go_tar_pax_key(pax_key));
        if ok && go_bytes_equal(v, go_strconv_format_int(n, 10)) {
            st.pax = __go_tar_pax_set(st.pax, __go_tar_pax_key(pax_key), v);
        };
    };
    return;
}

// verifyTime (common.go allowedFormats closure).
// Time reasons render the instant in PAX form: Go's %v
// renders a wall-clock string which time.sla cannot
// produce (recorded divergence, see manifest).
fn __go_tar_verify_time(st: &GoTarAllowState, hdr_pax: Vec<GosTarPaxRecord>, ts: GoTime, size: i64, field_id: i64, pax_key: i64) -> void {
    if __go_tar_time_is_zero(ts) {
        return;
    };
    let name = __go_tar_field_name(field_id);
    let (sec, nsec) = __go_tar_time_split(ts);
    if __go_tar_fits_in_base256(size, sec) == false {
        st.why_no_gnu = __go_tar_why_reason(0, name, __go_tar_format_pax_time(ts));
        __go_tar_fmt_must_not_be(st, GO_TAR_FORMAT_GNU);
    };
    let is_mtime = pax_key == GO_TAR_KEY_MTIME;
    let fits_octal = __go_tar_fits_in_octal(size, sec);
    if (is_mtime && fits_octal == false) || is_mtime == false {
        st.why_no_ustar = __go_tar_why_reason(1, name, __go_tar_format_pax_time(ts));
        __go_tar_fmt_must_not_be(st, GO_TAR_FORMAT_USTAR);
    };
    let needs_nano = nsec != 0;
    if is_mtime == false || fits_octal == false || needs_nano {
        st.prefer_pax = true;
        if pax_key == 0 - 1 {
            st.why_no_pax = __go_tar_why_reason(2, name, __go_tar_format_pax_time(ts));
            __go_tar_fmt_must_not_be(st, GO_TAR_FORMAT_PAX);
        } else {
            st.pax = __go_tar_pax_set(st.pax, __go_tar_pax_key(pax_key), __go_tar_format_pax_time(ts));
        };
    };
    if pax_key != 0 - 1 {
        let (v, ok) = __go_tar_pax_get(hdr_pax, __go_tar_pax_key(pax_key));
        if ok && go_bytes_equal(v, __go_tar_format_pax_time(ts)) {
            st.pax = __go_tar_pax_set(st.pax, __go_tar_pax_key(pax_key), v);
        };
    };
    return;
}

// Is key a basic PAX key (path/linkpath/size/uid/gid/
// uname/gname/mtime/atime/ctime)?
fn __go_tar_is_basic_key(k: Vec<u8>) -> bool {
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_PATH)) { return true; };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_LINKPATH)) { return true; };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_SIZE)) { return true; };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_UID)) { return true; };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_GID)) { return true; };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_UNAME)) { return true; };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_GNAME)) { return true; };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_MTIME)) { return true; };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_ATIME)) { return true; };
    if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_CTIME)) { return true; };
    return false;
}

// allowedFormats: which formats can encode this header,
// plus the PAX records for fields that cannot be encoded
// directly. Returns (format, paxHdrs, err); format is
// FormatUnknown when the header cannot be encoded.
fn __go_tar_allowed_formats(hdr: &GosTarHeader) -> (i64, Vec<GosTarPaxRecord>, ptr) {
    let st = __go_tar_allow_new();
    let hdr_pax = hdr.pax_records;

    __go_tar_verify_string(&st, hdr_pax, hdr.name, 100, GO_TAR_FIELD_NAME, GO_TAR_KEY_PATH);
    __go_tar_verify_string(&st, hdr_pax, hdr.linkname, 100, GO_TAR_FIELD_LINKNAME, GO_TAR_KEY_LINKPATH);
    __go_tar_verify_string(&st, hdr_pax, hdr.uname, 32, GO_TAR_FIELD_UNAME, GO_TAR_KEY_UNAME);
    __go_tar_verify_string(&st, hdr_pax, hdr.gname, 32, GO_TAR_FIELD_GNAME, GO_TAR_KEY_GNAME);
    __go_tar_verify_numeric(&st, hdr_pax, hdr.mode, 8, GO_TAR_FIELD_MODE, 0 - 1);
    __go_tar_verify_numeric(&st, hdr_pax, hdr.uid, 8, GO_TAR_FIELD_UID, GO_TAR_KEY_UID);
    __go_tar_verify_numeric(&st, hdr_pax, hdr.gid, 8, GO_TAR_FIELD_GID, GO_TAR_KEY_GID);
    __go_tar_verify_numeric(&st, hdr_pax, hdr.size, 12, GO_TAR_FIELD_SIZE, GO_TAR_KEY_SIZE);
    __go_tar_verify_numeric(&st, hdr_pax, hdr.devmajor, 8, GO_TAR_FIELD_DEVMAJOR, 0 - 1);
    __go_tar_verify_numeric(&st, hdr_pax, hdr.devminor, 8, GO_TAR_FIELD_DEVMINOR, 0 - 1);
    __go_tar_verify_time(&st, hdr_pax, hdr.mod_time, 12, GO_TAR_FIELD_MODTIME, GO_TAR_KEY_MTIME);
    __go_tar_verify_time(&st, hdr_pax, hdr.access_time, 12, GO_TAR_FIELD_ACCESSTIME, GO_TAR_KEY_ATIME);
    __go_tar_verify_time(&st, hdr_pax, hdr.change_time, 12, GO_TAR_FIELD_CHANGETIME, GO_TAR_KEY_CTIME);

    // Header-only type checks.
    if hdr.typeflag == GO_TAR_TYPE_REG || hdr.typeflag == GO_TAR_TYPE_CHAR || hdr.typeflag == GO_TAR_TYPE_BLOCK || hdr.typeflag == GO_TAR_TYPE_FIFO || hdr.typeflag == GO_TAR_TYPE_GNU_SPARSE {
        if go_bytes_has_suffix(hdr.name, __go_tar_slash()) {
            let reasons = Vec::new();
            reasons.push(__go_tar_msg_trailing_slash());
            return (GO_TAR_FORMAT_UNKNOWN, Vec::new(), __go_tar_err_cannot_encode(reasons));
        };
    } else if hdr.typeflag == GO_TAR_TYPE_X_HEADER || hdr.typeflag == GO_TAR_TYPE_GNU_LONG_NAME || hdr.typeflag == GO_TAR_TYPE_GNU_LONG_LINK {
        let reasons = Vec::new();
        reasons.push(__go_tar_msg_manual_encode());
        return (GO_TAR_FORMAT_UNKNOWN, Vec::new(), __go_tar_err_cannot_encode(reasons));
    } else if hdr.typeflag == GO_TAR_TYPE_X_GLOBAL_HEADER {
        if __go_tar_is_global_only(hdr) == false {
            let reasons = Vec::new();
            reasons.push(__go_tar_msg_only_pax_records());
            return (GO_TAR_FORMAT_UNKNOWN, Vec::new(), __go_tar_err_cannot_encode(reasons));
        };
        st.why_only_pax = __go_tar_msg_only_pax_global();
        __go_tar_fmt_may_only_be(&st, GO_TAR_FORMAT_PAX);
    };
    if __go_tar_is_header_only_type(hdr.typeflag) == false && hdr.size < 0 {
        let reasons = Vec::new();
        reasons.push(__go_tar_msg_negative_size());
        return (GO_TAR_FORMAT_UNKNOWN, Vec::new(), __go_tar_err_cannot_encode(reasons));
    };

    // Xattrs ride as SCHILY.xattr.* PAX records.
    if len(hdr.xattrs) > 0 {
        let i = 0;
        while i < len(hdr.xattrs) {
            let xk = __go_tar_pax_key(GO_TAR_KEY_SCHILY_XATTR);
            __go_tar_append(&xk, hdr.xattrs[i].key);
            st.pax = __go_tar_pax_set(st.pax, xk, go_bytes_clone(hdr.xattrs[i].value));
            i = i + 1;
        }
        st.why_only_pax = __go_tar_msg_only_pax_xattrs();
        __go_tar_fmt_may_only_be(&st, GO_TAR_FORMAT_PAX);
    };

    // Caller-supplied PAX records: keep existing ones,
    // copy all for global headers, copy non-basic,
    // non-GNU.sparse ones otherwise.
    if len(hdr.pax_records) > 0 {
        let i = 0;
        while i < len(hdr.pax_records) {
            let k = hdr.pax_records[i].key;
            let v = hdr.pax_records[i].value;
            let (_old, exists) = __go_tar_pax_get(st.pax, k);
            if exists == false {
                if hdr.typeflag == GO_TAR_TYPE_X_GLOBAL_HEADER {
                    st.pax = __go_tar_pax_set(st.pax, go_bytes_clone(k), go_bytes_clone(v));
                } else if __go_tar_is_basic_key(k) == false && go_bytes_has_prefix(k, __go_tar_pax_key(GO_TAR_KEY_GNU_PREFIX)) == false {
                    st.pax = __go_tar_pax_set(st.pax, go_bytes_clone(k), go_bytes_clone(v));
                };
            };
            i = i + 1;
        }
        st.why_only_pax = __go_tar_msg_only_pax_recs();
        __go_tar_fmt_may_only_be(&st, GO_TAR_FORMAT_PAX);
    };

    // Every accumulated PAX record must itself be valid.
    let j = 0;
    while j < len(st.pax) {
        if __go_tar_valid_pax_record(st.pax[j].key, st.pax[j].value) == false {
            let bad = Vec::new();
            __go_tar_append(&bad, st.pax[j].key);
            bad.push(32u8);
            bad.push(61u8);
            bad.push(32u8);
            __go_tar_append(&bad, st.pax[j].value);
            let full = __go_tar_msg_invalid_pax_record();
            __go_tar_append(&full, go_strconv_quote(bad));
            let reasons2 = Vec::new();
            reasons2.push(full);
            return (GO_TAR_FORMAT_UNKNOWN, Vec::new(), __go_tar_err_cannot_encode(reasons2));
        };
        j = j + 1;
    }

    // Desired format: PAX implies USTAR is allowed too,
    // unless PAX was specifically preferred.
    if hdr.format != GO_TAR_FORMAT_UNKNOWN {
        let want = hdr.format;
        if (want & GO_TAR_FORMAT_PAX) != 0 && st.prefer_pax == false {
            want = want | GO_TAR_FORMAT_USTAR;
        };
        st.format = st.format & want;
    };
    if st.format == GO_TAR_FORMAT_UNKNOWN {
        let reasons = Vec::new();
        if hdr.format == GO_TAR_FORMAT_USTAR {
            reasons.push(__go_tar_msg_format_ustar());
            reasons.push(go_bytes_clone(st.why_no_ustar));
            reasons.push(go_bytes_clone(st.why_only_pax));
            reasons.push(go_bytes_clone(st.why_only_gnu));
        } else if hdr.format == GO_TAR_FORMAT_PAX {
            reasons.push(__go_tar_msg_format_pax());
            reasons.push(go_bytes_clone(st.why_no_pax));
            reasons.push(go_bytes_clone(st.why_only_gnu));
        } else if hdr.format == GO_TAR_FORMAT_GNU {
            reasons.push(__go_tar_msg_format_gnu());
            reasons.push(go_bytes_clone(st.why_no_gnu));
            reasons.push(go_bytes_clone(st.why_only_pax));
        } else {
            reasons.push(go_bytes_clone(st.why_no_ustar));
            reasons.push(go_bytes_clone(st.why_no_pax));
            reasons.push(go_bytes_clone(st.why_no_gnu));
            reasons.push(go_bytes_clone(st.why_only_pax));
            reasons.push(go_bytes_clone(st.why_only_gnu));
        };
        return (GO_TAR_FORMAT_UNKNOWN, st.pax, __go_tar_err_cannot_encode(reasons));
    };
    return (st.format, st.pax, go_errors_nil());
}

// A global header may only carry Name/Typeflag/Xattrs/
// PAXRecords/Format; every other field must be zero.
fn __go_tar_is_global_only(hdr: &GosTarHeader) -> bool {
    if len(hdr.linkname) > 0 { return false; };
    if hdr.size != 0 { return false; };
    if hdr.mode != 0 { return false; };
    if hdr.uid != 0 { return false; };
    if hdr.gid != 0 { return false; };
    if len(hdr.uname) > 0 { return false; };
    if len(hdr.gname) > 0 { return false; };
    if __go_tar_time_is_zero(hdr.mod_time) == false { return false; };
    if __go_tar_time_is_zero(hdr.access_time) == false { return false; };
    if __go_tar_time_is_zero(hdr.change_time) == false { return false; };
    if hdr.devmajor != 0 { return false; };
    if hdr.devminor != 0 { return false; };
    return true;
}

