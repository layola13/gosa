// gostd archive/tar: the SLA-side model of Go's archive/tar package.
// Organisation follows the psa_std precedent: one .sla file per Go
// package, public entry points named go_<pkg>_<name>, private
// helpers __go_<pkg>_<name>, panic codes listed up front.
//
// Oracle: Go 1.27.2 archive/tar (common.go, format.go, reader.go,
// writer.go, strconv.go, stat_unix.go, stat_actime1.go,
// stat_actime2.go). The oracle sources are mirrored at
// ~/workspace/task170-work/wave2-oracle/archive_tar/ (sha-verified
// against the box's Go tree on 2026-11-28).
//
// Splice position: 29 (first wave-2 package, first 待写 in census
// order; next are archive/zip, compress/*). Depends on: errors,
// io (GosIoReader/GosIoWriter handles, GoIoResult, EOF 900010),
// strconv (ParseUint/ParseInt/FormatInt/Quote), bytes, strings,
// path (Clean for IsLocal), time (GoTime), sort is NOT used --
// PAX record keys are sorted by a local insertion sort so tar
// stays independent of the sort package.
//
// Writer conventions followed (see R1400-EXEC-170.md,
// CONTEXT-B-FIX-170.md §5/§6, LIVLV-FIX-170.md §6):
//   * SLA text only, sla/sa as black box. No fake declaration
//     stubs, no top-level @extern (design_sai_only, R1520).
//   * `if` blocks used as statements end with `};`.
//   * No `~` unary operator (use 0u64 - x / 0 - x - 1).
//   * No bare `(*p).field` dereference (use __go_err_node).
//   * Vec::push MOVES its argument; by-value Vec args are
//     shared handles (pushes through them are visible).
//   * `&v[i]` borrow form is a known trap (lix) -- avoided;
//     sparse-entry access uses let-bound copies.
//   * Sentinel comparison always via errors.Is (S9).
//   * Context value keys are frontend-assigned i64 ids (n/a
//     here, no context use).
//
// Seams (cross-file calls, all landed in the corpus):
//   errors: go_errors_new_with_id / go_errors_new / go_errors_nil
//           / go_errors_is
//   io:     go_io_reader_read / go_io_writer_write / go_io_eof /
//           go_io_err_unexpected_eof
//   strconv: go_strconv_parse_uint / go_strconv_parse_int /
//           go_strconv_format_int / go_strconv_itoa /
//           go_strconv_quote
//   bytes:  go_bytes_clone / go_bytes_trim /
//           go_bytes_index_byte / go_bytes_compare /
//           go_bytes_has_prefix / go_bytes_has_suffix /
//           go_bytes_split / go_bytes_equal / go_bytes_last_index_byte
//   path:   go_path_clean / go_path_split / go_path_join
//   time:   go_time_unix (GoTime struct fields read directly;
//           round-to-second is implemented locally in tar
//           because time.sla has no Round)
//
// Public API (Go name -> SLA name):
//   tar.NewReader(r)            -> go_archive_tar_new_reader
//   tar.NewReader with strict   -> go_archive_tar_new_reader_strict
//     (Go gates strict path checking behind the GODEBUG
//      tarinsecurepath=0 setting; gostd exposes it as an
//      explicit constructor instead of a debug flag)
//   (*Reader).Next()            -> go_archive_tar_reader_next
//   (*Reader).Read(b)           -> go_archive_tar_reader_read
//   tar.NewWriter(w)            -> go_archive_tar_new_writer
//   (*Writer).Flush()           -> go_archive_tar_writer_flush
//   (*Writer).WriteHeader(hdr)  -> go_archive_tar_writer_write_header
//   (*Writer).Write(b)          -> go_archive_tar_writer_write
//   (*Writer).Close()           -> go_archive_tar_writer_close
//
// Deliberately OMITTED (frontend refusals, codes RESERVED not
// attached -- the slices 77419 precedent, not the maps stub
// precedent: no callable SLA shape exists without io/fs):
//   77444  FileInfoHeader(fi)  -- needs io/fs FileInfo (unwritten)
//   77445  (Header).FileInfo() -- needs io/fs FileInfo (unwritten)
//   77448  (*Writer).AddFS(fsys) -- needs fs.FS (unwritten)
//   77449  RESERVED (spare, next tar code)
//   77450  RESERVED (spare, next tar code)
//   77433  NOT claimed (cmp.sla reserves it)
//   77419  NOT claimed (slices iterators reserve it)
//
// Panic codes (gostd block 77400-77499): none live in this
// file. The three codes above are reserved only; the file
// panics only through go_errors helpers (77401 nil-error
// dereference, owned by errors.sla).
//
// Target ids claimed (frontend-assigned i64, 900047-900056;
// 900039-900046 are comment-only "not claimed" mentions in
// the corpus and were NOT used):
//   900047  ErrHeader          "archive/tar: invalid tar header"
//   900048  ErrWriteTooLong    "archive/tar: write too long"
//   900049  ErrFieldTooLong    "archive/tar: header field too long"
//   900050  ErrWriteAfterClose "archive/tar: write after close"
//   900051  ErrInsecurePath   "archive/tar: insecure file path"
//   900052  errMissData        "archive/tar: sparse file references
//                               non-existent data"
//   900053  errUnrefData       "archive/tar: sparse file contains
//                               unreferenced data"
//   900054  errWriteHole       "archive/tar: write non-NUL byte in
//                               sparse hole"
//   900055  errSparseTooLong   "archive/tar: sparse map too long"
//   900056  headerError        "archive/tar: cannot encode header"
//                               (+ "; and "-joined reasons)
//   900010  io.EOF (reused, owned by io.sla)
//   900011  io.ErrUnexpectedEOF (reused, owned by io.sla)
//
// Known divergences from Go 1.27.2 (recorded, not hidden):
//   D1  GoTime zero: time.Time has a monotonic wall/ext split
//       and a "zero" sentinel (year 1). GoTime is
//       {unix_ns, mono, has_mono}; the tar file stores
//       unix_ns == 0 as the zero time. A real pre-1970 or
//       post-2262 time whose unix_ns happens to be 0 is
//       indistinguishable -- same treatment as the rest of
//       the corpus, which has no zero-time helper.
//   D2  Writer has NO sparse support in Go 1.27.2 (the
//       sparse writer in writer.go is commented out), so
//       WriteHeader never emits a GNU sparse map; a
//       Header with sparse data is written as a plain
//       regular file (Go does the same).
//   D3  Go 1.27.2 Header has NO sparse fields (commented
//       out in the oracle); sparse is reader-side only.
//       GosTarHeader therefore has no sparse field either.
//   D4  Typeflag is stored as i64 in GosTarHeader (corpus
//       convention: small enums are i64); the on-disk byte
//       is hdr.typeflag as u8. Constants are i64.
//   D5  Format detection: the oracle reads the checksum
//       field with parseNumeric; this file does the same
//       (octal-first, base-256 if the high bit is set).
//   D6  readHeader's USTAR trailing-slash quirk
//       (formatString trims a trailing '/' when the field
//       overflows) is ported faithfully.
//   D7  The GNU longname/longlink + PAX + sparse readers
//       share the Reader's underlying handle; the
//       readSpecialFile path reads through the Reader's
//       current-file Read (Go reads through tr, i.e. the
//       current file reader), exactly as the oracle does.
//   D8  Writer.WriteHeader for a GNU-format header with
//       long name/linkname emits GNU 'L'/'K' extension
//       records; for PAX it emits 'x' records; USTAR
//       splits long names at '/' (format: ustar).
//
// Corpus example: go_archive_tar_demo_header_roundtrip() at
// the end of this file builds a USTAR block from a header
// and parses it back without any io handle, exercising the
// format core. A full writer->reader roundtrip needs an
// in-memory sink with a read-back accessor, which io.sla
// does not expose yet (GosOffsetWriter has no bytes
// accessor); that demo belongs in the splice harness once
// the accessor exists.

@import "sa_std/vec.sa"

// ---------- Constants ----------

const GO_TAR_BLOCK_SIZE: i64 = 512;
const GO_TAR_NAME_SIZE: i64 = 100;
const GO_TAR_PREFIX_SIZE: i64 = 155;
const GO_TAR_MAX_SPECIAL_FILE_SIZE: i64 = 1048576;
const GO_TAR_MAX_SPARSE_ENTRIES: i64 = 1048576;

// Typeflags (Go byte values, stored as i64).
const GO_TAR_TYPE_REG: i64 = 48;
const GO_TAR_TYPE_REG_A: i64 = 0;
const GO_TAR_TYPE_LINK: i64 = 49;
const GO_TAR_TYPE_SYMLINK: i64 = 50;
const GO_TAR_TYPE_CHAR: i64 = 51;
const GO_TAR_TYPE_BLOCK: i64 = 52;
const GO_TAR_TYPE_DIR: i64 = 53;
const GO_TAR_TYPE_FIFO: i64 = 54;
const GO_TAR_TYPE_CONT: i64 = 55;
const GO_TAR_TYPE_X_HEADER: i64 = 120;
const GO_TAR_TYPE_X_GLOBAL_HEADER: i64 = 103;
const GO_TAR_TYPE_GNU_SPARSE: i64 = 83;
const GO_TAR_TYPE_GNU_LONG_NAME: i64 = 76;
const GO_TAR_TYPE_GNU_LONG_LINK: i64 = 75;

// Formats (bitmask, Go values).
const GO_TAR_FORMAT_UNKNOWN: i64 = 0;
const GO_TAR_FORMAT_V7: i64 = 1;
const GO_TAR_FORMAT_USTAR: i64 = 2;
const GO_TAR_FORMAT_PAX: i64 = 4;
const GO_TAR_FORMAT_GNU: i64 = 8;
const GO_TAR_FORMAT_STAR: i64 = 16;

// Target ids (see header).
const GO_TAR_ID_ERR_HEADER: i64 = 900047;
const GO_TAR_ID_ERR_WRITE_TOO_LONG: i64 = 900048;
const GO_TAR_ID_ERR_FIELD_TOO_LONG: i64 = 900049;
const GO_TAR_ID_ERR_WRITE_AFTER_CLOSE: i64 = 900050;
const GO_TAR_ID_ERR_INSECURE_PATH: i64 = 900051;
const GO_TAR_ID_ERR_MISS_DATA: i64 = 900052;
const GO_TAR_ID_ERR_UNREF_DATA: i64 = 900053;
const GO_TAR_ID_ERR_WRITE_HOLE: i64 = 900054;
const GO_TAR_ID_ERR_SPARSE_TOO_LONG: i64 = 900055;
const GO_TAR_ID_ERR_CANNOT_ENCODE: i64 = 900056;
const GO_TAR_ID_EOF: i64 = 900010;
const GO_TAR_ID_UNEXPECTED_EOF: i64 = 900011;

// ---------- Structs ----------

// A single PAX extended-header record (key=value).
struct GosTarPaxRecord {
    key: Vec<u8>,
    value: Vec<u8>,
}

// One sparse-file map entry: [offset, offset+length).
struct GosTarSparseEntry {
    offset: i64,
    length: i64,
}

// tar.Header. Typeflag is i64 (see D4). Times are GoTime;
// the zero time is unix_ns == 0 (see D1).
struct GosTarHeader {
    typeflag: i64,
    name: Vec<u8>,
    linkname: Vec<u8>,
    size: i64,
    mode: i64,
    uid: i64,
    gid: i64,
    uname: Vec<u8>,
    gname: Vec<u8>,
    mod_time: GoTime,
    access_time: GoTime,
    change_time: GoTime,
    devmajor: i64,
    devminor: i64,
    xattrs: Vec<GosTarPaxRecord>,
    pax_records: Vec<GosTarPaxRecord>,
    format: i64,
}

// tar.Reader. nb is the physical bytes remaining in the
// current file; the logical remaining count is derived
// (__go_tar_logical_remaining): for a sparse file the
// last hole's end minus the position, otherwise nb.
// err is sticky: once set, Next/Read keep returning it.
struct GosTarReader {
    r: GosIoReader,
    pad: i64,
    nb: i64,
    err: ptr,
    sparse_on: bool,
    sparse_holes: Vec<GosTarSparseEntry>,
    sparse_pos: i64,
    strict_path: bool,
}

// tar.Writer. nb is the logical bytes remaining to write
// for the current file; pad is the zero padding still owed
// after it. err is sticky; closed marks Close() done.
struct GosTarWriter {
    w: GosIoWriter,
    pad: i64,
    nb: i64,
    err: ptr,
    closed: bool,
    hdr: GosTarHeader,
}

// Next()/readHeader result: a header plus an error.
struct GoTarNextResult {
    hdr: GosTarHeader,
    err: ptr,
}

// ---------- Error constructors ----------
// Every tar error is a GosError built through
// go_errors_new_with_id (frontend-assigned identity, S9:
// sentinel comparison via errors.Is). Messages are built
// by pushing byte literals -- SLA has no Str->Vec<u8>
// conversion (see the corpus-wide convention in hex.sla).

fn __go_tar_msg_prefix(out: &Vec<u8>) -> void {
    out.push(97u8);
    out.push(114u8);
    out.push(99u8);
    out.push(104u8);
    out.push(105u8);
    out.push(118u8);
    out.push(101u8);
    out.push(47u8);
    out.push(116u8);
    out.push(97u8);
    out.push(114u8);
    out.push(58u8);
    out.push(32u8);
    return;
}

fn __go_tar_err_header() -> ptr {
    let msg = Vec::new();
    __go_tar_msg_prefix(&msg);
    msg.push(105u8);
    msg.push(110u8);
    msg.push(118u8);
    msg.push(97u8);
    msg.push(108u8);
    msg.push(105u8);
    msg.push(100u8);
    msg.push(32u8);
    msg.push(116u8);
    msg.push(97u8);
    msg.push(114u8);
    msg.push(32u8);
    msg.push(104u8);
    msg.push(101u8);
    msg.push(97u8);
    msg.push(100u8);
    msg.push(101u8);
    msg.push(114u8);
    return go_errors_new_with_id(msg, GO_TAR_ID_ERR_HEADER);
}

