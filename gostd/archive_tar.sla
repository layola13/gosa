// ---------- Reader internals ----------

// tryReadFull on a raw GosIoReader: loop until n bytes
// are appended to dst or an error arrives; EOF on an
// exactly-full read is cleared (Go semantics).
fn __go_tar_try_read_raw(r: &GosIoReader, dst: &Vec<u8>, n: i64) -> (i64, ptr) {
    let start = len(dst);
    let err = go_errors_nil();
    while len(dst) - start < n && __go_tar_is_nil(err) {
        let res = go_io_reader_read(r, dst, n - (len(dst) - start));
        err = res.err;
    }
    let read = len(dst) - start;
    if read == n && __go_tar_is_eof(err) {
        err = go_errors_nil();
    };
    return (read, err);
}

// io.ReadFull semantics on a raw reader: EOF when 0
// bytes were read, UnexpectedEOF on a partial read.
fn __go_tar_read_full_raw(r: &GosIoReader, dst: &Vec<u8>, n: i64) -> (i64, ptr) {
    let (m, e) = __go_tar_try_read_raw(r, dst, n);
    if __go_tar_is_eof(e) {
        if m == 0 {
            return (0, go_io_eof());
        };
        return (m, go_io_err_unexpected_eof());
    };
    return (m, e);
}

// mustReadFull on a raw reader: EOF always becomes
// UnexpectedEOF.
fn __go_tar_must_read_raw(r: &GosIoReader, dst: &Vec<u8>, n: i64) -> (i64, ptr) {
    let (m, e) = __go_tar_try_read_raw(r, dst, n);
    if __go_tar_is_eof(e) {
        return (m, go_io_err_unexpected_eof());
    };
    return (m, e);
}

// One clamped read from the current file (regFileReader
// semantics): at most tr.nb bytes, tr.nb updated, EOF
// when the file ends, UnexpectedEOF on truncation.
fn __go_tar_reg_read_once(tr: &GosTarReader, dst: &Vec<u8>, max: i64) -> GoIoResult {
    let m = __go_tar_min(max, tr.nb);
    if m <= 0 {
        if tr.nb == 0 {
            return GoIoResult { n: 0, err: go_io_eof() };
        };
        return GoIoResult { n: 0, err: go_errors_nil() };
    };
    let res = go_io_reader_read(&tr.r, dst, m);
    tr.nb = tr.nb - res.n;
    if __go_tar_is_eof(res.err) && tr.nb > 0 {
        return GoIoResult { n: res.n, err: go_io_err_unexpected_eof() };
    };
    if __go_tar_is_nil(res.err) && tr.nb == 0 {
        return GoIoResult { n: res.n, err: go_io_eof() };
    };
    return res;
}

// tryReadFull through the current-file reader.
fn __go_tar_try_read_reg(tr: &GosTarReader, dst: &Vec<u8>, n: i64) -> (i64, ptr) {
    let start = len(dst);
    let err = go_errors_nil();
    while len(dst) - start < n && __go_tar_is_nil(err) {
        let res = __go_tar_reg_read_once(tr, dst, n - (len(dst) - start));
        err = res.err;
    }
    let read = len(dst) - start;
    if read == n && __go_tar_is_eof(err) {
        err = go_errors_nil();
    };
    return (read, err);
}

// mustReadFull through the current-file reader.
fn __go_tar_must_read_reg(tr: &GosTarReader, dst: &Vec<u8>, n: i64) -> (i64, ptr) {
    let (m, e) = __go_tar_try_read_reg(tr, dst, n);
    if __go_tar_is_eof(e) {
        return (m, go_io_err_unexpected_eof());
    };
    return (m, e);
}

// discard: read and drop n bytes (no Seek in the corpus
// io handles). EOF on a short discard becomes
// UnexpectedEOF; EOF on a complete discard is nil.
fn __go_tar_discard(r: &GosIoReader, n: i64) -> ptr {
    let skipped = 0;
    let err = go_errors_nil();
    while skipped < n && __go_tar_is_nil(err) {
        let scratch = Vec::new();
        let want = __go_tar_min(n - skipped, GO_TAR_BLOCK_SIZE);
        let res = go_io_reader_read(r, &scratch, want);
        skipped = skipped + res.n;
        err = res.err;
    }
    if __go_tar_is_nil(err) {
        return go_errors_nil();
    };
    if __go_tar_is_eof(err) {
        if skipped < n {
            return go_io_err_unexpected_eof();
        };
        return go_errors_nil();
    };
    return err;
}

// readSpecialFile: read the whole current file (through
// the Reader's Read), capped at maxSpecialFileSize.
fn __go_tar_read_special_file(tr: &GosTarReader) -> (Vec<u8>, ptr) {
    let buf = Vec::new();
    let err = go_errors_nil();
    while __go_tar_is_nil(err) {
        let res = go_archive_tar_reader_read(tr, &buf, GO_TAR_BLOCK_SIZE);
        err = res.err;
        if len(buf) > GO_TAR_MAX_SPECIAL_FILE_SIZE {
            return (Vec::new(), __go_tar_err_field_too_long());
        };
    }
    if __go_tar_is_eof(err) {
        return (buf, go_errors_nil());
    };
    return (buf, err);
}

// parsePAX: parse the extended-header file into records.
// GNU sparse 0.0 offset/numbytes pairs are collected and
// re-exposed as a single GNU.sparse.map record.
fn __go_tar_parse_pax(tr: &GosTarReader) -> (Vec<GosTarPaxRecord>, ptr) {
    let (buf, err) = __go_tar_read_special_file(tr);
    if __go_tar_is_nil(err) == false {
        return (Vec::new(), err);
    };
    let sbuf = buf;
    let sparse_map = Vec::new();
    let pax = Vec::new();
    while len(sbuf) > 0 {
        let (rec, rem, perr) = __go_tar_parse_pax_record(sbuf);
        if __go_tar_is_nil(perr) == false {
            return (Vec::new(), __go_tar_err_header());
        };
        sbuf = rem;
        if go_bytes_equal(rec.key, __go_tar_pax_key(GO_TAR_KEY_GNU_OFFSET)) || go_bytes_equal(rec.key, __go_tar_pax_key(GO_TAR_KEY_GNU_NUMBYTES)) {
            let expect_offset = len(sparse_map) % 2 == 0;
            if (expect_offset && go_bytes_equal(rec.key, __go_tar_pax_key(GO_TAR_KEY_GNU_OFFSET)) == false) || (expect_offset == false && go_bytes_equal(rec.key, __go_tar_pax_key(GO_TAR_KEY_GNU_NUMBYTES)) == false) || go_bytes_index_byte(rec.value, 44u8) >= 0 {
                return (Vec::new(), __go_tar_err_header());
            };
            sparse_map.push(go_bytes_clone(rec.value));
        } else {
            pax = __go_tar_pax_set(pax, rec.key, rec.value);
        };
    }
    if len(sparse_map) > 0 {
        let joined = Vec::new();
        let i = 0;
        while i < len(sparse_map) {
            if i > 0 {
                joined.push(44u8);
            };
            __go_tar_append(&joined, sparse_map[i]);
            i = i + 1;
        }
        pax = __go_tar_pax_set(pax, __go_tar_pax_key(GO_TAR_KEY_GNU_MAP), joined);
    };
    return (pax, go_errors_nil());
}

// readGNUSparseMap1x0: the 1.0 sparse map lives in the
// current file as newline-terminated decimal fields:
// count, then (offset, length) pairs. Reads happen in
// whole 512-byte blocks (feedTokens).
fn __go_tar_read_gnu_sparse_map_1x0(tr: &GosTarReader) -> (Vec<GosTarSparseEntry>, ptr) {
    let buf = Vec::new();
    let cnt_newline = 0;
    let total_size = 0;
    let err = go_errors_nil();
    // feedTokens(1): read blocks until 1 newline is buffered.
    while cnt_newline < 1 && __go_tar_is_nil(err) {
        total_size = total_size + GO_TAR_BLOCK_SIZE;
        if total_size > GO_TAR_MAX_SPECIAL_FILE_SIZE {
            return (Vec::new(), __go_tar_err_sparse_too_long());
        };
        let blk = Vec::new();
        let (_m, e) = __go_tar_must_read_reg(tr, &blk, GO_TAR_BLOCK_SIZE);
        err = e;
        if __go_tar_is_nil(err) {
            __go_tar_append(&buf, blk);
            let i = 0;
            while i < len(blk) {
                if blk[i] == 10u8 {
                    cnt_newline = cnt_newline + 1;
                };
                i = i + 1;
            }
        };
    }
    if __go_tar_is_nil(err) == false {
        return (Vec::new(), err);
    };
    let (tok, rest) = __go_tar_next_token(buf);
    buf = rest;
    cnt_newline = cnt_newline - 1;
    let rn = go_strconv_parse_int(tok, 10, 64);
    if __go_tar_is_nil(rn.err) == false {
        return (Vec::new(), __go_tar_err_header());
    };
    let num_entries = rn.v;
    if num_entries < 0 || num_entries > 4611686018427387903 {
        return (Vec::new(), __go_tar_err_header());
    };
    // feedTokens(2*numEntries).
    while cnt_newline < 2 * num_entries && __go_tar_is_nil(err) {
        total_size = total_size + GO_TAR_BLOCK_SIZE;
        if total_size > GO_TAR_MAX_SPECIAL_FILE_SIZE {
            return (Vec::new(), __go_tar_err_sparse_too_long());
        };
        let blk = Vec::new();
        let (_m2, e2) = __go_tar_must_read_reg(tr, &blk, GO_TAR_BLOCK_SIZE);
        err = e2;
        if __go_tar_is_nil(err) {
            __go_tar_append(&buf, blk);
            let i = 0;
            while i < len(blk) {
                if blk[i] == 10u8 {
                    cnt_newline = cnt_newline + 1;
                };
                i = i + 1;
            }
        };
    }
    if __go_tar_is_nil(err) == false {
        return (Vec::new(), err);
    };
    let spd = Vec::new();
    let i = 0;
    while i < num_entries {
        let (tok_off, rest1) = __go_tar_next_token(buf);
        buf = rest1;
        cnt_newline = cnt_newline - 1;
        let (tok_len, rest2) = __go_tar_next_token(buf);
        buf = rest2;
        cnt_newline = cnt_newline - 1;
        let r1 = go_strconv_parse_int(tok_off, 10, 64);
        let r2 = go_strconv_parse_int(tok_len, 10, 64);
        if __go_tar_is_nil(r1.err) == false || __go_tar_is_nil(r2.err) == false {
            return (Vec::new(), __go_tar_err_header());
        };
        let (spd2, aerr) = __go_tar_append_sparse_entry(spd, GosTarSparseEntry { offset: r1.v, length: r2.v });
        if __go_tar_is_nil(aerr) == false {
            return (Vec::new(), aerr);
        };
        spd = spd2;
        i = i + 1;
    }
    return (spd, go_errors_nil());
}

// nextToken: split buf at the first newline, returning
// (token without the newline, remainder).
fn __go_tar_next_token(buf: Vec<u8>) -> (Vec<u8>, Vec<u8>) {
    let idx = go_bytes_index_byte(buf, 10u8);
    if idx < 0 {
        return (go_bytes_clone(buf), Vec::new());
    };
    return (__go_tar_slice(buf, 0, idx), __go_tar_slice(buf, idx + 1, len(buf)));
}

// readGNUSparseMap0x1: the 0.1 map lives in the PAX
// records as GNU.sparse.numblocks + GNU.sparse.map
// (comma-separated offset,length pairs).
fn __go_tar_read_gnu_sparse_map_0x1(pax: Vec<GosTarPaxRecord>) -> (Vec<GosTarSparseEntry>, ptr) {
    let (num_str, _found) = __go_tar_pax_get(pax, __go_tar_pax_key(GO_TAR_KEY_GNU_NUMBLOCKS));
    let rn = go_strconv_parse_int(num_str, 10, 64);
    if __go_tar_is_nil(rn.err) == false {
        return (Vec::new(), __go_tar_err_header());
    };
    let num_entries = rn.v;
    if num_entries < 0 || num_entries > 4611686018427387903 {
        return (Vec::new(), __go_tar_err_header());
    };
    let (map_str, _f2) = __go_tar_pax_get(pax, __go_tar_pax_key(GO_TAR_KEY_GNU_MAP));
    let comma = Vec::new();
    comma.push(44u8);
    let parts = go_bytes_split(map_str, comma);
    if len(parts) == 1 && len(parts[0]) == 0 {
        parts = Vec::new();
    };
    if len(parts) != 2 * num_entries {
        return (Vec::new(), __go_tar_err_header());
    };
    let spd = Vec::new();
    let i = 0;
    while i + 1 < len(parts) {
        let r1 = go_strconv_parse_int(parts[i], 10, 64);
        let r2 = go_strconv_parse_int(parts[i + 1], 10, 64);
        if __go_tar_is_nil(r1.err) == false || __go_tar_is_nil(r2.err) == false {
            return (Vec::new(), __go_tar_err_header());
        };
        let (spd2, aerr) = __go_tar_append_sparse_entry(spd, GosTarSparseEntry { offset: r1.v, length: r2.v });
        if __go_tar_is_nil(aerr) == false {
            return (Vec::new(), aerr);
        };
        spd = spd2;
        i = i + 2;
    }
    return (spd, go_errors_nil());
}

// Logical bytes remaining in the current file: for a
// sparse file the last hole's end minus the position,
// otherwise the physical remaining count.
fn __go_tar_logical_remaining(tr: &GosTarReader) -> i64 {
    if tr.sparse_on {
        let last = tr.sparse_holes[len(tr.sparse_holes) - 1];
        return __go_tar_sparse_end(last) - tr.sparse_pos;
    };
    return tr.nb;
}

fn __go_tar_zero() -> Vec<u8> {
    let v = Vec::new();
    v.push(48u8);
    return v;
}

fn __go_tar_one() -> Vec<u8> {
    let v = Vec::new();
    v.push(49u8);
    return v;
}

// readOldGNUSparseMap: the old GNU sparse map lives in
// the header block itself (up to 4 entries) plus extension
// headers read from the raw reader. Returns
// (entries, found, err); found is always true here
// (the typeflag selects this path).
fn __go_tar_read_old_gnu_sparse_map(tr: &GosTarReader, hdr: &GosTarHeader, blk: Vec<u8>) -> (Vec<GosTarSparseEntry>, bool, ptr) {
    if __go_tar_get_format(blk) != GO_TAR_FORMAT_GNU {
        return (Vec::new(), false, __go_tar_err_header());
    };
    hdr.format = hdr.format & GO_TAR_FORMAT_GNU;
    let (real_size, perr) = __go_tar_parse_numeric(__go_tar_slice(blk, 483, 495));
    if __go_tar_is_nil(perr) == false {
        return (Vec::new(), false, perr);
    };
    hdr.size = real_size;
    let cur = __go_tar_slice(blk, 386, 483);
    let spd = Vec::new();
    let total_size = len(cur);
    while total_size < GO_TAR_MAX_SPECIAL_FILE_SIZE {
        let max_entries = len(cur) / 24;
        let perr2 = go_errors_nil();
        let i = 0;
        while i < max_entries {
            let off_field = __go_tar_slice(cur, i * 24, i * 24 + 12);
            if off_field[0] == 0u8 {
                break;
            };
            let (off, e1) = __go_tar_parse_numeric(off_field);
            let (ln, e2) = __go_tar_parse_numeric(__go_tar_slice(cur, i * 24 + 12, i * 24 + 24));
            if __go_tar_is_nil(e1) == false {
                perr2 = e1;
                break;
            };
            if __go_tar_is_nil(e2) == false {
                perr2 = e2;
                break;
            };
            let (spd2, aerr) = __go_tar_append_sparse_entry(spd, GosTarSparseEntry { offset: off, length: ln });
            if __go_tar_is_nil(aerr) == false {
                perr2 = aerr;
                break;
            };
            spd = spd2;
            i = i + 1;
        }
        if __go_tar_is_nil(perr2) == false {
            return (Vec::new(), false, perr2);
        };
        if cur[max_entries * 24] > 0u8 {
            let ext = Vec::new();
            let (_m, e) = __go_tar_must_read_raw(&tr.r, &ext, GO_TAR_BLOCK_SIZE);
            if __go_tar_is_nil(e) == false {
                return (Vec::new(), false, e);
            };
            cur = ext;
            total_size = total_size + len(cur);
            continue;
        };
        return (spd, true, go_errors_nil());
    }
    return (Vec::new(), false, __go_tar_err_sparse_too_long());
}

// readGNUSparsePAXHeaders: identify the GNU sparse PAX
// version and read the map. Returns (entries, found,
// err); found is false when this is not a sparse file.
fn __go_tar_read_gnu_sparse_pax_headers(tr: &GosTarReader, hdr: &GosTarHeader) -> (Vec<GosTarSparseEntry>, bool, ptr) {
    let (major, _f1) = __go_tar_pax_get(hdr.pax_records, __go_tar_pax_key(GO_TAR_KEY_GNU_MAJOR));
    let (minor, _f2) = __go_tar_pax_get(hdr.pax_records, __go_tar_pax_key(GO_TAR_KEY_GNU_MINOR));
    let is_1x0 = false;
    if go_bytes_equal(major, __go_tar_zero()) && (go_bytes_equal(minor, __go_tar_zero()) || go_bytes_equal(minor, __go_tar_one())) {
        is_1x0 = false;
    } else if go_bytes_equal(major, __go_tar_one()) && go_bytes_equal(minor, __go_tar_zero()) {
        is_1x0 = true;
    } else if len(major) > 0 || len(minor) > 0 {
        return (Vec::new(), false, go_errors_nil());
    } else {
        let (mapv, _mf) = __go_tar_pax_get(hdr.pax_records, __go_tar_pax_key(GO_TAR_KEY_GNU_MAP));
        if len(mapv) == 0 {
            return (Vec::new(), false, go_errors_nil());
        };
        is_1x0 = false;
    };
    hdr.format = hdr.format & GO_TAR_FORMAT_PAX;
    let (name_v, _nf) = __go_tar_pax_get(hdr.pax_records, __go_tar_pax_key(GO_TAR_KEY_GNU_NAME));
    if len(name_v) > 0 {
        hdr.name = name_v;
    };
    let (size_v, _sf) = __go_tar_pax_get(hdr.pax_records, __go_tar_pax_key(GO_TAR_KEY_GNU_SIZE));
    let size_s = size_v;
    if len(size_s) == 0 {
        let (rs, _rf) = __go_tar_pax_get(hdr.pax_records, __go_tar_pax_key(GO_TAR_KEY_GNU_REALSIZE));
        size_s = rs;
    };
    if len(size_s) > 0 {
        let r = go_strconv_parse_int(size_s, 10, 64);
        if __go_tar_is_nil(r.err) == false {
            return (Vec::new(), false, __go_tar_err_header());
        };
        hdr.size = r.v;
    };
    if is_1x0 {
        let (spd, e) = __go_tar_read_gnu_sparse_map_1x0(tr);
        return (spd, true, e);
    };
    let (spd, e) = __go_tar_read_gnu_sparse_map_0x1(hdr.pax_records);
    return (spd, true, e);
}

// mergePAX: apply PAX records onto a header. Empty
// values keep the USTAR value. Any parse failure yields
// ErrHeader (the field is still assigned its parsed
// value, 0 on failure, as in Go).
fn __go_tar_merge_pax(hdr: &GosTarHeader, pax: Vec<GosTarPaxRecord>) -> ptr {
    let i = 0;
    while i < len(pax) {
        let k = pax[i].key;
        let v = pax[i].value;
        if len(v) == 0 {
            i = i + 1;
            continue;
        };
        let err = go_errors_nil();
        if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_PATH)) {
            hdr.name = go_bytes_clone(v);
        } else if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_LINKPATH)) {
            hdr.linkname = go_bytes_clone(v);
        } else if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_UNAME)) {
            hdr.uname = go_bytes_clone(v);
        } else if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_GNAME)) {
            hdr.gname = go_bytes_clone(v);
        } else if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_UID)) {
            let r = go_strconv_parse_int(v, 10, 64);
            hdr.uid = r.v;
            err = r.err;
        } else if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_GID)) {
            let r = go_strconv_parse_int(v, 10, 64);
            hdr.gid = r.v;
            err = r.err;
        } else if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_ATIME)) {
            let (t, e) = __go_tar_parse_pax_time(v);
            hdr.access_time = t;
            err = e;
        } else if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_MTIME)) {
            let (t, e) = __go_tar_parse_pax_time(v);
            hdr.mod_time = t;
            err = e;
        } else if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_CTIME)) {
            let (t, e) = __go_tar_parse_pax_time(v);
            hdr.change_time = t;
            err = e;
        } else if go_bytes_equal(k, __go_tar_pax_key(GO_TAR_KEY_SIZE)) {
            let r = go_strconv_parse_int(v, 10, 64);
            hdr.size = r.v;
            err = r.err;
        } else if go_bytes_has_prefix(k, __go_tar_pax_key(GO_TAR_KEY_SCHILY_XATTR)) {
            let xk = __go_tar_slice(k, len(__go_tar_pax_key(GO_TAR_KEY_SCHILY_XATTR)), len(k));
            hdr.xattrs = __go_tar_pax_set(hdr.xattrs, xk, go_bytes_clone(v));
        };
        if __go_tar_is_nil(err) == false {
            return __go_tar_err_header();
        };
        i = i + 1;
    }
    hdr.pax_records = pax;
    return go_errors_nil();
}

// readHeader: read the next 512-byte header block and
// unpack it. Returns (header, raw block, err); err is
// io.EOF only on a clean end of archive (0 bytes, 1 zero
// block + EOF, or 2 zero blocks).
fn __go_tar_read_header(tr: &GosTarReader) -> (GosTarHeader, Vec<u8>, ptr) {
    let blk = Vec::new();
    let (_m, e) = __go_tar_read_full_raw(&tr.r, &blk, GO_TAR_BLOCK_SIZE);
    if __go_tar_is_nil(e) == false {
        return (__go_tar_header_new(), Vec::new(), e);
    };
    if __go_tar_block_is_zero(blk) {
        let blk2 = Vec::new();
        let (_m2, e2) = __go_tar_read_full_raw(&tr.r, &blk2, GO_TAR_BLOCK_SIZE);
        if __go_tar_is_nil(e2) == false {
            return (__go_tar_header_new(), Vec::new(), e2);
        };
        if __go_tar_block_is_zero(blk2) {
            return (__go_tar_header_new(), Vec::new(), go_io_eof());
        };
        return (__go_tar_header_new(), Vec::new(), __go_tar_err_header());
    };
    let format = __go_tar_get_format(blk);
    if format == GO_TAR_FORMAT_UNKNOWN {
        return (__go_tar_header_new(), Vec::new(), __go_tar_err_header());
    };
    let hdr = __go_tar_header_new();
    let perr = go_errors_nil();
    hdr.typeflag = blk[156] as i64;
    hdr.name = __go_tar_parse_string(__go_tar_slice(blk, 0, 100));
    hdr.linkname = __go_tar_parse_string(__go_tar_slice(blk, 157, 257));
    let (v_size, e_size) = __go_tar_parse_numeric(__go_tar_slice(blk, 124, 136));
    hdr.size = v_size;
    if __go_tar_is_nil(perr) && __go_tar_is_nil(e_size) == false {
        perr = e_size;
    };
    let (v_mode, e_mode) = __go_tar_parse_numeric(__go_tar_slice(blk, 100, 108));
    hdr.mode = v_mode;
    if __go_tar_is_nil(perr) && __go_tar_is_nil(e_mode) == false {
        perr = e_mode;
    };
    let (v_uid, e_uid) = __go_tar_parse_numeric(__go_tar_slice(blk, 108, 116));
    hdr.uid = v_uid;
    if __go_tar_is_nil(perr) && __go_tar_is_nil(e_uid) == false {
        perr = e_uid;
    };
    let (v_gid, e_gid) = __go_tar_parse_numeric(__go_tar_slice(blk, 116, 124));
    hdr.gid = v_gid;
    if __go_tar_is_nil(perr) && __go_tar_is_nil(e_gid) == false {
        perr = e_gid;
    };
    let (v_mtime, e_mtime) = __go_tar_parse_numeric(__go_tar_slice(blk, 136, 148));
    hdr.mod_time = go_time_unix(v_mtime, 0);
    if __go_tar_is_nil(perr) && __go_tar_is_nil(e_mtime) == false {
        perr = e_mtime;
    };
    let prefix = Vec::new();
    if format > GO_TAR_FORMAT_V7 {
        hdr.uname = __go_tar_parse_string(__go_tar_slice(blk, 265, 297));
        hdr.gname = __go_tar_parse_string(__go_tar_slice(blk, 297, 329));
        let (v_dmaj, e_dmaj) = __go_tar_parse_numeric(__go_tar_slice(blk, 329, 337));
        hdr.devmajor = v_dmaj;
        if __go_tar_is_nil(perr) && __go_tar_is_nil(e_dmaj) == false {
            perr = e_dmaj;
        };
        let (v_dmin, e_dmin) = __go_tar_parse_numeric(__go_tar_slice(blk, 337, 345));
        hdr.devminor = v_dmin;
        if __go_tar_is_nil(perr) && __go_tar_is_nil(e_dmin) == false {
            perr = e_dmin;
        };
        if (format & (GO_TAR_FORMAT_USTAR | GO_TAR_FORMAT_PAX)) != 0 {
            hdr.format = format;
            prefix = __go_tar_parse_string(__go_tar_slice(blk, 345, 500));
            let non_ascii = false;
            let i = 0;
            while i < len(blk) {
                if (blk[i] as i64) >= 128 {
                    non_ascii = true;
                };
                i = i + 1;
            }
            if non_ascii {
                hdr.format = GO_TAR_FORMAT_UNKNOWN;
            };
            if blk[135] != 0u8 || blk[107] != 0u8 || blk[115] != 0u8 || blk[123] != 0u8 || blk[147] != 0u8 || blk[336] != 0u8 || blk[344] != 0u8 {
                hdr.format = GO_TAR_FORMAT_UNKNOWN;
            };
        } else if (format & GO_TAR_FORMAT_STAR) != 0 {
            prefix = __go_tar_parse_string(__go_tar_slice(blk, 345, 476));
            let (v_at, e_at) = __go_tar_parse_numeric(__go_tar_slice(blk, 476, 488));
            hdr.access_time = go_time_unix(v_at, 0);
            if __go_tar_is_nil(perr) && __go_tar_is_nil(e_at) == false {
                perr = e_at;
            };
            let (v_ct, e_ct) = __go_tar_parse_numeric(__go_tar_slice(blk, 488, 500));
            hdr.change_time = go_time_unix(v_ct, 0);
            if __go_tar_is_nil(perr) && __go_tar_is_nil(e_ct) == false {
                perr = e_ct;
            };
        } else if (format & GO_TAR_FORMAT_GNU) != 0 {
            hdr.format = format;
            let perr2 = go_errors_nil();
            if blk[345] != 0u8 {
                let (v_at, e_at) = __go_tar_parse_numeric(__go_tar_slice(blk, 345, 357));
                hdr.access_time = go_time_unix(v_at, 0);
                if __go_tar_is_nil(perr2) && __go_tar_is_nil(e_at) == false {
                    perr2 = e_at;
                };
            };
            if blk[357] != 0u8 {
                let (v_ct, e_ct) = __go_tar_parse_numeric(__go_tar_slice(blk, 357, 369));
                hdr.change_time = go_time_unix(v_ct, 0);
                if __go_tar_is_nil(perr2) && __go_tar_is_nil(e_ct) == false {
                    perr2 = e_ct;
                };
            };
            // Pre-Go1.8 fallback: unparsable atime/ctime
            // plus an ASCII prefix means the file was
            // written by the buggy writer; treat the
            // fields as a USTAR prefix instead.
            if __go_tar_is_nil(perr2) == false {
                hdr.access_time = go_time_unix(0, 0);
                hdr.change_time = go_time_unix(0, 0);
                let pfx = __go_tar_parse_string(__go_tar_slice(blk, 345, 500));
                if __go_tar_is_ascii(pfx) {
                    prefix = pfx;
                };
                hdr.format = GO_TAR_FORMAT_UNKNOWN;
            };
        };
    };
    if len(prefix) > 0 {
        let joined = go_bytes_clone(prefix);
        joined.push(47u8);
        __go_tar_append(&joined, hdr.name);
        hdr.name = joined;
    };
    return (hdr, blk, perr);
}

// handleRegularFile: set up the current file reader
// (physical bytes = nb, padding owed after it).
fn __go_tar_handle_regular_file(tr: &GosTarReader, hdr: &GosTarHeader) -> ptr {
    let nb = hdr.size;
    if __go_tar_is_header_only_type(hdr.typeflag) {
        nb = 0;
    };
    if nb < 0 {
        return __go_tar_err_header();
    };
    tr.pad = __go_tar_block_padding(nb);
    tr.nb = nb;
    tr.sparse_on = false;
    tr.sparse_holes = Vec::new();
    tr.sparse_pos = 0;
    return go_errors_nil();
}

// handleSparseFile: detect a sparse format and install
// the hole reader. The dense byte count (tr.nb) is
// untouched; the logical size comes from the sparse map.
fn __go_tar_handle_sparse_file(tr: &GosTarReader, hdr: &GosTarHeader, raw_blk: Vec<u8>) -> ptr {
    let spd = Vec::new();
    let found = false;
    let err = go_errors_nil();
    if hdr.typeflag == GO_TAR_TYPE_GNU_SPARSE {
        let (s, f, e) = __go_tar_read_old_gnu_sparse_map(tr, hdr, raw_blk);
        spd = s;
        found = f;
        err = e;
    } else {
        let (s, f, e) = __go_tar_read_gnu_sparse_pax_headers(tr, hdr);
        spd = s;
        found = f;
        err = e;
    };
    if __go_tar_is_nil(err) && found {
        if __go_tar_is_header_only_type(hdr.typeflag) || __go_tar_validate_sparse_entries(spd, hdr.size) == false {
            return __go_tar_err_header();
        };
        let holes = __go_tar_invert_sparse_entries(spd, hdr.size);
        tr.sparse_on = true;
        tr.sparse_holes = holes;
        tr.sparse_pos = 0;
    };
    return err;
}

// Internal Next loop: iterate past meta headers (PAX,
// GNU long name/link) until a normal file is found.
fn __go_tar_next(tr: &GosTarReader) -> GoTarNextResult {
    let pax = Vec::new();
    let gnu_long_name = Vec::new();
    let gnu_long_link = Vec::new();
    let format = GO_TAR_FORMAT_USTAR | GO_TAR_FORMAT_PAX | GO_TAR_FORMAT_GNU;
    while true {
        let derr = __go_tar_discard(&tr.r, tr.nb);
        if __go_tar_is_nil(derr) == false {
            return GoTarNextResult { hdr: __go_tar_header_new(), err: derr };
        };
        let pad_scratch = Vec::new();
        let (_m, perr) = __go_tar_try_read_raw(&tr.r, &pad_scratch, tr.pad);
        if __go_tar_is_nil(perr) == false {
            return GoTarNextResult { hdr: __go_tar_header_new(), err: perr };
        };
        tr.pad = 0;
        let (hdr, raw_blk, herr) = __go_tar_read_header(tr);
        if __go_tar_is_nil(herr) == false {
            return GoTarNextResult { hdr: __go_tar_header_new(), err: herr };
        };
        let hferr = __go_tar_handle_regular_file(tr, &hdr);
        if __go_tar_is_nil(hferr) == false {
            return GoTarNextResult { hdr: __go_tar_header_new(), err: hferr };
        };
        format = format & hdr.format;
        if hdr.typeflag == GO_TAR_TYPE_X_HEADER || hdr.typeflag == GO_TAR_TYPE_X_GLOBAL_HEADER {
            format = format & GO_TAR_FORMAT_PAX;
            let (p, e) = __go_tar_parse_pax(tr);
            if __go_tar_is_nil(e) == false {
                return GoTarNextResult { hdr: __go_tar_header_new(), err: e };
            };
            pax = p;
            if hdr.typeflag == GO_TAR_TYPE_X_GLOBAL_HEADER {
                let _me = __go_tar_merge_pax(&hdr, pax);
                let out = __go_tar_header_new();
                out.name = go_bytes_clone(hdr.name);
                out.typeflag = hdr.typeflag;
                out.xattrs = hdr.xattrs;
                out.pax_records = hdr.pax_records;
                out.format = format;
                return GoTarNextResult { hdr: out, err: go_errors_nil() };
            };
            continue;
        };
        if hdr.typeflag == GO_TAR_TYPE_GNU_LONG_NAME || hdr.typeflag == GO_TAR_TYPE_GNU_LONG_LINK {
            format = format & GO_TAR_FORMAT_GNU;
            let (realname, e) = __go_tar_read_special_file(tr);
            if __go_tar_is_nil(e) == false {
                return GoTarNextResult { hdr: __go_tar_header_new(), err: e };
            };
            if hdr.typeflag == GO_TAR_TYPE_GNU_LONG_NAME {
                gnu_long_name = __go_tar_parse_string(realname);
            } else {
                gnu_long_link = __go_tar_parse_string(realname);
            };
            continue;
        };
        let merr = __go_tar_merge_pax(&hdr, pax);
        if __go_tar_is_nil(merr) == false {
            return GoTarNextResult { hdr: __go_tar_header_new(), err: merr };
        };
        if len(gnu_long_name) > 0 {
            hdr.name = go_bytes_clone(gnu_long_name);
        };
        if len(gnu_long_link) > 0 {
            hdr.linkname = go_bytes_clone(gnu_long_link);
        };
        if hdr.typeflag == GO_TAR_TYPE_REG_A {
            if go_bytes_has_suffix(hdr.name, __go_tar_slash()) {
                hdr.typeflag = GO_TAR_TYPE_DIR;
            } else {
                hdr.typeflag = GO_TAR_TYPE_REG;
            };
        };
        let hferr2 = __go_tar_handle_regular_file(tr, &hdr);
        if __go_tar_is_nil(hferr2) == false {
            return GoTarNextResult { hdr: __go_tar_header_new(), err: hferr2 };
        };
        let sferr = __go_tar_handle_sparse_file(tr, &hdr, raw_blk);
        if __go_tar_is_nil(sferr) == false {
            return GoTarNextResult { hdr: __go_tar_header_new(), err: sferr };
        };
        if (format & GO_TAR_FORMAT_USTAR) != 0 && (format & GO_TAR_FORMAT_PAX) != 0 {
            format = format & GO_TAR_FORMAT_USTAR;
        };
        hdr.format = format;
        return GoTarNextResult { hdr: hdr, err: go_errors_nil() };
    }
}

// Sparse-file Read: data fragments come from the dense
// stream, hole fragments are NUL bytes.
fn __go_tar_sparse_read(tr: &GosTarReader, dst: &Vec<u8>, max: i64) -> GoIoResult {
    let remaining = __go_tar_logical_remaining(tr);
    let finished = max >= remaining;
    let m = __go_tar_min(max, remaining);
    let start = len(dst);
    let end_pos = tr.sparse_pos + m;
    let err = go_errors_nil();
    while end_pos > tr.sparse_pos && __go_tar_is_nil(err) {
        let hole = tr.sparse_holes[0];
        let hole_start = hole.offset;
        let hole_end = __go_tar_sparse_end(hole);
        let nf = 0;
        if tr.sparse_pos < hole_start {
            let frag = __go_tar_min(m - (len(dst) - start), hole_start - tr.sparse_pos);
            let (got, e) = __go_tar_try_read_reg(tr, dst, frag);
            nf = got;
            err = e;
        } else {
            let frag = __go_tar_min(m - (len(dst) - start), hole_end - tr.sparse_pos);
            let i = 0;
            while i < frag {
                dst.push(0u8);
                i = i + 1;
            }
            nf = frag;
        };
        tr.sparse_pos = tr.sparse_pos + nf;
        if tr.sparse_pos >= hole_end && len(tr.sparse_holes) > 1 {
            tr.sparse_holes = __go_tar_holes_tail(tr.sparse_holes);
        };
    }
    let n = len(dst) - start;
    if __go_tar_is_eof(err) {
        return GoIoResult { n: n, err: __go_tar_err_miss_data() };
    };
    if __go_tar_is_nil(err) == false {
        return GoIoResult { n: n, err: err };
    };
    if __go_tar_logical_remaining(tr) == 0 && tr.nb > 0 {
        return GoIoResult { n: n, err: __go_tar_err_unref_data() };
    };
    if finished {
        return GoIoResult { n: n, err: go_io_eof() };
    };
    return GoIoResult { n: n, err: go_errors_nil() };
}

// Read from the current file (sparse or regular).
fn __go_tar_read_current(tr: &GosTarReader, dst: &Vec<u8>, max: i64) -> GoIoResult {
    if tr.sparse_on {
        return __go_tar_sparse_read(tr, dst, max);
    };
    return __go_tar_reg_read_once(tr, dst, max);
}

// ---------- Public reader API ----------

// tar.NewReader(r): a Reader over r. Non-strict: insecure
// paths are returned as-is (Go's default GODEBUG).
fn go_archive_tar_new_reader(r: GosIoReader) -> GosTarReader {
    return GosTarReader {
        r: r,
        pad: 0,
        nb: 0,
        err: go_errors_nil(),
        sparse_on: false,
        sparse_holes: Vec::new(),
        sparse_pos: 0,
        strict_path: false,
    };
}

// tar.NewReader with strict path checking (Go's
// GODEBUG tarinsecurepath=0): Next returns
// ErrInsecurePath for non-local names.
fn go_archive_tar_new_reader_strict(r: GosIoReader) -> GosTarReader {
    let tr = go_archive_tar_new_reader(r);
    tr.strict_path = true;
    return tr;
}

// (*Reader).Next: advance to the next file. The error
// is sticky (kept in tr.err); an insecure-path error
// from strict mode is NOT sticky, matching Go.
fn go_archive_tar_reader_next(tr: &GosTarReader) -> GoTarNextResult {
    if __go_tar_is_nil(tr.err) == false {
        return GoTarNextResult { hdr: __go_tar_header_new(), err: tr.err };
    };
    let res = __go_tar_next(tr);
    tr.err = res.err;
    if __go_tar_is_nil(res.err) && tr.strict_path && __go_tar_is_local(res.hdr.name) == false {
        return GoTarNextResult { hdr: res.hdr, err: __go_tar_err_insecure_path() };
    };
    return res;
}

// (*Reader).Read: read up to max bytes of the current
// file into dst (appended). Non-EOF errors are sticky.
fn go_archive_tar_reader_read(tr: &GosTarReader, dst: &Vec<u8>, max: i64) -> GoIoResult {
    if __go_tar_is_nil(tr.err) == false {
        return GoIoResult { n: 0, err: tr.err };
    };
    let res = __go_tar_read_current(tr, dst, max);
    if __go_tar_is_nil(res.err) == false && __go_tar_is_eof(res.err) == false {
        tr.err = res.err;
    };
    return res;
}

// ---------- Writer internals ----------

// Round a GoTime to the nearest second (Go's
// Time.Round(time.Second): half away from zero).
fn __go_tar_time_round_sec(t: GoTime) -> GoTime {
    let ns = t.unix_ns;
    if ns >= 0 {
        let (sec, rem) = __go_tar_time_split(t);
        if rem >= 500000000 {
            return go_time_unix(sec + 1, 0);
        };
        return go_time_unix(sec, 0);
    };
    let a = 0 - ns;
    let sec_a = a / 1000000000;
    let rem_a = a % 1000000000;
    if rem_a >= 500000000 {
        return go_time_unix(0 - (sec_a + 1), 0);
    };
    return go_time_unix(0 - sec_a, 0);
}

// Template string field: plain formatString, or
// toASCII+formatString when ascii is set (PAX path).
fn __go_tar_template_str(blk: &Vec<u8>, off: i64, field_len: i64, s: Vec<u8>, ascii: bool) -> ptr {
    if ascii {
        return __go_tar_format_string(blk, off, field_len, __go_tar_to_ascii(s));
    };
    return __go_tar_format_string(blk, off, field_len, s);
}

// Template numeric field: octal (mode 0) or numeric (1).
fn __go_tar_template_num(blk: &Vec<u8>, off: i64, field_len: i64, x: i64, mode: i64) -> ptr {
    if mode == 0 {
        return __go_tar_format_octal(blk, off, field_len, x);
    };
    return __go_tar_format_numeric(blk, off, field_len, x);
}

// templateV7Plus: fill the V7 + shared USTAR/PAX/GNU
// fields of a fresh zero block. Returns (block, err);
// the error is ErrFieldTooLong if any field failed
// (all such errors share the one sentinel).
fn __go_tar_template_v7plus(hdr: GosTarHeader, str_ascii: bool, num_mode: i64) -> (Vec<u8>, ptr) {
    let blk = __go_tar_zero_block();
    let failed = false;
    let mod_time = hdr.mod_time;
    if __go_tar_time_is_zero(mod_time) {
        mod_time = go_time_unix(0, 0);
    };
    let (mod_sec, _mns) = __go_tar_time_split(mod_time);
    blk[156] = hdr.typeflag as u8;
    if __go_tar_is_nil(__go_tar_template_str(&blk, 0, 100, hdr.name, str_ascii)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_str(&blk, 157, 100, hdr.linkname, str_ascii)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_num(&blk, 100, 8, hdr.mode, num_mode)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_num(&blk, 108, 8, hdr.uid, num_mode)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_num(&blk, 116, 8, hdr.gid, num_mode)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_num(&blk, 124, 12, hdr.size, num_mode)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_num(&blk, 136, 12, mod_sec, num_mode)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_str(&blk, 265, 32, hdr.uname, str_ascii)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_str(&blk, 297, 32, hdr.gname, str_ascii)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_num(&blk, 329, 8, hdr.devmajor, num_mode)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_template_num(&blk, 337, 8, hdr.devminor, num_mode)) == false {
        failed = true;
    };
    if failed {
        return (blk, __go_tar_err_field_too_long());
    };
    return (blk, go_errors_nil());
}

// writeRawHeader: flush, write the block, set up the
// writer for a file of the given size (0 for
// header-only types). The block-write error is returned
// without setting tw.err (the caller assigns it).
fn __go_tar_write_raw_header(tw: &GosTarWriter, blk: Vec<u8>, size: i64, flag: i64) -> ptr {
    let ferr = go_archive_tar_writer_flush(tw);
    if __go_tar_is_nil(ferr) == false {
        return ferr;
    };
    let res = go_io_writer_write(&tw.w, blk);
    if __go_tar_is_nil(res.err) == false {
        return res.err;
    };
    let sz = size;
    if __go_tar_is_header_only_type(flag) {
        sz = 0;
    };
    tw.nb = sz;
    tw.pad = __go_tar_block_padding(sz);
    return go_errors_nil();
}

// writeRawFile: a minimal file with default fields
// (BSD/GNU tar style), used for PAX records and GNU
// long names/links.
fn __go_tar_write_raw_file(tw: &GosTarWriter, name: Vec<u8>, data: Vec<u8>, flag: i64, format: i64) -> ptr {
    let nm = __go_tar_to_ascii(name);
    if len(nm) > GO_TAR_NAME_SIZE {
        nm = __go_tar_slice(nm, 0, GO_TAR_NAME_SIZE);
    };
    let end = len(nm);
    while end > 0 {
        if nm[end - 1] == 47u8 {
            end = end - 1;
        } else {
            break;
        };
    }
    nm = __go_tar_slice(nm, 0, end);
    let blk = __go_tar_zero_block();
    let failed = false;
    blk[156] = flag as u8;
    if __go_tar_is_nil(__go_tar_format_string(&blk, 0, 100, nm)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_format_octal(&blk, 100, 8, 0)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_format_octal(&blk, 108, 8, 0)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_format_octal(&blk, 116, 8, 0)) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_format_octal(&blk, 124, 12, len(data))) == false {
        failed = true;
    };
    if __go_tar_is_nil(__go_tar_format_octal(&blk, 136, 12, 0)) == false {
        failed = true;
    };
    __go_tar_set_format(&blk, format);
    if failed {
        return __go_tar_err_field_too_long();
    };
    let herr = __go_tar_write_raw_header(tw, blk, len(data), flag);
    if __go_tar_is_nil(herr) == false {
        return herr;
    };
    let res = go_archive_tar_writer_write(tw, data);
    return res.err;
}

// Insertion sort of PAX records by key (Go sorts keys
// for deterministic output; the sort package is NOT
// used so tar stays independent of it).
fn __go_tar_sort_pax_keys(pax: Vec<GosTarPaxRecord>) -> Vec<GosTarPaxRecord> {
    let out = Vec::new();
    let i = 0;
    while i < len(pax) {
        let rec = pax[i];
        let j = 0;
        while j < len(out) {
            let cur_key = out[j].key;
            if go_bytes_compare(rec.key, cur_key) < 0 {
                break;
            };
            j = j + 1;
        }
        let next = Vec::new();
        let k = 0;
        while k < j {
            next.push(out[k]);
            k = k + 1;
        }
        next.push(rec);
        while k < len(out) {
            next.push(out[k]);
            k = k + 1;
        }
        out = next;
        i = i + 1;
    }
    return out;
}

fn __go_tar_long_link_name() -> Vec<u8> {
    let v = Vec::new();
    v.push(46u8);
    v.push(47u8);
    v.push(46u8);
    v.push(47u8);
    v.push(64u8);
    v.push(76u8);
    v.push(111u8);
    v.push(110u8);
    v.push(103u8);
    v.push(76u8);
    v.push(105u8);
    v.push(110u8);
    v.push(107u8);
    return v;
}

fn __go_tar_global_head_name() -> Vec<u8> {
    let v = Vec::new();
    v.push(71u8);
    v.push(108u8);
    v.push(111u8);
    v.push(98u8);
    v.push(97u8);
    v.push(108u8);
    v.push(72u8);
    v.push(101u8);
    v.push(97u8);
    v.push(100u8);
    v.push(46u8);
    v.push(48u8);
    v.push(46u8);
    v.push(48u8);
    return v;
}

fn __go_tar_pax_headers_dir() -> Vec<u8> {
    let v = Vec::new();
    v.push(80u8);
    v.push(97u8);
    v.push(120u8);
    v.push(72u8);
    v.push(101u8);
    v.push(97u8);
    v.push(100u8);
    v.push(101u8);
    v.push(114u8);
    v.push(115u8);
    v.push(46u8);
    v.push(48u8);
    return v;
}

// writeUSTARHeader: split a long name at '/' and pack
// the main header.
fn __go_tar_write_ustar_header(tw: &GosTarWriter, hdr: GosTarHeader) -> ptr {
    let name_prefix = Vec::new();
    let (pre, suf, ok) = __go_tar_split_ustar_path(hdr.name);
    if ok {
        name_prefix = pre;
        hdr.name = suf;
    };
    let (blk, e1) = __go_tar_template_v7plus(hdr, false, 0);
    let e2 = __go_tar_format_string(&blk, 345, 155, name_prefix);
    __go_tar_set_format(&blk, GO_TAR_FORMAT_USTAR);
    if __go_tar_is_nil(e1) == false {
        return e1;
    };
    if __go_tar_is_nil(e2) == false {
        return e2;
    };
    return __go_tar_write_raw_header(tw, blk, hdr.size, hdr.typeflag);
}

// writePAXHeader: emit the 'x' (or 'g') extended
// header file, then pack the main header with
// ASCII-folded strings.
fn __go_tar_write_pax_header(tw: &GosTarWriter, hdr: GosTarHeader, pax: Vec<GosTarPaxRecord>) -> ptr {
    let real_name = hdr.name;
    let is_global = hdr.typeflag == GO_TAR_TYPE_X_GLOBAL_HEADER;
    if len(pax) > 0 || is_global {
        let buf = Vec::new();
        let sorted = __go_tar_sort_pax_keys(pax);
        let i = 0;
        while i < len(sorted) {
            let (rec, e) = __go_tar_format_pax_record(sorted[i].key, sorted[i].value);
            if __go_tar_is_nil(e) == false {
                return e;
            };
            __go_tar_append(&buf, rec);
            i = i + 1;
        }
        let name = Vec::new();
        let flag = 0;
        if is_global {
            name = go_bytes_clone(real_name);
            if len(name) == 0 {
                name = __go_tar_global_head_name();
            };
            flag = GO_TAR_TYPE_X_GLOBAL_HEADER;
        } else {
            let sp = go_path_split(real_name);
            let elems = Vec::new();
            elems.push(sp.dir);
            elems.push(__go_tar_pax_headers_dir());
            elems.push(sp.file);
            name = go_path_join(elems);
            flag = GO_TAR_TYPE_X_HEADER;
        };
        if len(buf) > GO_TAR_MAX_SPECIAL_FILE_SIZE {
            return __go_tar_err_field_too_long();
        };
        let err = __go_tar_write_raw_file(tw, name, buf, flag, GO_TAR_FORMAT_PAX);
        if __go_tar_is_nil(err) == false || is_global {
            return err;
        };
    };
    let (blk, _e) = __go_tar_template_v7plus(hdr, true, 0);
    __go_tar_set_format(&blk, GO_TAR_FORMAT_PAX);
    return __go_tar_write_raw_header(tw, blk, hdr.size, hdr.typeflag);
}

// writeGNUHeader: long names/links via 'L'/'K' files,
// then pack the main header with numeric fields.
fn __go_tar_write_gnu_header(tw: &GosTarWriter, hdr: GosTarHeader) -> ptr {
    if len(hdr.name) > GO_TAR_NAME_SIZE {
        let data = go_bytes_clone(hdr.name);
        data.push(0u8);
        let err = __go_tar_write_raw_file(tw, __go_tar_long_link_name(), data, GO_TAR_TYPE_GNU_LONG_NAME, GO_TAR_FORMAT_GNU);
        if __go_tar_is_nil(err) == false {
            return err;
        };
    };
    if len(hdr.linkname) > GO_TAR_NAME_SIZE {
        let data = go_bytes_clone(hdr.linkname);
        data.push(0u8);
        let err = __go_tar_write_raw_file(tw, __go_tar_long_link_name(), data, GO_TAR_TYPE_GNU_LONG_LINK, GO_TAR_FORMAT_GNU);
        if __go_tar_is_nil(err) == false {
            return err;
        };
    };
    let (blk, _e) = __go_tar_template_v7plus(hdr, false, 1);
    if __go_tar_time_is_zero(hdr.access_time) == false {
        let (sec, _ns) = __go_tar_time_split(hdr.access_time);
        let _f1 = __go_tar_format_numeric(&blk, 345, 12, sec);
    };
    if __go_tar_time_is_zero(hdr.change_time) == false {
        let (sec, _ns) = __go_tar_time_split(hdr.change_time);
        let _f2 = __go_tar_format_numeric(&blk, 357, 12, sec);
    };
    __go_tar_set_format(&blk, GO_TAR_FORMAT_GNU);
    return __go_tar_write_raw_header(tw, blk, hdr.size, hdr.typeflag);
}

// regFileWriter.Write: at most tw.nb bytes; overlong
// writes are truncated and report ErrWriteTooLong.
fn __go_tar_reg_write(tw: &GosTarWriter, p: Vec<u8>) -> GoIoResult {
    let overwrite = len(p) > tw.nb;
    let data = p;
    if overwrite {
        data = __go_tar_slice(p, 0, tw.nb);
    };
    let n = 0;
    let err = go_errors_nil();
    if len(data) > 0 {
        let res = go_io_writer_write(&tw.w, data);
        n = res.n;
        err = res.err;
        tw.nb = tw.nb - res.n;
    };
    if __go_tar_is_nil(err) == false {
        return GoIoResult { n: n, err: err };
    };
    if overwrite {
        return GoIoResult { n: n, err: __go_tar_err_write_too_long() };
    };
    return GoIoResult { n: n, err: go_errors_nil() };
}

fn __go_tar_is_write_too_long(err: ptr) -> bool {
    return go_errors_is(err, __go_tar_err_write_too_long());
}

fn __go_tar_is_write_after_close(err: ptr) -> bool {
    return go_errors_is(err, __go_tar_err_write_after_close());
}

// ---------- Public writer API ----------

// tar.NewWriter(w).
fn go_archive_tar_new_writer(w: GosIoWriter) -> GosTarWriter {
    return GosTarWriter {
        w: w,
        pad: 0,
        nb: 0,
        err: go_errors_nil(),
        closed: false,
        hdr: __go_tar_header_new(),
    };
}

// (*Writer).Flush: finish the current file's padding.
// The missed-writing error is NOT sticky (Go returns it
// without setting tw.err).
fn go_archive_tar_writer_flush(tw: &GosTarWriter) -> ptr {
    if __go_tar_is_nil(tw.err) == false {
        return tw.err;
    };
    if tw.nb > 0 {
        return __go_tar_err_missed_writing(tw.nb);
    };
    if tw.pad > 0 {
        let zeros = __go_tar_slice(__go_tar_zero_block(), 0, tw.pad);
        let res = go_io_writer_write(&tw.w, zeros);
        if __go_tar_is_nil(res.err) == false {
            tw.err = res.err;
            return tw.err;
        };
    };
    tw.pad = 0;
    return go_errors_nil();
}

// (*Writer).WriteHeader: flush, promote TypeRegA,
// round ModTime and drop atime/ctime when the format
// is not explicitly chosen, then dispatch on the
// allowed formats (USTAR, then PAX, then GNU). The
// no-format error is non-fatal (tw.err stays nil).
fn go_archive_tar_writer_write_header(tw: &GosTarWriter, hdr: GosTarHeader) -> ptr {
    let ferr = go_archive_tar_writer_flush(tw);
    if __go_tar_is_nil(ferr) == false {
        return ferr;
    };
    tw.hdr = hdr;
    if tw.hdr.typeflag == GO_TAR_TYPE_REG_A {
        if go_bytes_has_suffix(tw.hdr.name, __go_tar_slash()) {
            tw.hdr.typeflag = GO_TAR_TYPE_DIR;
        } else {
            tw.hdr.typeflag = GO_TAR_TYPE_REG;
        };
    };
    if tw.hdr.format == GO_TAR_FORMAT_UNKNOWN {
        tw.hdr.mod_time = __go_tar_time_round_sec(tw.hdr.mod_time);
        tw.hdr.access_time = go_time_unix(0, 0);
        tw.hdr.change_time = go_time_unix(0, 0);
    };
    let (allowed, pax, aerr) = __go_tar_allowed_formats(&tw.hdr);
    let h = tw.hdr;
    if (allowed & GO_TAR_FORMAT_USTAR) != 0 {
        tw.err = __go_tar_write_ustar_header(tw, h);
        return tw.err;
    };
    if (allowed & GO_TAR_FORMAT_PAX) != 0 {
        tw.err = __go_tar_write_pax_header(tw, h, pax);
        return tw.err;
    };
    if (allowed & GO_TAR_FORMAT_GNU) != 0 {
        tw.err = __go_tar_write_gnu_header(tw, h);
        return tw.err;
    };
    return aerr;
}

// (*Writer).Write: write file data. ErrWriteTooLong is
// NOT sticky; any other error is.
fn go_archive_tar_writer_write(tw: &GosTarWriter, p: Vec<u8>) -> GoIoResult {
    if __go_tar_is_nil(tw.err) == false {
        return GoIoResult { n: 0, err: tw.err };
    };
    let res = __go_tar_reg_write(tw, p);
    if __go_tar_is_nil(res.err) == false && __go_tar_is_write_too_long(res.err) == false {
        tw.err = res.err;
    };
    return res;
}

// (*Writer).Close: flush, write the two zero blocks,
// then mark the writer closed (later calls fail with
// ErrWriteAfterClose; Close itself stays nil).
fn go_archive_tar_writer_close(tw: &GosTarWriter) -> ptr {
    if __go_tar_is_write_after_close(tw.err) {
        return go_errors_nil();
    };
    if __go_tar_is_nil(tw.err) == false {
        return tw.err;
    };
    let err = go_archive_tar_writer_flush(tw);
    let i = 0;
    while i < 2 && __go_tar_is_nil(err) {
        let zeros = __go_tar_zero_block();
        let res = go_io_writer_write(&tw.w, zeros);
        err = res.err;
        i = i + 1;
    }
    tw.err = __go_tar_err_write_after_close();
    tw.closed = true;
    return err;
}

// ---------- Corpus example ----------
// go_archive_tar_demo_header_roundtrip builds a USTAR
// header block from a header and verifies it parses
// back: format detection, checksum, and the name field.
// No io handle is needed; a full writer->reader
// roundtrip needs an in-memory sink with a read-back
// accessor, which io.sla does not expose yet (see the
// file header). Returns true when every check holds.
fn go_archive_tar_demo_header_roundtrip() -> bool {
    let hdr = __go_tar_header_new();
    hdr.typeflag = GO_TAR_TYPE_REG;
    let name = Vec::new();
    name.push(104u8);
    name.push(101u8);
    name.push(108u8);
    name.push(108u8);
    name.push(111u8);
    name.push(46u8);
    name.push(116u8);
    name.push(120u8);
    name.push(116u8);
    hdr.name = name;
    hdr.size = 5;
    hdr.mode = 420;
    hdr.mod_time = go_time_unix(1700000000, 0);
    let (blk, e) = __go_tar_template_v7plus(hdr, false, 0);
    if __go_tar_is_nil(e) == false {
        return false;
    };
    __go_tar_set_format(&blk, GO_TAR_FORMAT_USTAR);
    if __go_tar_get_format(blk) != (GO_TAR_FORMAT_USTAR | GO_TAR_FORMAT_PAX) {
        return false;
    };
    let (chk, _s) = __go_tar_compute_checksum(&blk);
    let (stored, e2) = __go_tar_parse_octal(__go_tar_slice(blk, 148, 156));
    if __go_tar_is_nil(e2) == false {
        return false;
    };
    if chk != stored {
        return false;
    };
    let back = __go_tar_parse_string(__go_tar_slice(blk, 0, 100));
    let want = Vec::new();
    want.push(104u8);
    want.push(101u8);
    want.push(108u8);
    want.push(108u8);
    want.push(111u8);
    want.push(46u8);
    want.push(116u8);
    want.push(120u8);
    want.push(116u8);
    if go_bytes_equal(back, want) == false {
        return false;
    };
    let (sz, e3) = __go_tar_parse_numeric(__go_tar_slice(blk, 124, 136));
    if __go_tar_is_nil(e3) == false {
        return false;
    };
    if sz != 5 {
        return false;
    };
    return true;
}
