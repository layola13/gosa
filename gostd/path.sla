// gostd path: the SLA-side model of Go's path
// package (slash-separated paths, not the OS
// filepath package). Clean and Match are ports
// of Go's path/path.go and path/match.go.
//
// ErrBadPattern sentinel (target id; errors.sla
// reserves the 900000-999999 range):
//   900022 "syntax error in pattern"
//
// NOTE on conditions: SLA's && and || evaluate
// eagerly, so a guarded read (an index that is
// only valid when an earlier test holds) must be
// written as nested ifs, never as a && chain.
// This file does that throughout.
//
// VALUE REPRESENTATION (gostd contract):
//   Go string -> Vec<u8>
//   Go error  -> GosError heap ptr

struct GoPathSplit {
    dir: Vec<u8>,
    file: Vec<u8>,
}

struct GoPathMatch {
    matched: bool,
    err: ptr,
}

struct GoPathChunk {
    star: bool,
    lo: i64,
    hi: i64,
    rest: i64,
}

struct GoPathChunkMatch {
    rest: i64,
    ok: bool,
    err: ptr,
}

struct GoPathEsc {
    r: i64,
    next: i64,
    err: ptr,
}

// ---------- ErrBadPattern ----------

fn go_path_err_bad_pattern() -> ptr {
    let m = Vec::new();
    m.push(115u8); m.push(121u8); m.push(110u8); m.push(116u8); m.push(97u8); m.push(120u8); m.push(32u8); m.push(101u8); m.push(114u8); m.push(114u8);
    m.push(111u8); m.push(114u8); m.push(32u8); m.push(105u8); m.push(110u8); m.push(32u8); m.push(112u8); m.push(97u8); m.push(116u8); m.push(116u8);
    m.push(101u8); m.push(114u8); m.push(110u8);
    return go_errors_new_with_id(m, 900022);
}

fn __go_path_slice(b: Vec<u8>, lo: i64, hi: i64) -> Vec<u8> {
    let out = Vec::new();
    let i = lo;
    while i < hi {
        out.push(b[i]);
        i = i + 1;
    }
    return out;
}

fn __go_path_index_byte(b: Vec<u8>, from: i64, c: u8) -> i64 {
    let i = from;
    while i < len(b) {
        if b[i] == c { return i; };
        i = i + 1;
    }
    return 0 - 1;
}

// ---------- Clean ----------

// path.Clean, Go's algorithm exactly (lazybuf
// replaced by a Vec built from scratch; same
// observable results).
fn go_path_clean(path: Vec<u8>) -> Vec<u8> {
    if len(path) == 0 {
        let d = Vec::new();
        d.push(46u8);
        return d;
    };
    let rooted = path[0] == 47u8;
    let out = Vec::new();
    let r = 0;
    let dotdot = 0;
    if rooted {
        out.push(47u8);
        r = 1;
        dotdot = 1;
    };
    while r < len(path) {
        // Classify the element at r (nested ifs:
        // every index is guarded by a length test).
        let is_slash = path[r] == 47u8;
        let is_dot = false;
        let is_dotdot = false;
        if path[r] == 46u8 {
            if r + 1 == len(path) { is_dot = true; };
            if r + 1 < len(path) {
                if path[r + 1] == 47u8 { is_dot = true; };
            };
            if r + 1 < len(path) {
                if path[r + 1] == 46u8 {
                    if r + 2 == len(path) { is_dotdot = true; };
                    if r + 2 < len(path) {
                        if path[r + 2] == 47u8 { is_dotdot = true; };
                    };
                };
            };
        };
        if is_slash {
            r = r + 1;
            continue;
        };
        if is_dot {
            r = r + 1;
            continue;
        };
        if is_dotdot {
            r = r + 2;
            if len(out) > dotdot {
                // Backtrack: remove the last element
                // (and its leading slash).
                let ww = len(out) - 1;
                while ww > dotdot {
                    if out[ww] == 47u8 { break; };
                    ww = ww - 1;
                }
                out = __go_path_slice(out, 0, ww);
            } else {
                if !rooted {
                    if len(out) > 0 { out.push(47u8); };
                    out.push(46u8);
                    out.push(46u8);
                    dotdot = len(out);
                };
            };
            continue;
        };
        // Real path element: add a slash if needed,
        // then copy the element.
        if rooted {
            if len(out) != 1 { out.push(47u8); };
        } else {
            if len(out) != 0 { out.push(47u8); };
        };
        while r < len(path) {
            if path[r] == 47u8 { break; };
            out.push(path[r]);
            r = r + 1;
        }
    }
    if len(out) == 0 {
        let d = Vec::new();
        d.push(46u8);
        return d;
    };
    return out;
}

// ---------- Base / Dir / Ext / Split / Join / IsAbs ----------

// path.Base
fn go_path_base(path: Vec<u8>) -> Vec<u8> {
    if len(path) == 0 {
        let d = Vec::new();
        d.push(46u8);
        return d;
    };
    // Strip trailing slashes.
    let p = path;
    while len(p) > 0 {
        if p[len(p) - 1] != 47u8 { break; };
        p = __go_path_slice(p, 0, len(p) - 1);
    }
    // LastIndexByte: rescan from the end.
    let last = 0 - 1;
    let j = len(p) - 1;
    while j >= 0 {
        if p[j] == 47u8 { last = j; break; };
        j = j - 1;
    }
    if last >= 0 {
        p = __go_path_slice(p, last + 1, len(p));
    };
    if len(p) == 0 {
        let s = Vec::new();
        s.push(47u8);
        return s;
    };
    return p;
}

// path.Dir
fn go_path_dir(path: Vec<u8>) -> Vec<u8> {
    let sp = go_path_split(path);
    return go_path_clean(sp.dir);
}

// path.Ext
fn go_path_ext(path: Vec<u8>) -> Vec<u8> {
    let i = len(path) - 1;
    while i >= 0 {
        if path[i] == 47u8 { break; };
        if path[i] == 46u8 {
            return __go_path_slice(path, i, len(path));
        };
        i = i - 1;
    }
    return Vec::new();
}

// path.IsAbs
fn go_path_is_abs(path: Vec<u8>) -> bool {
    if len(path) == 0 { return false; };
    return path[0] == 47u8;
}

// path.Join(elems...)
fn go_path_join(elems: Vec<Vec<u8>>) -> Vec<u8> {
    let size = 0;
    let i = 0;
    while i < len(elems) {
        size = size + len(elems[i]);
        i = i + 1;
    }
    if size == 0 {
        return Vec::new();
    };
    let buf = Vec::new();
    let j = 0;
    while j < len(elems) {
        let e = elems[j];
        if len(buf) > 0 || len(e) != 0 {
            if len(buf) > 0 { buf.push(47u8); };
            let k = 0;
            while k < len(e) {
                buf.push(e[k]);
                k = k + 1;
            }
        };
        j = j + 1;
    }
    return go_path_clean(buf);
}

// path.Split
fn go_path_split(path: Vec<u8>) -> GoPathSplit {
    let i = 0 - 1;
    let j = len(path) - 1;
    while j >= 0 {
        if path[j] == 47u8 { i = j; break; };
        j = j - 1;
    }
    return GoPathSplit { dir: __go_path_slice(path, 0, i + 1), file: __go_path_slice(path, i + 1, len(path)) };
}

// ---------- Match ----------

// scanChunk: strips leading '*'s (star=true),
// then scans to the next '*' outside a character
// class. Returns the chunk range and the rest.
fn __go_path_scan_chunk(pattern: Vec<u8>, start: i64) -> GoPathChunk {
    let p = start;
    let star = false;
    while p < len(pattern) {
        if pattern[p] != 42u8 { break; };
        p = p + 1;
        star = true;
    }
    let inrange = false;
    let i = p;
    while i < len(pattern) {
        let c = pattern[i];
        if c == 92u8 {
            if i + 1 < len(pattern) { i = i + 1; };
        } else {
            if c == 91u8 {
                inrange = true;
            } else {
                if c == 93u8 {
                    inrange = false;
                } else {
                    if c == 42u8 {
                        if !inrange {
                            return GoPathChunk { star: star, lo: p, hi: i, rest: i };
                        };
                    };
                };
            };
        };
        i = i + 1;
    }
    return GoPathChunk { star: star, lo: p, hi: len(pattern), rest: len(pattern) };
}

// getEsc: reads one rune (or escape) from a
// character class at pos; errors on a bad pattern.
fn __go_path_get_esc(chunk: Vec<u8>, pos: i64, end: i64) -> GoPathEsc {
    if pos >= end {
        return GoPathEsc { r: 0, next: pos, err: go_path_err_bad_pattern() };
    };
    let c = chunk[pos];
    if c == 45u8 {
        return GoPathEsc { r: 0, next: pos, err: go_path_err_bad_pattern() };
    };
    if c == 93u8 {
        return GoPathEsc { r: 0, next: pos, err: go_path_err_bad_pattern() };
    };
    let p = pos;
    if c == 92u8 {
        p = p + 1;
        if p >= end {
            return GoPathEsc { r: 0, next: p, err: go_path_err_bad_pattern() };
        };
    };
    let d = __go_utf8_decode(chunk, p);
    // A RuneError of width 1 in the pattern is a
    // bad pattern (invalid UTF-8 in the class).
    if !d.ok {
        return GoPathEsc { r: 0, next: p, err: go_path_err_bad_pattern() };
    };
    let nchunk = p + d.size;
    if nchunk >= end {
        return GoPathEsc { r: d.r, next: nchunk, err: go_path_err_bad_pattern() };
    };
    return GoPathEsc { r: d.r, next: nchunk, err: go_errors_nil() };
}

// matchChunk: matches chunk[lo:hi] against s
// starting at spos. Returns the rest position in
// s, whether it matched, and a bad-pattern error.
// On failure it keeps consuming the chunk (so a
// bad pattern is still reported) but stops
// reading s -- Go's matchChunk exactly.
fn __go_path_match_chunk(pattern: Vec<u8>, lo: i64, hi: i64, s: Vec<u8>, spos: i64) -> GoPathChunkMatch {
    let failed = false;
    let cpos = lo;
    let sp = spos;
    while cpos < hi {
        if sp >= len(s) { failed = true; };
        let c = pattern[cpos];
        if c == 91u8 {
            // Character class.
            let r = 0;
            if !failed {
                let d = __go_utf8_decode(s, sp);
                r = d.r;
                sp = sp + d.size;
            };
            cpos = cpos + 1;
            let negated = false;
            if cpos < hi {
                if pattern[cpos] == 94u8 {
                    negated = true;
                    cpos = cpos + 1;
                };
            };
            let in_class = false;
            let nrange = 0;
            while true {
                if cpos < hi {
                    if pattern[cpos] == 93u8 {
                        if nrange > 0 {
                            cpos = cpos + 1;
                            break;
                        };
                    };
                };
                let esc = __go_path_get_esc(pattern, cpos, hi);
                if esc.err != go_errors_nil() {
                    return GoPathChunkMatch { rest: 0, ok: false, err: esc.err };
                };
                let lo_r = esc.r;
                cpos = esc.next;
                let hi_r = lo_r;
                if cpos < hi {
                    if pattern[cpos] == 45u8 {
                        let esc2 = __go_path_get_esc(pattern, cpos + 1, hi);
                        if esc2.err != go_errors_nil() {
                            return GoPathChunkMatch { rest: 0, ok: false, err: esc2.err };
                        };
                        hi_r = esc2.r;
                        cpos = esc2.next;
                    };
                };
                if lo_r <= r {
                    if r <= hi_r { in_class = true; };
                };
                nrange = nrange + 1;
            }
            if in_class == negated { failed = true; };
        } else {
            if c == 63u8 {
                // '?': one rune, never '/'.
                if !failed {
                    if s[sp] == 47u8 { failed = true; };
                    let d = __go_utf8_decode(s, sp);
                    sp = sp + d.size;
                };
                cpos = cpos + 1;
            } else {
                if c == 92u8 {
                    cpos = cpos + 1;
                    if cpos >= hi {
                        return GoPathChunkMatch { rest: 0, ok: false, err: go_path_err_bad_pattern() };
                    };
                    // Fall through to the default
                    // case with the escaped byte.
                    if !failed {
                        if pattern[cpos] != s[sp] { failed = true; };
                        sp = sp + 1;
                    };
                    cpos = cpos + 1;
                } else {
                    // Literal byte.
                    if !failed {
                        if pattern[cpos] != s[sp] { failed = true; };
                        sp = sp + 1;
                    };
                    cpos = cpos + 1;
                };
            };
        };
    }
    if failed {
        return GoPathChunkMatch { rest: 0, ok: false, err: go_errors_nil() };
    };
    return GoPathChunkMatch { rest: sp, ok: true, err: go_errors_nil() };
}

// path.Match(pattern, name)
fn go_path_match(pattern: Vec<u8>, name: Vec<u8>) -> GoPathMatch {
    let p = 0;
    let n = 0;
    while p < len(pattern) {
        let sc = __go_path_scan_chunk(pattern, p);
        let star = sc.star;
        let lo = sc.lo;
        let hi = sc.hi;
        p = sc.rest;
        if star {
            if lo == hi {
                // Trailing * matches the rest of
                // the string unless it has a '/'.
                let idx = __go_path_index_byte(name, n, 47u8);
                return GoPathMatch { matched: idx < 0, err: go_errors_nil() };
            };
        };
        let mc = __go_path_match_chunk(pattern, lo, hi, name, n);
        if mc.ok {
            if mc.rest == len(name) || p < len(pattern) {
                n = mc.rest;
                continue;
            };
        };
        if mc.err != go_errors_nil() {
            return GoPathMatch { matched: false, err: mc.err };
        };
        if star {
            // Look for a match skipping i+1 bytes.
            // Cannot skip '/'.
            let i = n;
            let matched_outer = false;
            while i < len(name) {
                if name[i] == 47u8 { break; };
                let mc2 = __go_path_match_chunk(pattern, lo, hi, name, i + 1);
                if mc2.ok {
                    if p == len(pattern) {
                        if mc2.rest < len(name) {
                            i = i + 1;
                            continue;
                        };
                    };
                    n = mc2.rest;
                    matched_outer = true;
                    break;
                };
                if mc2.err != go_errors_nil() {
                    return GoPathMatch { matched: false, err: mc2.err };
                };
                i = i + 1;
            }
            if matched_outer { continue; };
        };
        // Before returning false, check that the
        // remainder of the pattern is well-formed.
        let rp = p;
        while rp < len(pattern) {
            let sc2 = __go_path_scan_chunk(pattern, rp);
            let mc3 = __go_path_match_chunk(pattern, sc2.lo, sc2.hi, Vec::new(), 0);
            if mc3.err != go_errors_nil() {
                return GoPathMatch { matched: false, err: mc3.err };
            };
            rp = sc2.rest;
        }
        return GoPathMatch { matched: false, err: go_errors_nil() };
    }
    return GoPathMatch { matched: n == len(name), err: go_errors_nil() };
}
