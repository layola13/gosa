// gostd errors: the SLA-side model of Go's errors package
// plus the GosError value shape every other gostd module
// (and gosla-emitted code) builds on. Organisation follows
// the psa_std precedent: one .sla file per Go package,
// public entry points named go_<pkg>_<name>, private
// helpers __go_<pkg>_<name>, panic codes listed up front.
//
// Panic codes (gostd block 77400-77499):
//   77401  a nil GosError handle was dereferenced
//          (Go would nil-pointer panic the same way)
//
// GosError is a heap object. A Go `error` value is a
// reference, so gostd passes GosError by ptr throughout:
// constructors box a GosError and return the raw pointer,
// and go_errors_is compares pointers for identity exactly
// like Go compares error values. gostd never frees an
// error; ownership belongs to the allocating program.
//
// Fields:
//   msg        this node's own message bytes. For a wrap
//              node this is the COMPLETE display string:
//              fmt's wrapError.Error() returns the
//              formatted message verbatim, because the
//              %w verb already rendered the cause's text
//              into it at the verb's position.
//   wrap       true when this node wraps `cause` in the
//              fmt.Errorf %w sense, i.e. Unwrap() returns
//              the cause.
//   cause      the wrapped error, or null.
//   kids       extra causes from errors.Join / a fmt
//              call with several %w verbs. Unwrap() in
//              Go returns []error for those; Is/As walk
//              the kids depth-first after the main chain.
//   msg_wins   join nodes only: when true, Error() is
//              msg verbatim (the fmt multi-%w shape);
//              when false, Error() joins the kids'
//              strings with "\n" (errors.Join shape).
//   target_id  a stable identity number for Is/As
//              matching, assigned by the frontend: one id
//              per sentinel error variable and per error
//              type. 0 means "no identity beyond the
//              pointer itself". gostd reserves
//              900001 (strconv ErrSyntax) and 900002
//              (strconv ErrRange); the frontend must not
//              reuse the 900000-999999 range.

struct GosError {
    msg: Vec<u8>,
    wrap: bool,
    cause: ptr,
    kids: Vec<ptr>,
    msg_wins: bool,
    target_id: i64,
}

fn go_errors_nil() -> ptr {
    return 0 as ptr;
}

fn __go_err_alloc(e: GosError) -> ptr {
    let b = Box::new(e);
    return Box::into_raw(b);
}

fn __go_err_check(e: ptr) -> void {
    if e == go_errors_nil() { panic(77401); };
    return;
}

// errors.New(text string) error
fn go_errors_new(msg: Vec<u8>) -> ptr {
    return __go_err_alloc(GosError {
        msg: msg,
        wrap: false,
        cause: go_errors_nil(),
        kids: Vec::new(),
        msg_wins: false,
        target_id: 0,
    });
}

// New with a frontend-assigned identity (sentinel errors
// and typed errors). Is/As match on this id when nonzero.
fn go_errors_new_with_id(msg: Vec<u8>, target_id: i64) -> ptr {
    return __go_err_alloc(GosError {
        msg: msg,
        wrap: false,
        cause: go_errors_nil(),
        kids: Vec::new(),
        msg_wins: false,
        target_id: target_id,
    });
}

// The %w record: a wrap node whose own message is the
// fully formatted fmt string and whose cause is the
// error the %w verb consumed. go_fmt_errorf builds these.
fn go_errors_new_wrap(msg: Vec<u8>, cause: ptr) -> ptr {
    return __go_err_alloc(GosError {
        msg: msg,
        wrap: true,
        cause: cause,
        kids: Vec::new(),
        msg_wins: false,
        target_id: 0,
    });
}

// A join node (errors.Join). Its own msg is unused;
// Error() joins the kids' strings with "\n" (Go's
// joinError behaviour).
fn go_errors_new_join(kids: Vec<ptr>) -> ptr {
    return __go_err_alloc(GosError {
        msg: Vec::new(),
        wrap: false,
        cause: go_errors_nil(),
        kids: kids,
        msg_wins: false,
        target_id: 0,
    });
}

// The multi-%w fmt shape: one Errorf that consumed
// several %w verbs. Error() is the formatted message
// verbatim; the wrapped errors ride in kids, where
// Is/As find them (Go exposes them via Unwrap()
// []error).
fn go_errors_new_multi(msg: Vec<u8>, kids: Vec<ptr>) -> ptr {
    return __go_err_alloc(GosError {
        msg: msg,
        wrap: false,
        cause: go_errors_nil(),
        kids: kids,
        msg_wins: true,
        target_id: 0,
    });
}

// Stamp an identity onto an error after construction
// (the frontend does this for sentinels it allocated
// through other paths).
fn go_errors_set_target(e: ptr, target_id: i64) -> void {
    __go_err_check(e);
    (*e).target_id = target_id;
    return;
}

fn go_errors_target_id(e: ptr) -> i64 {
    __go_err_check(e);
    return (*e).target_id;
}

// error.Error() string: a wrap node's string is its
// msg verbatim (see the field notes above). A join
// node joins the kids' strings by "\n", unless
// msg_wins marks the fmt multi-%w shape, whose string
// is again the msg verbatim. A nil error has no
// Error() in Go (calling it panics); gostd panics
// 77401 through __go_err_check.
fn go_errors_error_string(e: ptr) -> Vec<u8> {
    __go_err_check(e);
    let out = Vec::new();
    if len((*e).kids) > 0 {
        if (*e).msg_wins {
            __go_err_append(out, (*e).msg);
            return out;
        };
        let i = 0;
        while i < len((*e).kids) {
            if i > 0 { out.push(10u8); };
            __go_err_append(out, go_errors_error_string((*e).kids[i]));
            i = i + 1;
        }
        return out;
    };
    __go_err_append(out, (*e).msg);
    return out;
}

fn __go_err_append(dst: Vec<u8>, src: Vec<u8>) -> void {
    let i = 0;
    while i < len(src) {
        dst.push(src[i]);
        i = i + 1;
    }
    return;
}

// errors.Unwrap(err) error: the main-chain cause only.
// Join nodes unwrap to a slice in Go; gostd exposes the
// kids through go_errors_join_kids instead.
fn go_errors_unwrap(e: ptr) -> ptr {
    if e == go_errors_nil() { return go_errors_nil(); };
    if (*e).wrap { return (*e).cause; };
    return go_errors_nil();
}

fn go_errors_join_kids(e: ptr) -> Vec<ptr> {
    if e == go_errors_nil() { return Vec::new(); };
    return (*e).kids;
}

// Does node `e` match `target`? Go: e == target, or
// e.Is(target) returns true. gostd models the custom-Is
// hook as identity: pointer equality, or equal nonzero
// target_id on both sides.
fn __go_err_matches(e: ptr, target: ptr) -> bool {
    if e == target { return true; };
    if e == go_errors_nil() { return false; };
    if target == go_errors_nil() { return false; };
    let tid = (*target).target_id;
    if tid != 0 {
        if (*e).target_id == tid { return true; };
    };
    return false;
}

// errors.Is(err, target) bool: walk the wrap chain,
// then the join kids depth-first (Go's traversal order
// is chain-first at each node, then children).
fn go_errors_is(e: ptr, target: ptr) -> bool {
    if e == go_errors_nil() { return target == go_errors_nil(); };
    if __go_err_matches(e, target) { return true; };
    let c = go_errors_unwrap(e);
    if c != go_errors_nil() {
        if go_errors_is(c, target) { return true; };
    };
    let i = 0;
    while i < len((*e).kids) {
        if go_errors_is((*e).kids[i], target) { return true; };
        i = i + 1;
    }
    return false;
}

// errors.As shape: gostd cannot hand back a typed
// target, so As is exposed as a search by identity --
// go_errors_as returns the first node in the chain
// (then kids, depth-first) whose target_id equals
// `target_id`, or nil. The frontend emits the field
// extraction for the concrete error type it asked for.
fn go_errors_as(e: ptr, target_id: i64) -> ptr {
    if e == go_errors_nil() { return go_errors_nil(); };
    if target_id != 0 {
        if (*e).target_id == target_id { return e; };
    };
    let c = go_errors_unwrap(e);
    if c != go_errors_nil() {
        let hit = go_errors_as(c, target_id);
        if hit != go_errors_nil() { return hit; };
    };
    let i = 0;
    while i < len((*e).kids) {
        let hit = go_errors_as((*e).kids[i], target_id);
        if hit != go_errors_nil() { return hit; };
        i = i + 1;
    }
    return go_errors_nil();
}

// errors.Join(errs ...error) error: nil errors are
// dropped; zero non-nil errors yield nil; one yields
// that error itself (Go returns a joinError holding
// exactly the non-nil list, and a single-element join
// still behaves as a join node -- gostd keeps the node
// so Unwrap/Is traversal is uniform).
fn go_errors_join(errs: Vec<ptr>) -> ptr {
    let kids = Vec::new();
    let i = 0;
    while i < len(errs) {
        if errs[i] != go_errors_nil() { kids.push(errs[i]); };
        i = i + 1;
    }
    if len(kids) == 0 { return go_errors_nil(); };
    return go_errors_new_join(kids);
}
